@model MVC.ProductManagement.Presentation.Models.AccountVMs.LoginVM

@{
    ViewData["Title"] = "Cryocan Giriş";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <title>@ViewData["Title"]</title>
    <meta content="Cryocan kullanıcı giriş ekranı" name="description">

    <link href="~/assets/img/favicon.png" rel="icon">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            min-height: 100vh;
            margin: 0;
            font-family: 'Inter', sans-serif;
            background: linear-gradient(140deg, #03162b 0%, #0b4f8a 52%, #1b7fcb 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .login-wrapper {
            width: 100%;
            max-width: 980px;
            border-radius: 22px;
            overflow: hidden;
            display: grid;
            grid-template-columns: 1.05fr 1fr;
            box-shadow: 0 18px 44px rgba(2, 14, 28, 0.4);
            border: 1px solid rgba(255, 255, 255, .2);
            background-color: #fff;
        }

        .login-brand {
            background: linear-gradient(165deg, #022445 0%, #0b4f8a 55%, #1693dc 100%);
            color: #fff;
            padding: 2rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .login-brand img {
            width: min(260px, 100%);
            height: auto;
            margin-bottom: 1.3rem;
            filter: drop-shadow(0 10px 24px rgba(0, 0, 0, 0.2));
        }

        .login-brand h1 {
            font-size: 1.35rem;
            font-weight: 800;
            margin-bottom: .9rem;
            line-height: 1.35;
        }

        .login-brand p {
            color: rgba(255,255,255,.9);
            margin-bottom: 0;
            line-height: 1.7;
            font-size: .93rem;
        }

        .login-card {
            padding: 2rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .page-link-back {
            color: #0b4f8a;
            text-decoration: none;
            font-size: .9rem;
            font-weight: 600;
            margin-bottom: 1.2rem;
            display: inline-flex;
            align-items: center;
            gap: .4rem;
        }

        .page-link-back:hover { color: #083c70; }

        .login-title {
            font-size: 1.45rem;
            font-weight: 800;
            color: #0d2b47;
            margin-bottom: .35rem;
        }

        .login-subtitle {
            color: #5f7388;
            margin-bottom: 1.35rem;
            font-size: .93rem;
        }

        .form-label {
            font-weight: 600;
            color: #0d2b47;
            font-size: .9rem;
        }

        .form-control {
            min-height: 44px;
            border-radius: 10px;
            border: 1px solid #cfe0f0;
        }

        .form-control:focus {
            border-color: #1982d1;
            box-shadow: 0 0 0 .17rem rgba(25,130,209,.17);
        }

        .btn-login {
            margin-top: .25rem;
            background: linear-gradient(90deg, #0b4f8a 0%, #0f74bf 100%);
            border: none;
            min-height: 45px;
            border-radius: 10px;
            font-weight: 700;
            letter-spacing: .2px;
        }

        .btn-login:hover,
        .btn-login:focus {
            background: linear-gradient(90deg, #083d6a 0%, #0b5f9f 100%);
        }

        @@media (max-width: 900px) {
            .login-wrapper {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <main class="login-wrapper">
        <section class="login-brand">
            <img src="~/assets/img/Cryocan logo.JPG" alt="Cryocan Logo">
            <h1>Kriyojenik sistem yönetimi için güvenli kullanıcı girişi</h1>
            <p>
                Cryocan iç süreçlerine erişim için kullanıcı bilgilerinizi girin.
                Rolünüze göre yönetim, satış ve teknik modüllere yönlendirileceksiniz.
            </p>
        </section>

        <section class="login-card">
            <a asp-controller="Home" asp-action="Index" class="page-link-back">
                <i class="bi bi-arrow-left"></i> Bilgi sayfasına dön
            </a>

            <h2 class="login-title">Hesabınıza Giriş Yapın</h2>
            <p class="login-subtitle">Devam etmek için e-posta ve şifrenizi giriniz.</p>

            <form asp-action="Login" method="post" class="row g-3" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="col-12">
                    <label asp-for="Email" class="form-label">E-posta</label>
                    <input asp-for="Email" type="email" class="form-control" autocomplete="username" required>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Password" class="form-label">Şifre</label>
                    <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" required>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <button class="btn btn-primary btn-login w-100" type="submit">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Giriş Yap
                    </button>
                </div>
            </form>
        </section>
    </main>

    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
