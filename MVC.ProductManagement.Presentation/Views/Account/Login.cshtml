@model MVC.ProductManagement.Presentation.Models.AccountVMs.LoginVM

@{
    ViewData["Title"] = "Yönetici Girişi";
    Layout = null;
    string atSign = "@";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <title>@ViewData["Title"] - Cryocan</title>
    <meta content="Cryocan yönetici giriş ekranı" name="description">

    <link href="~/assets/img/favicon.png" rel="icon">
    <link href="~/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <link href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700|Poppins:400,500,600,700" rel="stylesheet">

    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/assets/css/style.css" rel="stylesheet">

    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 45%, #2563eb 100%);
            font-family: "Open Sans", sans-serif;
        }

        .login-shell {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }

        .brand-block {
            color: #fff;
            text-align: center;
            margin-bottom: 1.25rem;
        }

        .brand-block img {
            width: min(100%, 340px);
            height: auto;
            filter: drop-shadow(0 10px 24px rgba(0, 0, 0, 0.25));
            margin-bottom: .65rem;
        }

        .brand-block h1 {
            margin: 0;
            font-size: 1.45rem;
            font-weight: 700;
            letter-spacing: .2px;
        }

        .brand-block p {
            margin: .35rem 0 0;
            font-size: .94rem;
            opacity: .88;
        }

        .login-card {
            width: 100%;
            max-width: 430px;
            border: 0;
            border-radius: 18px;
            box-shadow: 0 18px 45px rgba(2, 8, 23, 0.35);
            overflow: hidden;
        }

        .login-card .card-body {
            padding: 2rem;
        }

        .login-title {
            font-family: "Poppins", sans-serif;
            font-size: 1.2rem;
            font-weight: 600;
            color: #0f172a;
            margin-bottom: .35rem;
        }

        .login-subtitle {
            color: #64748b;
            margin-bottom: 1.4rem;
            font-size: .92rem;
        }

        .input-group-text {
            background-color: #eff6ff;
            border-color: #dbeafe;
            color: #1d4ed8;
            font-weight: 700;
        }

        .form-control {
            border-color: #dbeafe;
            min-height: 44px;
        }

        .form-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 .16rem rgba(59, 130, 246, .2);
        }

        .btn-login {
            background: linear-gradient(90deg, #1d4ed8 0%, #2563eb 100%);
            border: none;
            min-height: 44px;
            font-weight: 600;
            letter-spacing: .2px;
        }

        .btn-login:hover,
        .btn-login:focus {
            background: linear-gradient(90deg, #1e40af 0%, #1d4ed8 100%);
        }

        .copyright-note {
            margin-top: 1rem;
            text-align: center;
            color: rgba(255, 255, 255, .9);
            font-size: .85rem;
        }
    </style>
</head>

<body>
    <main class="login-shell">
        <div class="brand-block">
            <img src="~/assets/img/Cryocan logo.JPG" alt="Cryocan Logo">
            <h1>Cryocan Yönetim Paneli</h1>
            <p>Yönetici hesabınızla güvenli giriş yapın</p>
        </div>

        <div class="card login-card">
            <div class="card-body">
                <h5 class="login-title">Yönetici Girişi</h5>
                <p class="login-subtitle">Kullanıcı adı ve şifrenizi girerek devam edin.</p>

                <form asp-action="Login" method="post" class="row g-3 needs-validation" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="col-12">
                        <label for="userEmail" class="form-label">Kullanıcı Adı</label>
                        <div class="input-group has-validation">
                            <span class="input-group-text" id="usernamePrefix">@atSign</span>
                            <input asp-for="Email" type="text" class="form-control" id="userEmail" required autocomplete="username" aria-describedby="usernamePrefix">
                            <div class="invalid-feedback">Lütfen kullanıcı adınızı girin.</div>
                        </div>
                    </div>

                    <div class="col-12">
                        <label for="userPassword" class="form-label">Şifre</label>
                        <input asp-for="Password" type="password" class="form-control" id="userPassword" required autocomplete="current-password">
                        <div class="invalid-feedback">Lütfen şifrenizi girin.</div>
                    </div>

                    <div class="col-12 mt-1">
                        <button class="btn btn-primary btn-login w-100" type="submit">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Giriş Yap
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="copyright-note">Tüm hakları Cryocan firmasına aittir.</div>
    </main>

    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/main.js"></script>
</body>
</html>
