@{
    ViewData["Title"] = "Dizayn Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Dizayn Mühendisliği Dashboard</h2>
        <p class="text-muted mb-0">EN13458 / AD2000 hesaplarından tasarıma geçiş ve onay süreçleri</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6 col-xl-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Satılan Talepler</h5>
                <p class="card-text">Satıştan veya manuel satıştan gelen talepleri teknik olarak inceleyin.</p>
                <a asp-area="Design" asp-controller="SalesRequest" asp-action="Index" class="btn btn-outline-info">Talep Listesine Git</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Teknik Kataloglar</h5>
                <p class="card-text">Malzeme, malzeme formu, akma mukavemeti, depolama tipi ve stok kodlarını görüntüleyin.</p>
                <a asp-area="Design" asp-controller="Catalog" asp-action="Index" class="btn btn-outline-info">Katalogları Aç</a>
            </div>
        </div>
    </div>
</div>
