@{
    ViewData["Title"] = "Dizayn Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Dizayn Mühendisliği Dashboard</h2>
        <p class="text-muted mb-0">Satış veya teklif ekranlarına ihtiyaç duymadan teknik kaynaklara ve hesap motorlarına erişin.</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Teknik Katalog</h5>
                <p class="card-text">Malzeme, malzeme formu, akma mukavemeti, depolama tipi ve stok gruplarını görüntüleyin.</p>
                <a asp-area="Design" asp-controller="Catalog" asp-action="Index" class="btn btn-outline-info">Kataloğu Aç</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">EN13458</h5>
                <p class="card-text">Dizayn alanından EN13458 hesap motoruna ve malzeme seçimlerine erişin.</p>
                <a asp-area="Design" asp-controller="EN13458Calculation" asp-action="Index" class="btn btn-outline-info">EN13458 Hesapları</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">AD2000</h5>
                <p class="card-text">Dizayn alanından AD2000 hesap motoruna ve teknik girdilere erişin.</p>
                <a asp-area="Design" asp-controller="AD2000Calculation" asp-action="Index" class="btn btn-outline-info">AD2000 Hesapları</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Satılan Talepler</h5>
                <p class="card-text">Satıştan gelen ve teknik inceleme gerektiren talepleri dizayn ekranında takip edin.</p>
                <a asp-area="Design" asp-controller="SalesRequest" asp-action="Index" class="btn btn-outline-info">Talep Listesine Git</a>
            </div>
        </div>
    </div>
</div>
