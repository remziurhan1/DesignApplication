@{
    ViewData["Title"] = "Dizayn Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Dizayn Mühendisliği Dashboard</h2>
        <p class="text-muted mb-0">Satış veya teklif ekranlarına ihtiyaç duymadan teknik kaynaklara ve hesap motorlarına erişin.</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Teknik Katalog</h5>
                <p class="card-text">Malzeme, malzeme formu, akma mukavemeti, depolama tipi ve stok gruplarını görüntüleyin.</p>
                <a asp-area="Design" asp-controller="Catalog" asp-action="Index" class="btn btn-outline-info">Kataloğu Aç</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">EN13458</h5>
                <p class="card-text">Dizayn alanından EN13458 hesap motoruna ve malzeme seçimlerine erişin.</p>
                <a asp-area="Design" asp-controller="EN13458Calculation" asp-action="Index" class="btn btn-outline-info">EN13458 Hesapları</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">AD2000</h5>
                <p class="card-text">Dizayn alanından AD2000 hesap motoruna ve teknik girdilere erişin.</p>
                <a asp-area="Design" asp-controller="AD2000Calculation" asp-action="Index" class="btn btn-outline-info">AD2000 Hesapları</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Malzeme ve Grup Yönetimi</h5>
                <p class="card-text">Malzeme, malzeme formu, akma mukavemeti ve depolama tipi kayıtlarını yetkiye göre yönetin.</p>
                <div class="d-flex gap-2 flex-wrap"><a asp-area="Design" asp-controller="Material" asp-action="Index" class="btn btn-outline-info">Malzemeler</a><a asp-area="Design" asp-controller="MaterialForm" asp-action="Index" class="btn btn-outline-secondary">Formlar</a></div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Stok Kodları</h5>
                <p class="card-text">Stok kodlarını listeleyin, yeni kod üretin ve mevcut kodları silmeden düzenleyin.</p>
                <div class="d-flex gap-2 flex-wrap"><a asp-area="Design" asp-controller="StockCodeGeneration" asp-action="Index" class="btn btn-outline-info">Stok Kodları</a><a asp-area="Design" asp-controller="StockCodeGeneration" asp-action="Generate" class="btn btn-info text-white">Yeni Kod Üret</a></div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Stok Grup ve Kural Yönetimi</h5>
                <p class="card-text">Ana grup, alt grup, kural ve ürün grubu tanımlarını yetki verilen dizayn kullanıcıları yönetebilir.</p>
                <div class="d-flex gap-2 flex-wrap"><a asp-area="Design" asp-controller="StockMainCodeGroup" asp-action="Index" class="btn btn-outline-info">Gruplar</a><a asp-area="Design" asp-controller="StockCodePermissions" asp-action="Index" class="btn btn-outline-secondary">Yetkiler</a></div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Dizayn Planlama</h5>
                <p class="card-text">Günlük ve haftalık planları görüntüleyin; gruplara gönderilecek Excel plan çıktısını alın.</p>
                <div class="d-flex gap-2 flex-wrap"><a asp-area="Design" asp-controller="DesignPlanningPlan" asp-action="Daily" class="btn btn-outline-info">Günlük Plan</a><a asp-area="Design" asp-controller="DesignPlanningPlan" asp-action="Weekly" class="btn btn-outline-secondary">Haftalık Plan</a></div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Satılan Talepler</h5>
                <p class="card-text">Satıştan gelen ve teknik inceleme gerektiren talepleri dizayn ekranında takip edin.</p>
                <a asp-area="Design" asp-controller="SalesRequest" asp-action="Index" class="btn btn-outline-info">Talep Listesine Git</a>
            </div>
        </div>
    </div>
</div>
