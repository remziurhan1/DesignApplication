@model IEnumerable<Employee>
@{ ViewData["Title"] = "Dizayn Planlama Personeller"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2>@ViewData["Title"]</h2><a asp-action="Create" class="btn btn-primary">Yeni Personel</a></div>
<table class="table table-striped table-bordered align-middle"><thead><tr><th>Kişi</th><th>Günlük Kapasite</th><th>Aktif</th><th>Uzmanlıklar</th><th></th></tr></thead><tbody>
@foreach (var item in Model) {<tr><td>@item.FullName</td><td>@item.DailyCapacityHours saat</td><td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Aktif" : "Pasif")</span></td><td>@string.Join(", ", item.Expertises.OrderBy(x => x.Priority).Select(x => x.ExpertiseName))</td><td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Düzenle</a><form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Silinsin mi?')">Sil</button></form></td></tr>}
</tbody></table>
