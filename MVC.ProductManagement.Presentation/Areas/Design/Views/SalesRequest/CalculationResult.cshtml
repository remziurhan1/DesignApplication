@model MVC.ProductManagement.Presentation.Areas.Design.Models.DesignCalculationResultVm
@{
    ViewData["Title"] = "Hesap Sonuçları";
}

<div class="pagetitle d-flex justify-content-between align-items-center">
    <div>
        <h1>@Model.RequestNo · @Model.ItemCode</h1>
        <p class="text-muted mb-0">@Model.ItemTitle · @Model.CalculationType · @Model.CalculationName</p>
    </div>
    <a asp-action="Details" asp-route-id="@Model.RequestId" class="btn btn-outline-secondary btn-sm">Detaya Dön</a>
</div>

<section class="section mt-3">
    <div class="card">
        <div class="card-body pt-4">
            @if (!Model.Fields.Any())
            {
                <p class="text-muted mb-0">Hesap sonucu alanı bulunamadı.</p>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var field in Model.Fields)
                    {
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="border rounded-3 h-100 p-3 bg-light-subtle">
                                <div class="small text-muted mb-1">@field.Label</div>
                                <div class="fw-semibold fs-6 text-dark text-break">@field.Value</div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>
