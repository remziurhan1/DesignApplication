<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dizayn Alanı</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" />
    <style>
        body { background: #eefbfb; }
        .design-navbar { background: linear-gradient(90deg, #0aa7a7, #1cc9c9); }
        .design-brand { color: #fff; font-weight: 700; }
        .sidebar { background: #d8f7f7; min-height: calc(100vh - 56px); }
        .sidebar .nav-link { color: #005f66; }
        .sidebar .nav-link.active, .sidebar .nav-link:hover { background: #b4eeee; color: #003b3f; }
        .content-wrap { padding: 1.5rem; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg design-navbar">
        <div class="container-fluid">
            <a class="navbar-brand design-brand" asp-area="Design" asp-controller="Home" asp-action="Index">Dizayn Area</a>
            <a asp-area="" asp-controller="Account" asp-action="Logout" class="btn btn-sm btn-light">Çıkış</a>
        </div>
    </nav>
    <div class="container-fluid">
        <div class="row">
            <aside class="col-md-3 col-lg-2 sidebar py-3">
                <ul class="nav flex-column gap-1">
                    <li class="nav-item"><a class="nav-link" asp-area="Design" asp-controller="Home" asp-action="Index"><i class="bi bi-grid"></i> Dizayn Paneli</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="Design" asp-controller="SalesRequest" asp-action="Index"><i class="bi bi-kanban"></i> Satılan Talepler</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Material" asp-action="Index"><i class="bi bi-box"></i> Malzemeler</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="MaterialForm" asp-action="Index"><i class="bi bi-file-earmark"></i> Malzeme Formları</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="YieldStrength" asp-action="Index"><i class="bi bi-lightning"></i> Akma Mukavemeti</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="StorageType" asp-action="Index"><i class="bi bi-archive"></i> Depolama Tipleri</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="EN13458Calculation" asp-action="Index"><i class="bi bi-calculator"></i> EN13458 Hesapları</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="AD2000Calculation" asp-action="Index"><i class="bi bi-calculator"></i> AD2000 Hesapları</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="StockCodeGeneration" asp-action="Index"><i class="bi bi-upc"></i> Stok Kodu Yönetimi</a></li>
                </ul>
            </aside>
            <main class="col-md-9 col-lg-10 content-wrap">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
