@model TaskTemplate
<div class="row"><div class="col-md-4 mb-3"><label asp-for="ProjectTypeId" class="form-label">Proje Tipi</label><select asp-for="ProjectTypeId" asp-items="ViewBag.ProjectTypes" class="form-select"></select></div><div class="col-md-2 mb-3"><label asp-for="SequenceNo" class="form-label">Sıra</label><input asp-for="SequenceNo" class="form-control" type="number" /></div><div class="col-md-3 mb-3"><label asp-for="ResponsibleRole" class="form-label">Sorumlu</label><input asp-for="ResponsibleRole" class="form-control" /></div><div class="col-md-3 mb-3"><label asp-for="TaskName" class="form-label">Görev</label><input asp-for="TaskName" class="form-control" /></div></div>
<div class="row"><div class="col-md-3 mb-3"><label asp-for="DurationValue" class="form-label">Süre</label><input asp-for="DurationValue" class="form-control" type="number" step="0.25" /></div><div class="col-md-3 mb-3"><label asp-for="DurationUnit" class="form-label">Birim</label><select asp-for="DurationUnit" asp-items="Html.GetEnumSelectList<DurationUnit>()" class="form-select"></select></div><div class="col-md-3 form-check mt-4"><input asp-for="IsPassive" class="form-check-input" /><label asp-for="IsPassive" class="form-check-label">Pasif takip işi</label></div><div class="col-md-3 form-check mt-4"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Aktif şablon</label></div></div>
<button class="btn btn-primary">Kaydet</button> <a asp-action="Index" class="btn btn-secondary">Geri</a>
