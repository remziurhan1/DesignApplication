@model IEnumerable<MVC.ProductManagement.Application.DTOs.StockCodes.Catalog.StockMainCodeGroupListDto>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Ana Kod Grupları</h4>
        <p class="text-muted mb-0">Ana kod gruplarını kart görünümünde yönetebilirsiniz.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Yeni Ana Grup
    </a>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-collection text-muted fs-2"></i>
            <p class="text-muted mt-3 mb-0">Henüz kayıtlı ana kod grubu bulunmuyor.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <div class="text-muted small">Kod</div>
                                <h5 class="mb-0">@item.Code</h5>
                            </div>
                            <span class="badge @(item.IsEnabled ? "bg-success-subtle text-success-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">
                                @(item.IsEnabled ? "Açık" : "Kapalı")
                            </span>
                        </div>

                        <div class="mb-4">
                            <div class="text-muted small">Grup Adı</div>
                            <div class="fw-semibold">@item.Name</div>
                        </div>

                        <div class="mt-auto d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning flex-grow-1">Düzenle</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="flex-grow-1">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100">Sil</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
