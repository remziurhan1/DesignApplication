@model IEnumerable<Project>
@{ ViewData["Title"] = "Dizayn Projeleri"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2>@ViewData["Title"]</h2><div><a asp-controller="DesignPlanningPlan" asp-action="Daily" class="btn btn-outline-secondary">Günlük Plan</a> <a asp-controller="DesignPlanningPlan" asp-action="Weekly" class="btn btn-outline-secondary">Haftalık Plan</a> <a asp-action="Create" class="btn btn-primary">Yeni Proje</a></div></div>
<table class="table table-striped table-bordered align-middle"><thead><tr><th>Kod</th><th>Ad</th><th>Tip</th><th>Başlangıç</th><th>Öncelik</th><th>Durum</th><th></th></tr></thead><tbody>@foreach (var item in Model) {<tr><td>@item.ProjectCode</td><td>@item.ProjectName</td><td>@item.ProjectType?.Name</td><td>@item.StartDate.ToString("dd.MM.yyyy")</td><td>@item.Priority</td><td><span class="badge bg-secondary">@item.Status</span></td><td class="text-end"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Detay</a> <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Düzenle</a><form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Silinsin mi?')">Sil</button></form></td></tr>}</tbody></table>
