@model Project
@using TaskStatus = DesignPlanning.Entities.TaskStatus
@{ ViewData["Title"] = "Proje Detayı"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2>@Model.ProjectCode - @Model.ProjectName</h2><form asp-action="Plan" asp-route-id="@Model.Id" method="post"><button class="btn btn-primary">Yeniden Planla</button> <a asp-action="Index" class="btn btn-secondary">Geri</a></form></div>
<div class="card mb-3"><div class="card-body row"><div class="col-md-3"><strong>Tip:</strong> @Model.ProjectType?.Name</div><div class="col-md-3"><strong>Başlangıç:</strong> @Model.StartDate.ToString("dd.MM.yyyy")</div><div class="col-md-3"><strong>Öncelik:</strong> @Model.Priority</div><div class="col-md-3"><strong>Durum:</strong> <span class="badge bg-secondary">@Model.Status</span></div></div></div>
<table class="table table-sm table-bordered table-striped align-middle"><thead><tr><th>Sıra</th><th>Sorumlu</th><th>Görev</th><th>Süre</th><th>Atanan</th><th>Plan Başlangıç</th><th>Plan Bitiş</th><th>Durum</th><th></th></tr></thead><tbody>
@foreach (var task in Model.Tasks.OrderBy(x => x.SequenceNo)) { var badge = task.Status == TaskStatus.Completed ? "bg-success" : task.Status == TaskStatus.Delayed ? "bg-danger" : task.IsPassive ? "bg-info text-dark" : "bg-secondary"; <tr><td>@task.SequenceNo</td><td>@task.ResponsibleRole</td><td>@task.TaskName @if (task.IsPassive) {<span class="badge bg-info text-dark ms-1">Pasif</span>}</td><td>@task.DurationValue @task.DurationUnit</td><td>@(task.AssignedEmployee?.FullName ?? "-")</td><td>@task.PlannedStart.ToString("dd.MM.yyyy HH:mm")</td><td>@task.PlannedEnd.ToString("dd.MM.yyyy HH:mm")</td><td><span class="badge @badge">@task.Status</span></td><td>@if (task.Status != TaskStatus.Completed) {<form asp-action="CompleteTask" asp-route-id="@task.Id" method="post"><button class="btn btn-sm btn-success">Tamamlandı</button></form>} else {<span class="text-success">@task.ActualEnd?.ToString("dd.MM.yyyy HH:mm")</span>}</td></tr>}
</tbody></table>
