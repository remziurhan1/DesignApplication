@model MVC.ProductManagement.Application.DTOs.StockCodes.Catalog.StockProductGroupDetailDto

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">@Model.Name</h4>
        <p class="text-muted mb-0">Ürün grubunun kayıtlı içerik detayları.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Düzenle</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Listeye Dön</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="border rounded p-3 h-100">
            <div class="text-muted small">Açıklama</div>
            <div>@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="border rounded p-3 h-100">
            <div class="text-muted small">Satır Sayısı</div>
            <div>@Model.ItemCount</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="border rounded p-3 h-100">
            <div class="text-muted small">Toplam Adet</div>
            <div>@Model.TotalQuantity</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="border rounded p-3 h-100">
            <div class="text-muted small">Toplam Maliyet</div>
            <div>@Model.TotalCost.ToString("N2")</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <strong>Grup İçeriği</strong>
    </div>
    <div class="card-body">
        @if (Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Stok Kodu</th>
                            <th>Açıklama</th>
                            <th>Adet</th>
                            <th>Birim Maliyet</th>
                            <th>Toplam Maliyet</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.GeneratedCode</td>
                            <td>@item.Description</td>
                            <td>@item.Quantity</td>
                            <td>@item.UnitPrice.ToString("N2")</td>
                            <td>@item.TotalCost.ToString("N2")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-muted">Bu ürün grubunda kayıtlı içerik bulunmuyor.</div>
        }
    </div>
</div>
