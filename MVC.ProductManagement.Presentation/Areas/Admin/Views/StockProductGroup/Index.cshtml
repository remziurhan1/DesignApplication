@model IEnumerable<MVC.ProductManagement.Application.DTOs.StockCodes.Catalog.StockProductGroupDetailDto>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">Ürün Grupları</h4>
        <p class="text-muted mb-0">Kaydedilmiş ürün gruplarını ve kalıcı toplam maliyetlerini görüntüleyin.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Yeni Ürün Grubu</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h6 class="mb-2">Satılan Tanka Göre İhtiyaç Hesabı</h6>
        <p class="text-muted mb-2">Aşağıdaki adet ile her ürün grubundaki stok kodu ihtiyacını otomatik çarpanla görebilirsiniz.</p>
        <div class="row">
            <div class="col-md-4">
                <label class="form-label">Satılan Tank Adedi</label>
                <input id="sold-tank-count" type="number" min="1" step="1" class="form-control" value="1" />
            </div>
        </div>
    </div>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Ad</th>
            <th>Açıklama</th>
            <th>Satır</th>
            <th>Toplam Adet</th>
            <th>Ortalama Birim Maliyet</th>
            <th>Toplam Maliyet</th>
            <th>İçerik</th>
            <th>İşlem</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Description</td>
            <td>@item.ItemCount</td>
            <td>@item.TotalQuantity</td>
            <td>@item.AverageUnitCost.ToString("N2")</td>
            <td>@item.TotalCost.ToString("N2")</td>
            <td style="min-width: 420px;">
                <details>
                    <summary class="text-primary" style="cursor:pointer;">İçeriği Gör (@item.Items.Count satır)</summary>

                    @if (item.Items.Any())
                    {
                        <div class="table-responsive mt-2">
                            <table class="table table-sm table-bordered mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Stok Kodu</th>
                                        <th>Açıklama</th>
                                        <th>Adet</th>
                                        <th>Satışa Göre İhtiyaç</th>
                                        <th>Toplam KG</th>
                                        <th>Satışa Göre KG</th>
                                        <th>Birim Maliyet</th>
                                        <th>Toplam</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var detail in item.Items)
                                {
                                    <tr>
                                        <td>@detail.GeneratedCode</td>
                                        <td>@detail.Description</td>
                                        <td class="base-qty">@detail.Quantity</td>
                                        <td class="required-qty">@detail.Quantity</td>
                                        <td class="base-kg">@detail.TotalWeightKg.ToString("N3")</td>
                                        <td class="required-kg">@detail.TotalWeightKg.ToString("N3")</td>
                                        <td>@detail.UnitPrice.ToString("N2")</td>
                                        <td>@detail.TotalCost.ToString("N2")</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted mt-2">Bu grupta kayıtlı içerik bulunmuyor.</div>
                    }
                </details>
            </td>
            <td class="d-flex gap-2">
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Detay</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bu ürün grubunu silmek istediğinize emin misiniz?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

<script>
    const soldTankCountInput = document.getElementById('sold-tank-count');

    function recalculateRequiredQuantities() {
        const multiplier = Math.max(1, Number(soldTankCountInput?.value || 1));

        document.querySelectorAll('tr').forEach(row => {
            const baseQtyCell = row.querySelector('.base-qty');
            const requiredQtyCell = row.querySelector('.required-qty');
            const baseKgCell = row.querySelector('.base-kg');
            const requiredKgCell = row.querySelector('.required-kg');

            if (!baseQtyCell || !requiredQtyCell || !baseKgCell || !requiredKgCell) return;

            const baseQty = Number((baseQtyCell.textContent || '0').replace(',', '.'));
            const baseKg = Number((baseKgCell.textContent || '0').replace(/\./g, '').replace(',', '.'));

            requiredQtyCell.textContent = (baseQty * multiplier).toString();
            requiredKgCell.textContent = (baseKg * multiplier).toLocaleString('tr-TR', { minimumFractionDigits: 3, maximumFractionDigits: 3 });
        });
    }

    soldTankCountInput?.addEventListener('input', recalculateRequiredQuantities);
    recalculateRequiredQuantities();
</script>
