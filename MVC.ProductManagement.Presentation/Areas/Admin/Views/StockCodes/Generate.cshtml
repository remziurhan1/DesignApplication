@model MVC.ProductManagement.Presentation.Areas.Admin.Models.StockCodes.S.SStockCodeGenerateVm

@{
    ViewData["Title"] = "S Stok Kodu Üret";
}

<h2>S Stok Kodu Üret</h2>

<form asp-action="Generate" asp-area="Admin" method="post">

    <div class="mb-3">
        <label class="form-label">Ürün Grubu (S – 2. basamak)</label>
        <select asp-for="SProductGroupId" asp-items="Model.Groups" class="form-select" id="groupSelect">
            <option value="">Seçiniz</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Akışkan</label>
        <select asp-for="FluidId" asp-items="Model.Fluids" class="form-select" id="fluidSelect">
            <option value="">@(Model.SProductGroupId == Guid.Empty ? "Önce ürün grubu seçiniz" : "Seçiniz")</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Ürün</label>
        <select asp-for="SProductId" asp-items="Model.Products" class="form-select" id="productSelect">
            <option value="">@((Model.SProductGroupId == Guid.Empty || Model.FluidId == Guid.Empty) ? "Önce ürün grubu + akışkan seçiniz" : "Seçiniz")</option>
        </select>
    </div>

    <!-- ✅ DİNAMİK FEATURES -->
    <div id="featuresContainer"></div>

    <!-- PREFIX = SONUÇ (READONLY) -->
    <div class="mb-3">
        <label class="form-label">Oluşan Prefix</label>
        <input type="text"
               class="form-control"
               value="@Model.Prefix4"
               placeholder="Kod üretince oluşur"
               readonly />
    </div>

    <button type="submit" class="btn btn-primary">
        Kod Üret
    </button>
</form>

@if (!string.IsNullOrWhiteSpace(Model.StockCode8))
{
    <hr />
    <div class="alert @(Model.AlreadyExists == true ? "alert-warning" : "alert-success")">
        <div><strong>Kod:</strong> @Model.StockCode8</div>
        <div><strong>Açıklama:</strong> @Model.Description</div>
        <div><strong>Durum:</strong> @(Model.AlreadyExists == true ? "Mevcut kod getirildi" : "Yeni kod oluşturuldu")</div>
    </div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        @Model.ErrorMessage
    </div>
}

<script>
    const groupSelect = document.getElementById("groupSelect");
    const fluidSelect = document.getElementById("fluidSelect");
    const productSelect = document.getElementById("productSelect");
    const featuresContainer = document.getElementById("featuresContainer");

    function getGroupCodeFromText() {
        const txt = groupSelect.options[groupSelect.selectedIndex]?.textContent || "";
        return (txt.split("-")[0] || "").trim(); // "A", "F" ...
    }

    function resetSelect(selectEl, placeholder) {
        selectEl.innerHTML = "";
        const opt = document.createElement("option");
        opt.value = "";
        opt.textContent = placeholder;
        selectEl.appendChild(opt);
    }

    function clearFeatures() {
        featuresContainer.innerHTML = "";
    }

    function renderFeatures(features) {
        clearFeatures();

        if (!features || features.length === 0) return;

        features
            .sort((a, b) => (a.sortOrder || 0) - (b.sortOrder || 0))
            .forEach(f => {
                const wrapper = document.createElement("div");
                wrapper.className = "mb-3";

                const label = document.createElement("label");
                label.className = "form-label";
                label.textContent = (f.name || "") + (f.isRequired ? " *" : "");

                const select = document.createElement("select");
                select.className = "form-select";

                // ✅ Toleranslı: featureId veya id
                const featureId = f.featureId || f.id;
                select.name = `SelectedFeatureValues[${featureId}]`;

                const opt0 = document.createElement("option");
                opt0.value = "";
                opt0.textContent = "Seçiniz";
                select.appendChild(opt0);

                (f.values || [])
                    .sort((a, b) => (a.sortOrder || 0) - (b.sortOrder || 0))
                    .forEach(v => {
                        const opt = document.createElement("option");

                        // ✅ Toleranslı: valueId veya id
                        const valueId = v.valueId || v.id;
                        opt.value = valueId;

                        const text = `${v.code ?? ""} - ${v.name ?? ""}`.trim();
                        opt.textContent = text === "-" ? "Seçiniz" : text;

                        select.appendChild(opt);
                    });

                wrapper.appendChild(label);
                wrapper.appendChild(select);
                featuresContainer.appendChild(wrapper);
            });
    }

    async function loadFeaturesByProduct(productId) {
        clearFeatures();
        if (!productId) return;

        const url = '@Url.Action("FeaturesByProduct", "SStockCode", new { area = "Admin" })'
            + `?sProductId=${productId}`;

        const response = await fetch(url);
        const data = await response.json();

        renderFeatures(data);
    }

    groupSelect.addEventListener("change", async function () {
        clearFeatures();

        const groupId = this.value;
        const groupCode = getGroupCodeFromText();

        resetSelect(productSelect, "Ürün yükleniyor...");

        // ✅ Akışkan sadece F için
        if (groupCode !== "F") {
            fluidSelect.disabled = true;
            resetSelect(fluidSelect, "Bu grup için akışkan kullanılmaz");

            if (!groupId) {
                resetSelect(productSelect, "Önce ürün grubu seçiniz");
                return;
            }

            const url = '@Url.Action("ProductsByGroupAndFluid", "SStockCode", new { area = "Admin" })'
                + `?groupId=${groupId}`;

            const response = await fetch(url);
            const data = await response.json();

            resetSelect(productSelect, "Seçiniz");
            data.forEach(item => {
                const opt = document.createElement("option");
                opt.value = item.id;
                opt.textContent = item.name;
                productSelect.appendChild(opt);
            });

            // ürün listesi dolduysa feature yüklemesini tetikle
            productSelect.dispatchEvent(new Event("change"));
            return;
        }

        // F grubu: fluid aktif
        fluidSelect.disabled = false;

        resetSelect(fluidSelect, groupId ? "Yükleniyor..." : "Önce ürün grubu seçiniz");
        resetSelect(productSelect, "Önce ürün grubu + akışkan seçiniz");

        if (!groupId) return;

        const url = '@Url.Action("FluidsByGroup", "SStockCode", new { area = "Admin" })'
            + `?groupId=${groupId}`;

        const response = await fetch(url);
        const data = await response.json();

        resetSelect(fluidSelect, "Seçiniz");
        data.forEach(item => {
            const opt = document.createElement("option");
            opt.value = item.id;
            opt.textContent = `${item.code} - ${item.name}`;
            fluidSelect.appendChild(opt);
        });
    });

    fluidSelect.addEventListener("change", async function () {
        clearFeatures();

        const groupId = groupSelect.value;
        const fluidId = this.value;

        resetSelect(productSelect, (groupId && fluidId) ? "Yükleniyor..." : "Önce ürün grubu + akışkan seçiniz");

        if (!groupId || !fluidId) return;

        const url = '@Url.Action("ProductsByGroupAndFluid", "SStockCode", new { area = "Admin" })'
            + `?groupId=${groupId}&fluidId=${fluidId}`;

        const response = await fetch(url);
        const data = await response.json();

        resetSelect(productSelect, "Seçiniz");
        data.forEach(item => {
            const opt = document.createElement("option");
            opt.value = item.id;
            opt.textContent = item.name;
            productSelect.appendChild(opt);
        });

        // ürün listesi dolduysa feature yüklemesini tetikle
        productSelect.dispatchEvent(new Event("change"));
    });

    productSelect.addEventListener("change", async function () {
        const productId = this.value;
        await loadFeaturesByProduct(productId);
    });

    // Sayfa reload olup product seçili gelirse feature'ları otomatik yükle
    document.addEventListener("DOMContentLoaded", async function () {
        if (productSelect && productSelect.value) {
            await loadFeaturesByProduct(productSelect.value);
        }
    });
</script>
