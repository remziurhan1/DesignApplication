@model MVC.ProductManagement.Application.DTOs.StockCodes.SA.SAStockCardDetailDto

@{
    ViewData["Title"] = "SA Stok Kodu Detayı";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-8">
            <h2>
                <i class="bi bi-file-text text-primary"></i>
                Stok Kodu Detayı
            </h2>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Listeye Dön
            </a>
        </div>
    </div>

    <!-- ✅ STOK KODU BİLGİSİ -->
    <div class="card mb-4 shadow-sm border-primary">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                <i class="bi bi-tag-fill"></i>
                <strong>@Model.StockCode8</strong>
            </h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <table class="table table-sm table-borderless">
                        <tr>
                            <th style="width: 150px;">Prefix:</th>
                            <td><span class="badge bg-info fs-6">@Model.Prefix4</span></td>
                        </tr>
                        <tr>
                            <th>Seri No:</th>
                            <td><span class="badge bg-secondary fs-6">@Model.Serial4.ToString("0000")</span></td>
                        </tr>
                        <tr>
                            <th>Ürün:</th>
                            <td>
                                <strong>@Model.ProductCode</strong> - @Model.ProductName
                            </td>
                        </tr>
                        <tr>
                            <th>Fluid:</th>
                            <td>
                                <strong>@Model.FluidCode</strong> - @Model.FluidName
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="col-md-6">
                    <table class="table table-sm table-borderless">
                        <tr>
                            <th style="width: 150px;">Oluşturulma:</th>
                            <td>@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm:ss")</td>
                        </tr>
                        <tr>
                            <th>Oluşturan:</th>
                            <td><span class="badge bg-dark">@Model.CreatedBy</span></td>
                        </tr>
                        <tr>
                            <th>Option Key:</th>
                            <td><small class="text-muted font-monospace">@Model.OptionKey</small></td>
                        </tr>
                    </table>
                </div>
            </div>

            <hr />

            <div class="alert alert-light mb-0">
                <strong><i class="bi bi-info-circle"></i> Açıklama:</strong><br />
                <span class="fs-5">@Model.Description</span>
            </div>
        </div>
    </div>

    <!-- ✅ FEATURE SEÇİMLERİ -->
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <i class="bi bi-sliders"></i> <strong>Ürün Özellikleri</strong>
        </div>
        <div class="card-body">
            @if (Model.FeatureSelections.Any())
            {
                <div class="row g-3">
                    @foreach (var selection in Model.FeatureSelections.OrderBy(s => s.SortOrder))
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 border-success">
                                <div class="card-body">
                                    <h6 class="card-subtitle mb-2 text-muted">
                                        <i class="bi bi-tag"></i>
                                        @selection.FeatureName
                                    </h6>
                                    <p class="card-text">
                                        <strong class="text-success fs-5">@selection.ValueCode</strong>
                                        @if (!string.IsNullOrEmpty(selection.ValueName) && selection.ValueCode != selection.ValueName)
                                        {
                                            <br />
                                            <small class="text-muted">@selection.ValueName</small>
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="bi bi-inbox display-4 text-muted"></i>
                    <p class="text-muted mt-2">Feature seçimi bulunmuyor.</p>
                </div>
            }
        </div>
    </div>

    <!-- ✅ İŞLEM BUTONLARI -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="d-grid gap-2 d-md-flex justify-content-md-between">
                <a asp-action="Index" class="btn btn-secondary btn-lg">
                    <i class="bi bi-arrow-left"></i> Listeye Dön
                </a>
                <div>
                    <button class="btn btn-outline-primary btn-lg" onclick="window.print()">
                        <i class="bi bi-printer"></i> Yazdır
                    </button>
                    <button class="btn btn-outline-success btn-lg" onclick="copyToClipboard('@Model.StockCode8')">
                        <i class="bi bi-clipboard"></i> Kodu Kopyala
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(function() {
                // Bootstrap toast ile bildirim göster
                const toast = document.createElement('div');
                toast.className = 'toast align-items-center text-white bg-success border-0 position-fixed top-0 end-0 m-3';
                toast.setAttribute('role', 'alert');
                toast.style.zIndex = '9999';
                toast.innerHTML = `
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="bi bi-check-circle-fill"></i> Stok kodu kopyalandı: <strong>${text}</strong>
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                `;
                document.body.appendChild(toast);
                const bsToast = new bootstrap.Toast(toast);
                bsToast.show();
                setTimeout(() => toast.remove(), 3000);
            }).catch(function(err) {
                alert('Kopyalama başarısız: ' + err);
            });
        }
    </script>

    <style>
        /* Print için stil */
        @@media print {
            .btn, nav, .card-header {
                display: none !important;
            }

            .card {
                border: 2px solid #000 !important;
                page-break-inside: avoid;
            }
        }

        /* Feature kartları hover efekti */
        .card.border-success:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 1rem rgba(25, 135, 84, 0.3);
            transition: all 0.3s ease;
        }

        /* Monospace font */
        .font-monospace {
            font-family: 'Courier New', monospace;
        }
    </style>
}