@model MVC.ProductManagement.Presentation.Areas.Admin.Models.StockCodes.SA.SAStockCardDetailViewModel

@{
    ViewData["Title"] = "Stok Kodu Detay - " + Model.StockCard.StockCode8;
}

<div class="container-fluid mt-4">

    <!-- ✅ BAŞLIK -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>
                <i class="bi bi-file-earmark-text text-primary"></i>
                <strong>@Model.StockCard.StockCode8</strong>
            </h2>
            <p class="text-muted mb-0">@Model.StockCard.Description</p>
            <small class="text-muted">
                Oluşturulma: @Model.StockCard.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                - @Model.StockCard.CreatedBy
            </small>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Edit" asp-route-id="@Model.StockCard.Id" class="btn btn-warning">
                <i class="bi bi-pencil-square"></i> Düzenle
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Listeye Dön
            </a>
        </div>
    </div>

    <!-- ✅ MESAJLAR -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <strong>Başarılı!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <strong>Hata!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ✅ TAB NAVIGATION -->
    <ul class="nav nav-tabs mb-4" id="detailTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active"
                    id="general-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#general"
                    type="button"
                    role="tab"
                    aria-controls="general"
                    aria-selected="true">
                <i class="bi bi-info-circle"></i> Genel Bilgiler
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="datasheets-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#datasheets"
                    type="button"
                    role="tab"
                    aria-controls="datasheets"
                    aria-selected="false">
                <i class="bi bi-file-earmark-pdf"></i> Datasheets
                @if (Model.Datasheets != null && Model.Datasheets.Any())
                {
                    <span class="badge bg-primary">@Model.Datasheets.Count</span>
                }
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="prices-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#prices"
                    type="button"
                    role="tab"
                    aria-controls="prices"
                    aria-selected="false">
                <i class="bi bi-currency-dollar"></i> Fiyatlar
                @if (Model.ActivePrice != null)
                {
                    <span class="badge bg-success">Aktif</span>
                }
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="inventory-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#inventory"
                    type="button"
                    role="tab"
                    aria-controls="inventory"
                    aria-selected="false">
                <i class="bi bi-box-seam"></i> Stok
                @if (Model.CurrentInventory != null && Model.CurrentInventory.CurrentStock > 0)
                {
                    <span class="badge bg-info">@Model.CurrentInventory.CurrentStock</span>
                }
                else
                {
                    <span class="badge bg-warning">0</span>
                }
            </button>
        </li>
    </ul>

    <!-- ✅ TAB CONTENT -->
    <div class="tab-content" id="detailTabsContent">

        <!-- ========== TAB 1: GENEL BİLGİLER ========== -->
        <div class="tab-pane fade show active"
             id="general"
             role="tabpanel"
             aria-labelledby="general-tab">
            @await Html.PartialAsync("_GeneralInfoPartial", Model.StockCard)
        </div>

        <!-- ========== TAB 2: DATASHEETS ========== -->
        <div class="tab-pane fade"
             id="datasheets"
             role="tabpanel"
             aria-labelledby="datasheets-tab">
            @{
                var datasheetsModel = new
                {
                    StockCardId = Model.StockCard.Id,
                    Datasheets = Model.Datasheets
                };
            }
            @await Html.PartialAsync("_DatasheetsPartial", datasheetsModel)
        </div>

        <!-- ========== TAB 3: FIYATLAR ========== -->
        <div class="tab-pane fade"
             id="prices"
             role="tabpanel"
             aria-labelledby="prices-tab">
            @{
                var pricesModel = new
                {
                    StockCardId = Model.StockCard.Id,
                    PriceHistory = Model.PriceHistory,
                    ActivePrice = Model.ActivePrice
                };
            }
            @await Html.PartialAsync("_PricesPartial", pricesModel)
        </div>

        <!-- ========== TAB 4: STOK ========== -->
        <div class="tab-pane fade"
             id="inventory"
             role="tabpanel"
             aria-labelledby="inventory-tab">
            @{
                var inventoryModel = new
                {
                    StockCardId = Model.StockCard.Id,
                    CurrentInventory = Model.CurrentInventory,
                    InventoryMovements = Model.InventoryMovements
                };
            }
            @await Html.PartialAsync("_InventoryPartial", inventoryModel)
        </div>

    </div>
</div>

@section Scripts {
    <style>
        /* Tab Styling */
        .nav-tabs {
            border-bottom: 2px solid #dee2e6;
        }

            .nav-tabs .nav-link {
                color: #6c757d;
                font-weight: 500;
                border: none;
                border-bottom: 3px solid transparent;
                transition: all 0.3s ease;
            }

                .nav-tabs .nav-link:hover {
                    color: #0d6efd;
                    border-color: #0d6efd;
                }

                .nav-tabs .nav-link.active {
                    color: #0d6efd;
                    font-weight: 600;
                    background-color: transparent;
                    border-color: #0d6efd;
                }

        .badge {
            font-size: 0.75rem;
            margin-left: 0.25rem;
            padding: 0.25em 0.6em;
        }

        .tab-content {
            min-height: 400px;
            padding-top: 1.5rem;
        }

        /* Loading Animation */
        .tab-pane {
            animation: fadeIn 0.3s ease-in;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>

    <script>
        $(document).ready(function() {
            // URL hash ile tab açma
            var hash = window.location.hash;
            if (hash) {
                var tabButton = $('.nav-tabs button[data-bs-target="' + hash + '"]');
                if (tabButton.length) {
                    var tab = new bootstrap.Tab(tabButton[0]);
                    tab.show();
                }
            }

            // Tab değiştiğinde URL hash'i güncelle
            $('button[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
                var target = $(e.target).data('bs-target');
                window.location.hash = target;
            });

            // Success mesajını 5 saniye sonra kapat
            setTimeout(function() {
                $('.alert-success').fadeOut('slow');
            }, 5000);
        });
    </script>
}
