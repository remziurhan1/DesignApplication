@model MVC.ProductManagement.Application.DTOs.StockCodes.SA.SAStockCardDetailDto

@{
    ViewData["Title"] = "Stok Kodu Detay";
}

<div class="container mt-4">
    <!-- ✅ BAŞLIK -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>
                <i class="bi bi-file-earmark-text text-primary"></i>
                Stok Kodu Detay
            </h2>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Listeye Dön
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <strong>Başarılı!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <strong>Hata!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ✅ GENEL BİLGİLER -->
    <div class="card mb-4 shadow-sm border-primary">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                <i class="bi bi-tag-fill"></i>
                <strong>@Model.StockCode8</strong>
            </h4>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="info-group">
                        <label class="text-muted small">Prefix</label>
                        <p class="fw-bold fs-5">@Model.Prefix4</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="info-group">
                        <label class="text-muted small">Seri No</label>
                        <p class="fw-bold fs-5">@Model.Serial4.ToString("0000")</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="info-group">
                        <label class="text-muted small">Ürün Kodu</label>
                        <p class="fw-bold">@Model.ProductCode</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="info-group">
                        <label class="text-muted small">Ürün Adı</label>
                        <p class="fw-bold">@Model.ProductName</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="info-group">
                        <label class="text-muted small">Fluid Kodu</label>
                        <p class="fw-bold">@Model.FluidCode</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="info-group">
                        <label class="text-muted small">Fluid Adı</label>
                        <p class="fw-bold">@Model.FluidName</p>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="info-group">
                        <label class="text-muted small">Açıklama</label>
                        <p class="fw-bold text-primary">@Model.Description</p>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="info-group">
                        <label class="text-muted small">Option Key</label>
                        <p class="font-monospace small text-muted">@Model.OptionKey</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ✅ FEATURE SEÇİMLERİ -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-success text-white">
            <i class="bi bi-sliders"></i> <strong>Ürün Özellikleri</strong>
        </div>
        <div class="card-body">
            @if (Model.FeatureSelections != null && Model.FeatureSelections.Any())
            {
                <div class="row g-3">
                    @foreach (var selection in Model.FeatureSelections.OrderBy(f => f.SortOrder))
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 border-success">
                                <div class="card-body">
                                    <h6 class="text-muted mb-2">
                                        <i class="bi bi-tag text-success"></i>
                                        @selection.FeatureName
                                    </h6>
                                    <p class="mb-0 fw-bold fs-5">
                                        @selection.ValueCode
                                        @if (!string.IsNullOrEmpty(selection.ValueName) && selection.ValueCode != selection.ValueName)
                                        {
                                            <br />
                                            <small class="text-muted fw-normal">@selection.ValueName</small>
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                    Bu stok kodu için özellik seçimi bulunamadı.
                </div>
            }
        </div>
    </div>

    <!-- ✅ KAYIT BİLGİLERİ -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-secondary text-white">
            <i class="bi bi-clock-history"></i> <strong>Kayıt Bilgileri</strong>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="info-group">
                        <label class="text-muted small">Oluşturulma Tarihi</label>
                        <p class="fw-bold">@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm:ss")</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="info-group">
                        <label class="text-muted small">Oluşturan</label>
                        <p class="fw-bold">@Model.CreatedBy</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ✅ İŞLEM BUTONLARI -->
    <div class="row mb-5">
        <div class="col-12 d-flex gap-2 justify-content-center">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-lg">
                <i class="bi bi-pencil-square"></i> Düzenle
            </a>

            <a asp-action="ExportDetailExcel" asp-route-id="@Model.Id" class="btn btn-success btn-lg">
                <i class="bi bi-file-earmark-excel"></i> Excel İndir
            </a>

            <button type="button" class="btn btn-danger btn-lg" data-bs-toggle="modal" data-bs-target="#deleteModal">
                <i class="bi bi-trash"></i> Sil
            </button>

            <a asp-action="Index" class="btn btn-secondary btn-lg">
                <i class="bi bi-arrow-left"></i> Listeye Dön
            </a>
        </div>
    </div>

    <!-- ✅ Footer için boşluk -->
    <div class="mb-5 pb-5"></div>
</div>

<!-- ✅ SİLME ONAY MODAL -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Silme Onayı
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <strong>Dikkat!</strong> Bu işlem geri alınamaz.
                </div>
                <p class="mb-2"><strong>Silinecek Stok Kodu:</strong></p>
                <p class="fs-4 text-danger fw-bold">@Model.StockCode8</p>
                <p class="mb-2"><strong>Açıklama:</strong></p>
                <p class="text-muted">@Model.Description</p>
                <hr />
                <p class="mb-0">Bu stok kodunu silmek istediğinize emin misiniz?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i> İptal
                </button>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Evet, Sil
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .info-group {
            padding: 0.5rem 0;
        }

            .info-group label {
                display: block;
                margin-bottom: 0.25rem;
                font-size: 0.875rem;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .info-group p {
                margin-bottom: 0;
            }

        .card.border-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.3rem 0.8rem rgba(25, 135, 84, 0.2);
            transition: all 0.2s ease;
        }

        .font-monospace {
            font-family: 'Courier New', monospace;
            background-color: #f8f9fa;
            padding: 0.5rem;
            border-radius: 0.25rem;
            display: block;
        }

        .btn-lg {
            padding: 0.75rem 1.5rem;
            font-size: 1.1rem;
        }

        .modal-content {
            border: none;
            border-radius: 0.5rem;
            overflow: hidden;
        }

        .modal-header.bg-danger {
            background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        }
    </style>
}