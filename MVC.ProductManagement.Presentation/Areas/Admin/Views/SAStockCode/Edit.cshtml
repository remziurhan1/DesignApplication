@model MVC.ProductManagement.Application.DTOs.StockCodes.SA.SAStockCardUpdateDto

@{
    ViewData["Title"] = "SA Stok Kodu Düzenle";
    var features = ViewBag.Features as List<MVC.ProductManagement.Application.DTOs.StockCodes.Common.FeatureDto>;
    var selectedFeatures = ViewBag.SelectedFeatures as Dictionary<Guid, Guid>;
    var stockCode = ViewBag.CurrentStockCode as string;
    var productCode = ViewBag.CurrentProductCode as string;
    var productName = ViewBag.CurrentProductName as string;
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-8">
            <h2>
                <i class="bi bi-pencil-square text-warning"></i>
                Stok Kodu Düzenle
            </h2>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Detail" asp-route-id="@Model.StockCardId" class="btn btn-secondary">
                <i class="bi bi-x-circle"></i> İptal
            </a>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <strong>Hata!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <strong>Başarılı!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ✅ MEVCUT STOK KODU -->
    <div class="card mb-4 shadow-sm border-warning">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">
                <i class="bi bi-tag-fill"></i>
                <strong>@stockCode</strong>
            </h4>
        </div>
        <div class="card-body">
            <p class="mb-0">
                <strong>Ürün:</strong> @productCode - @productName
            </p>
            <small class="text-muted">Stok kodu değiştirilemez. Sadece özellikler güncellenebilir.</small>
        </div>
    </div>

    <!-- ✅ DÜZENLEME FORMU -->
    <form asp-action="Edit" asp-route-id="@Model.StockCardId" method="post" id="editForm">
        @Html.AntiForgeryToken()

        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-sliders"></i> <strong>Ürün Özellikleri</strong>
            </div>
            <div class="card-body">
                @if (features != null && features.Any())
                {
                    <div class="row g-3">
                        @foreach (var feature in features.OrderBy(f => f.SortOrder))
                        {
                            <div class="col-md-6">
                                <div class="card h-100 border-primary">
                                    <div class="card-body">
                                        <label class="form-label fw-bold">
                                            <i class="bi bi-tag text-primary"></i>
                                            @feature.Name
                                            @if (feature.IsRequired)
                                            {
                                                <span class="text-danger">*</span>
                                            }
                                        </label>
                                        <select name="featureSelections[@feature.Id]"
                                                class="form-select form-select-lg"
                                                required="@feature.IsRequired">
                                            <option value="">-- Seçiniz --</option>
                                            @foreach (var value in feature.Values.OrderBy(v => v.SortOrder))
                                            {
                                                var isSelected = selectedFeatures != null &&
                                                selectedFeatures.ContainsKey(feature.Id) &&
                                                selectedFeatures[feature.Id] == value.Id;
                                                <option value="@value.Id" selected="@isSelected">
                                                    @value.Code
                                                    @if (!string.IsNullOrEmpty(value.Name) && value.Code != value.Name)
                                                    {
                                                        @($" - {value.Name}")
                                                    }
                                                </option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        Bu ürün için tanımlı feature bulunamadı.
                    </div>
                }
            </div>
        </div>

        <!-- ✅ İŞLEM BUTONLARI -->
        <div class="row mt-4 mb-5">
            <div class="col-12 text-center">
                <button type="submit" class="btn btn-success btn-lg me-2">
                    <i class="bi bi-check-circle"></i> Güncelle
                </button>
                <a asp-action="Detail" asp-route-id="@Model.StockCardId" class="btn btn-secondary btn-lg">
                    <i class="bi bi-x-circle"></i> İptal
                </a>
            </div>
        </div>
    </form>

    <!-- ✅ Footer için boşluk -->
    <div class="mb-5 pb-5"></div>
</div>

@section Scripts {
    <script>
        // ✅ Form submit öncesi onay
        document.getElementById('editForm').addEventListener('submit', function(e) {
            if (!confirm('Stok kodunu güncellemek istediğinize emin misiniz?\n\nDescription otomatik olarak yeniden oluşturulacaktır.')) {
                e.preventDefault();
            }
        });

        // ✅ Değişiklik kontrolü
        let initialValues = {};
        document.querySelectorAll('select[name^="featureSelections"]').forEach(select => {
            initialValues[select.name] = select.value;
        });

        window.addEventListener('beforeunload', function(e) {
            let hasChanges = false;
            document.querySelectorAll('select[name^="featureSelections"]').forEach(select => {
                if (select.value !== initialValues[select.name]) {
                    hasChanges = true;
                }
            });

            if (hasChanges) {
                e.preventDefault();
                e.returnValue = 'Kaydedilmemiş değişiklikler var. Çıkmak istediğinize emin misiniz?';
            }
        });

        // ✅ Form submit edildiğinde beforeunload'u kaldır
        document.getElementById('editForm').addEventListener('submit', function() {
            window.onbeforeunload = null;
        });
    </script>

    <style>
        .card.border-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.3rem 0.8rem rgba(13, 110, 253, 0.2);
            transition: all 0.2s ease;
        }

        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

        .card-header.bg-warning {
            background: linear-gradient(135deg, #ffc107 0%, #ffb300 100%);
        }

        .btn-success:hover {
            transform: scale(1.05);
            transition: transform 0.2s ease;
        }
    </style>
}