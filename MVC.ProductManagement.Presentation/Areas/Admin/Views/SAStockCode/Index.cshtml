@model MVC.ProductManagement.Application.DTOs.Common.PagedResult<MVC.ProductManagement.Application.DTOs.StockCodes.SA.SAStockCardListDto>
@using MVC.ProductManagement.Application.DTOs.StockCodes.SA

@{
    ViewData["Title"] = "SA Stok Kodları Listesi";
}

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col-md-8">
            <h2>
                <i class="bi bi-list-ul text-primary"></i>
                SA Stok Kodları
            </h2>
            <p class="text-muted">Toplam <strong>@Model.TotalCount</strong> kayıt bulundu</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Generate" class="btn btn-success btn-lg">
                <i class="bi bi-plus-circle"></i> Yeni Kod Üret
            </a>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <strong>Hata!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ✅ FİLTRELEME KARTI -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <i class="bi bi-funnel-fill"></i> <strong>Filtrele</strong>
        </div>
        <div class="card-body">
            <form method="get" asp-action="Index" id="filterForm">
                <div class="row g-3">
                    <!-- Ürün Filtresi -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Ürün</label>
                        <select name="ProductId" class="form-select">
                            <option value="">-- Tümü --</option>
                            @foreach (var product in ViewBag.Products as List<SelectListItem>)
                            {
                                <option value="@product.Value" selected="@(Context.Request.Query["ProductId"] == product.Value)">
                                    @product.Text
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Stok Kodu Arama -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Stok Kodu</label>
                        <input type="text" name="StockCode" class="form-control"
                               placeholder="SAA0..."
                               value="@Context.Request.Query["StockCode"]" />
                    </div>

                    <!-- Sayfa Boyutu -->
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Göster</label>
                        <select name="PageSize" class="form-select">
                            <option value="25" selected="@(Model.PageSize == 25)">25</option>
                            <option value="50" selected="@(Model.PageSize == 50)">50</option>
                            <option value="100" selected="@(Model.PageSize == 100)">100</option>
                        </select>
                    </div>

                    <!-- Butonlar -->
                    <div class="col-md-4 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="bi bi-search"></i> Ara
                        </button>
                        <a asp-action="Index" class="btn btn-secondary flex-fill">
                            <i class="bi bi-x-circle"></i> Temizle
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- ✅ SONUÇLAR TABLOSU -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 120px;">Stok Kodu</th>
                                <th style="width: 100px;">Ürün</th>
                                <th>Açıklama</th>
                                <th style="width: 150px;">Oluşturulma</th>
                                <th style="width: 100px;">Oluşturan</th>
                                <th style="width: 100px;" class="text-center">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <strong class="text-primary">@item.StockCode8</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@item.ProductCode</span>
                                    </td>
                                    <td>
                                        <small>@item.Description</small>
                                    </td>
                                    <td>
                                        <small>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</small>
                                    </td>
                                    <td>
                                        <small>@item.CreatedBy</small>
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Detail" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Detay">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- ✅ PAGINATION -->
                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer">
                        <nav aria-label="Sayfa navigasyonu">
                            <ul class="pagination pagination-sm justify-content-center mb-0">
                                <!-- İlk Sayfa -->
                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                    <a class="page-link" href="@GetPageUrl(1)">
                                        <i class="bi bi-chevron-double-left"></i>
                                    </a>
                                </li>

                                <!-- Önceki Sayfa -->
                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                    <a class="page-link" href="@GetPageUrl(Model.PageNumber - 1)">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>

                                <!-- Sayfa Numaraları -->
                                @for (int i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.TotalPages, Model.PageNumber + 2); i++)
                                {
                                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                        <a class="page-link" href="@GetPageUrl(i)">@i</a>
                                    </li>
                                }

                                <!-- Sonraki Sayfa -->
                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                    <a class="page-link" href="@GetPageUrl(Model.PageNumber + 1)">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>

                                <!-- Son Sayfa -->
                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                    <a class="page-link" href="@GetPageUrl(Model.TotalPages)">
                                        <i class="bi bi-chevron-double-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                        <p class="text-center text-muted mt-2 mb-0">
                            Sayfa <strong>@Model.PageNumber</strong> / <strong>@Model.TotalPages</strong>
                        </p>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <h4 class="mt-3 text-muted">Kayıt Bulunamadı</h4>
                    <p class="text-muted">Filtre kriterlerini değiştirip tekrar deneyin.</p>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    string GetPageUrl(int pageNumber)
    {
        var query = Context.Request.Query.ToDictionary(x => x.Key, x => x.Value.ToString());
        query["PageNumber"] = pageNumber.ToString();
        query["PageSize"] = Model.PageSize.ToString();
        return $"?{string.Join("&", query.Select(x => $"{x.Key}={x.Value}"))}";
    }
}

@section Scripts {
    <script>
        // ✅ Enter tuşu ile arama
        document.getElementById('filterForm').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                this.submit();
            }
        });
    </script>

    <style>
        .table-hover tbody tr:hover {
            background-color: #f8f9fa;
            cursor: pointer;
        }

        .pagination .page-link {
            color: #0d6efd;
        }

        .pagination .page-item.active .page-link {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
    </style>
}