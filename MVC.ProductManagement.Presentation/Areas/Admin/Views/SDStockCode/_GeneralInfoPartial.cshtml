@model MVC.ProductManagement.Application.DTOs.StockCodes.SD.SDStockCardDetailDto

<div class="row">
    <!-- GENEL BİLGİLER -->
    <div class="col-md-6">
        <div class="card mb-4 shadow-sm border-success">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">
                    <i class="bi bi-tag-fill"></i> Genel Bilgiler
                </h5>
            </div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tr>
                        <th style="width: 40%;">Stok Kodu:</th>
                        <td><strong class="fs-5 text-success">@Model.StockCode8</strong></td>
                    </tr>
                    <tr>
                        <th>Prefix:</th>
                        <td><strong>@Model.Prefix4</strong></td>
                    </tr>
                    <tr>
                        <th>Seri No:</th>
                        <td><strong>@Model.Serial4.ToString("0000")</strong></td>
                    </tr>
                    <tr>
                        <th>Ürün Kodu:</th>
                        <td>@Model.ProductCode</td>
                    </tr>
                    <tr>
                        <th>Ürün Adı:</th>
                        <td>@Model.ProductName</td>
                    </tr>
                    <tr>
                        <th>Fluid Kodu:</th>
                        <td>@Model.FluidCode</td>
                    </tr>
                    <tr>
                        <th>Fluid Adı:</th>
                        <td>@Model.FluidName</td>
                    </tr>
                    <tr>
                        <th>Açıklama:</th>
                        <td class="text-success"><strong>@Model.Description</strong></td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <!-- FEATURE SEÇİMLERİ -->
    <div class="col-md-6">
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">
                    <i class="bi bi-sliders"></i> Ürün Özellikleri
                </h5>
            </div>
            <div class="card-body">
                @if (Model.FeatureSelections != null && Model.FeatureSelections.Any())
                {
                    <div class="row g-2">
                        @foreach (var selection in Model.FeatureSelections.OrderBy(f => f.SortOrder))
                        {
                            <div class="col-md-6">
                                <div class="card border-success h-100">
                                    <div class="card-body p-2">
                                        <small class="text-muted d-block">@selection.FeatureName</small>
                                        <strong class="text-success">@selection.ValueCode</strong>
                                        @if (!string.IsNullOrEmpty(selection.ValueName) && selection.ValueCode != selection.ValueName)
                                        {
                                            <br />
                                            <small class="text-muted">@selection.ValueName</small>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-exclamation-triangle"></i>
                        Özellik seçimi bulunamadı.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- KAYIT BİLGİLERİ -->
    <div class="col-md-12">
        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-clock-history"></i> Kayıt Bilgileri
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <strong>Oluşturulma Tarihi:</strong> @Model.CreatedDate.ToString("dd.MM.yyyy HH:mm:ss")
                    </div>
                    <div class="col-md-6">
                        <strong>Oluşturan:</strong> @Model.CreatedBy
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
