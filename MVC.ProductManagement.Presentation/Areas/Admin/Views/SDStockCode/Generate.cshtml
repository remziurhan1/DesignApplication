@model MVC.ProductManagement.Presentation.Areas.Admin.Models.StockCodes.SD.SDStockCodeGenerateVm

@{
    ViewData["Title"] = "SD Stok Kodu Üret";
}

<div class="container mt-4">
    <h2>SD Stok Kodu Üret</h2>
    <p class="text-muted"><i class="bi bi-diagram-3 text-info"></i> SD grup listesi ve rule tabanlı özellik seçimi</p>
    <hr />

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show"><strong>Hata!</strong> @Model.ErrorMessage<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.StockCode8))
    {
        <div class="alert @(Model.AlreadyExists == true ? "alert-warning" : "alert-success") alert-dismissible fade show">
            <h5>@(Model.AlreadyExists == true ? "Mevcut Kod Getirildi" : "Yeni Kod Oluşturuldu!")</h5><hr />
            <p><strong>Stok Kodu:</strong> <span class="badge bg-primary fs-4">@Model.StockCode8</span></p>
            <p><strong>Açıklama:</strong><br />@Model.Description</p>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form id="sdForm" asp-action="Generate" method="post">
        <input type="hidden" name="SProductId" id="productIdInput" />

        <div class="card mb-4 shadow-sm"><div class="card-header bg-primary text-white"><strong>1. Ürün Seçimi</strong></div><div class="card-body">
            <select asp-for="SProductId" asp-items="Model.Products" id="productSelect" class="form-select form-select-lg" required><option value="">-- Ürün Seçiniz --</option></select>
        </div></div>

        <div class="card mb-3 shadow-sm" id="segmentCard" style="display:none;">
            <div class="card-header bg-secondary text-white"><strong>2. SD Grup Özeti</strong></div>
            <div class="card-body"><p class="mb-2"><strong>Grup:</strong> <span id="segmentText"></span></p><ul id="summaryList" class="mb-0"></ul></div>
        </div>

        <div class="card mb-4 shadow-sm" id="featuresCard" style="display:none;"><div class="card-header bg-info text-white"><strong>3. Ürün Özellikleri</strong></div><div class="card-body"><div id="featuresContainer"></div></div></div>

        <div id="hiddenInputs"></div>
        <button type="submit" class="btn btn-primary btn-lg" id="submitBtn" disabled>Kod Üret</button>
    </form>
</div>

@section Scripts {
<script>
const productSelect=document.getElementById("productSelect"), productIdInput=document.getElementById("productIdInput"), featuresCard=document.getElementById("featuresCard"), featuresContainer=document.getElementById("featuresContainer"), submitBtn=document.getElementById("submitBtn"), sdForm=document.getElementById("sdForm"), segmentCard=document.getElementById("segmentCard"), segmentText=document.getElementById("segmentText"), summaryList=document.getElementById("summaryList");
let features=[]; let selectedValues={};
const sdGroups={
"SDA0":"HİDROLİK REKOR","SDA1":"HİDROLİK TEE","SDA2":"HİDROLİK DİRSEK","SDA3":"HİDROLİK REDÜKSİYON","SDA4":"HİDROLİK DİĞER BAĞLANTI ELEMANLARI","SDA5":"ÇELİK FİTTİNGS","SDA6":"PASLANMAZ FİTTİNGS","SDA7":"PİRİNÇ FİTTİNGS","SDB0":"PNÖMATİK REKOR","SDB1":"PNÖMATİK TEE","SDB2":"PNÖMATİK DİRSEK","SDB3":"PNÖMATİK REDÜKSİYON","SDB4":"PNÖMATİK DİĞER BAĞLANTI ELEMANLARI","SDC0":"ÇELİK DİRSEK","SDC1":"ÇELİK FLANŞ","SDC2":"ÇELİK REDÜKSİYON","SDC3":"ÇELİK BORU BOĞAZI/BAĞLAYICI","SDC4":"ÇELİK TEE","SDD0":"ALÜ. DİRSEK","SDD1":"ALÜ. FLANŞ","SDD2":"ALÜ. REDÜKSİYON","SDD3":"ALÜ. BORU BOĞAZI/BAĞLAYICI","SDD4":"ALÜ. TEE","SDE0":"PASLANMAZ DİRSEK","SDE1":"PASLANMAZ FLANŞ","SDE2":"PASLANMAZ REDÜKSİYON","SDE3":"PASLANMAZ BORU BOĞAZI/BAĞLAYICI","SDE4":"PASLANMAZ TEE","SDF0":"PİRİNÇ DİRSEK","SDF1":"PİRİNÇ FLANŞ","SDF2":"PİRİNÇ REDÜKSİYON","SDF3":"PİRİNÇ BORU BOĞAZI/BAĞLAYICI","SDF4":"PİRİNÇ TEE","SDF5":"ALÜ. REKOR","SDA8":"PPR - PE FİTTİNGS","SDF9":"POLYEMID/POLİETİLEN DİRSEK","SDG1":"POLYEMID/POLİETİLEN REDÜKSİYON","SDG3":"POLYEMID/POLİETİLEN TEE","SDA9":"ALÜMİNYUM FİTTİNGS","SDH0":"GALVANİZ FLANŞLAR","SDH1":"GALVANİZ FİTTİNGS ELEMANLARI","SDI1":"BRONZ FLANŞ"
};

productSelect.addEventListener("change", async ()=>{ const productId=productSelect.value; features=[]; selectedValues={}; featuresContainer.innerHTML=""; summaryList.innerHTML=""; submitBtn.disabled=true; featuresCard.style.display="none"; segmentCard.style.display="none"; if(!productId) return; const code=(productSelect.selectedOptions[0]?.text||"").split(" - ")[0]; renderSegment(code);
try { const resp=await fetch(`/Admin/SDStockCode/FeaturesByProduct?productId=${productId}`); features=await resp.json(); if(!features?.length){featuresContainer.innerHTML='<div class="alert alert-info">Bu ürün için özellik bulunamadı.</div>'; featuresCard.style.display="block"; return;} renderFeatures(); } catch(err){ featuresContainer.innerHTML=`<div class="alert alert-danger">${err.message}</div>`; featuresCard.style.display="block"; }});

function renderSegment(code){ const name=sdGroups[code]||"SD Ürün Grubu"; segmentText.textContent=`${code} - ${name}`; ["Bağlantı elemanında malzeme/ölçü uyumluluğunu kontrol edin","Aynı ürün kodunda ölçü/standart kombinasyonunu birlikte seçin"].forEach(x=>{const li=document.createElement("li"); li.textContent=x; summaryList.appendChild(li);}); segmentCard.style.display="block"; }
function groupOfFeature(code){ if(code.includes("MALZEME")||code.includes("KAPLAMA")) return "Malzeme"; if(code.includes("DN")||code.includes("CAPI")||code.includes("OLCU")||code.includes("SIZE")) return "Ölçü"; if(code.includes("BASINC")||code.includes("PN")||code.includes("CLASS")||code.includes("STANDART")) return "Standart / Basınç"; return "Genel"; }
function renderFeatures(){ const groups={}; features.forEach(f=>{const g=groupOfFeature(f.code||""); (groups[g]??=[]).push(f);}); featuresContainer.innerHTML=""; Object.entries(groups).forEach(([name,items])=>{const h=document.createElement("h6"); h.className="mt-3 mb-2 text-primary border-bottom pb-1"; h.textContent=name; featuresContainer.appendChild(h); const row=document.createElement("div"); row.className="row"; items.forEach(feature=>{const col=document.createElement("div"); col.className="col-md-6 mb-3"; const label=document.createElement("label"); label.className="form-label fw-bold"; label.textContent=feature.name; const select=document.createElement("select"); select.className="form-select"; select.dataset.featureId=feature.id; select.required=feature.isRequired; select.innerHTML='<option value="">-- Seçiniz --</option>'; (feature.values||[]).forEach(v=>{const o=document.createElement("option"); o.value=v.id; o.textContent=`${v.code} - ${v.name}`; select.appendChild(o);}); select.addEventListener("change",e=>{const id=e.target.dataset.featureId; if(e.target.value) selectedValues[id]=e.target.value; else delete selectedValues[id]; checkForm();}); col.appendChild(label); col.appendChild(select); row.appendChild(col);}); featuresContainer.appendChild(row);}); featuresCard.style.display="block"; checkForm(); }
function checkForm(){ const required=(features||[]).filter(f=>f.isRequired); submitBtn.disabled=!required.every(f=>selectedValues[f.id]); }
sdForm.addEventListener("submit", ()=>{ productIdInput.value=productSelect.value; const c=document.getElementById("hiddenInputs"); c.innerHTML=""; let i=0; Object.entries(selectedValues).forEach(([k,v])=>{const ki=document.createElement("input"); ki.type="hidden"; ki.name=`SelectedFeatureValues[${i}].Key`; ki.value=k; c.appendChild(ki); const vi=document.createElement("input"); vi.type="hidden"; vi.name=`SelectedFeatureValues[${i}].Value`; vi.value=v; c.appendChild(vi); i++;}); });
</script>
}
