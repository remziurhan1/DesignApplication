@model MVC.ProductManagement.Presentation.Areas.Admin.Models.StockCodes.SB.SBStockCodeGenerateVm

@{
    ViewData["Title"] = "SB Stok Kodu Üret (Somunlar)";
}

<div class="container mt-4">
    <h2>SB Stok Kodu Üret - Somunlar</h2>
    <p class="text-muted">
        <i class="bi bi-gear-fill text-success"></i>
        Rule-based sistem: Sabit değerler otomatik, sadece gerekli özellikleri seçin
    </p>
    <hr />

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <strong>Hata!</strong> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.StockCode8))
    {
        <div class="alert @(Model.AlreadyExists == true ? "alert-warning" : "alert-success") alert-dismissible fade show" role="alert">
            <h5 class="alert-heading">
                <i class="bi bi-@(Model.AlreadyExists == true ? "info-circle-fill" : "check-circle-fill")"></i>
                @(Model.AlreadyExists == true ? "Mevcut Kod Getirildi" : "Yeni Kod Oluşturuldu!")
            </h5>
            <hr />
            <p class="mb-2">
                <strong>Stok Kodu:</strong>
                <span class="badge bg-success fs-4">@Model.StockCode8</span>
            </p>
            <p class="mb-0">
                <strong>Açıklama:</strong><br />
                <span class="text-dark">@Model.Description</span>
            </p>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form id="sbForm" asp-action="Generate" method="post">
        <input type="hidden" name="SProductId" id="productIdInput" />

        <!-- ÜRÜN SEÇİMİ -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-success text-white">
                <i class="bi bi-box-seam"></i> <strong>1. Ürün Seçimi</strong>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-12">
                        <label class="form-label fw-bold">Ürün Seçiniz *</label>
                        <select asp-for="SProductId" asp-items="Model.Products" id="productSelect" class="form-select form-select-lg" required>
                            <option value="">-- Ürün Seçiniz --</option>
                        </select>
                        <small class="form-text text-muted">
                            <i class="bi bi-info-circle"></i>
                            Somun tipi seçimi (SBA0, SBB0, SBC0, SBD0, SBE0...)
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- FEATURE CONTAINER (Rule-Based) -->
        <div class="card mb-4 shadow-sm" id="featuresCard" style="display:none;">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-sliders"></i> <strong>2. Ürün Özellikleri</strong>
            </div>
            <div class="card-body">
                <div id="featuresContainer" class="row"></div>
            </div>
        </div>

        <div id="hiddenInputs"></div>

        <hr />

        <div class="d-grid gap-2 d-md-flex justify-content-md-start">
            <button type="submit" class="btn btn-success btn-lg px-5" id="submitBtn" disabled>
                <i class="bi bi-gear-fill"></i> Kod Üret
            </button>
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-secondary btn-lg px-4">
                <i class="bi bi-arrow-left"></i> Geri
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const productSelect = document.getElementById("productSelect");
        const featuresContainer = document.getElementById("featuresContainer");
        const featuresCard = document.getElementById("featuresCard");
        const submitBtn = document.getElementById("submitBtn");
        const productIdInput = document.getElementById("productIdInput");
        const sbForm = document.getElementById("sbForm");

        let formData = null;
        let selectedValues = {};

        productSelect.addEventListener("change", async function () {
            const productId = productSelect.value;

            featuresContainer.innerHTML = "";
            formData = null;
            selectedValues = {};
            submitBtn.disabled = true;
            featuresCard.style.display = "none";

            if (!productId) return;

            try {
                const resp = await fetch(`/Admin/SBStockCode/GetFormData?productId=${productId}`);
                if (!resp.ok) throw new Error("İstek başarısız");

                formData = await resp.json();

                if (!formData || !formData.features || formData.features.length === 0) {
                    featuresContainer.innerHTML = '<div class="col-12"><div class="alert alert-info"><i class="bi bi-info-circle"></i> Bu ürün için özellik tanımı bulunmuyor.</div></div>';
                    featuresCard.style.display = "block";
                    return;
                }

                featuresCard.style.display = "block";
                renderFeatures();

            } catch (err) {
                featuresContainer.innerHTML = `<div class="col-12"><div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> Hata: ${err.message}</div></div>`;
                featuresCard.style.display = "block";
            }
        });

        function renderFeatures() {
            featuresContainer.innerHTML = "";

            formData.features.forEach((feature, index) => {
                const colDiv = document.createElement("div");
                colDiv.className = "col-md-6 col-lg-4 mb-3";

                const label = document.createElement("label");
                label.className = "form-label fw-bold";

                if (feature.isFixed) {
                    label.innerHTML = `
                        <span class="badge bg-success me-1">
                            <i class="bi bi-lock-fill"></i> Sabit
                        </span>
                        ${feature.featureName}
                    `;

                    const fixedInput = document.createElement("input");
                    fixedInput.type = "text";
                    fixedInput.className = "form-control bg-light text-muted";
                    fixedInput.value = `${feature.fixedValueCode} - ${feature.fixedValueName}`;
                    fixedInput.disabled = true;
                    fixedInput.style.fontWeight = "500";

                    colDiv.appendChild(label);
                    colDiv.appendChild(fixedInput);

                    selectedValues[feature.featureId] = feature.fixedValueId;
                } else {
                    label.innerHTML = `
                        <span class="badge bg-primary me-1">${Object.keys(selectedValues).filter(k => !formData.features.find(f => f.featureId === k)?.isFixed).length + 1}</span>
                        ${feature.featureName} <span class="text-danger">*</span>
                    `;

                    const select = document.createElement("select");
                    select.className = "form-select feature-select";
                    select.setAttribute("data-feature-id", feature.featureId);
                    select.setAttribute("data-feature-code", feature.featureCode);
                    select.required = true;

                    const defaultOption = document.createElement("option");
                    defaultOption.value = "";
                    defaultOption.textContent = "-- Seçiniz --";
                    select.appendChild(defaultOption);

                    feature.availableValues.forEach(value => {
                        const option = document.createElement("option");
                        option.value = value.id;
                        option.setAttribute("data-value-code", value.code);
                        option.textContent = `${value.code} - ${value.name}`;
                        select.appendChild(option);
                    });

                    select.addEventListener("change", onFeatureChange);
                    colDiv.appendChild(label);
                    colDiv.appendChild(select);
                }

                featuresContainer.appendChild(colDiv);
            });

            checkFormCompletion();
        }

        function onFeatureChange(e) {
            const select = e.target;
            const featureId = select.getAttribute("data-feature-id");
            const valueId = select.value;

            if (valueId) {
                selectedValues[featureId] = valueId;
                select.classList.add("is-valid");
            } else {
                delete selectedValues[featureId];
                select.classList.remove("is-valid");
            }

            checkFormCompletion();
        }

        function checkFormCompletion() {
            if (!formData) {
                submitBtn.disabled = true;
                return;
            }

            const requiredFeatures = formData.features.filter(f => !f.isFixed);
            const allSelected = requiredFeatures.every(f => selectedValues[f.featureId]);

            submitBtn.disabled = !allSelected;
        }

        sbForm.addEventListener("submit", function (e) {
            e.preventDefault();

            const productId = productSelect.value;
            if (!productId) {
                alert("⚠️ Ürün seçiniz!");
                return;
            }

            productIdInput.value = productId;

            const hiddenContainer = document.getElementById("hiddenInputs");
            hiddenContainer.innerHTML = "";

            let index = 0;

            Object.entries(selectedValues).forEach(([featureId, valueId]) => {
                const keyInput = document.createElement("input");
                keyInput.type = "hidden";
                keyInput.name = `SelectedFeatureValues[${index}].Key`;
                keyInput.value = featureId;
                hiddenContainer.appendChild(keyInput);

                const valueInput = document.createElement("input");
                valueInput.type = "hidden";
                valueInput.name = `SelectedFeatureValues[${index}].Value`;
                valueInput.value = valueId;
                hiddenContainer.appendChild(valueInput);

                index++;
            });

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Kod Üretiliyor...';

            this.submit();
        });

        window.addEventListener("DOMContentLoaded", function () {
            const selectedProductId = productSelect.value;
            if (selectedProductId) {
                productSelect.dispatchEvent(new Event("change"));
            }
        });
    </script>

    <style>
        .bg-light {
            background-color: #e9ecef !important;
            border: 2px solid #198754 !important;
        }

        .feature-select {
            border-color: #198754;
            border-width: 2px;
        }

            .feature-select.is-valid {
                border-color: #198754 !important;
                background-color: #d1e7dd;
            }

        #submitBtn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        #productSelect {
            font-size: 1.1rem;
            font-weight: 500;
        }

        .card {
            transition: all 0.3s ease;
        }

            .card:hover {
                transform: translateY(-2px);
                box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
            }

        .alert {
            animation: slideDown 0.5s ease;
        }

        @@keyframes slideDown {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .badge {
            font-size: 0.85rem;
        }
    </style>
}
