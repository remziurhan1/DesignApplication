@model MVC.ProductManagement.Application.DTOs.StockCodes.OrtakKlasör.StockCardGroupCreateDto

@{
    ViewData["Title"] = "Yeni Stok Kod Grubu";
}

<div class="container mt-4">
    <h2>Yeni Stok Kod Grubu</h2>
    <form method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label">Grup Adı</label>
            <input class="form-control" asp-for="Name" required />
        </div>
        <input type="hidden" asp-for="CurrencyCode" value="EUR" />
        <div class="mb-3">
            <label class="form-label">Para Birimi</label>
            <input class="form-control" value="EUR" disabled />
        </div>
        <button class="btn btn-primary" type="submit">Oluştur</button>
        <a class="btn btn-secondary" asp-action="Index">Geri</a>
    </form>
</div>
