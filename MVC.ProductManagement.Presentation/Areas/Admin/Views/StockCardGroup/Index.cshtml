@model IReadOnlyList<MVC.ProductManagement.Application.DTOs.StockCodes.OrtakKlasör.StockCardGroupListItemDto>

@{
    ViewData["Title"] = "Stok Kod Grupları";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Stok Kod Grupları</h2>
        <a class="btn btn-primary" asp-action="Create">Yeni Grup</a>
    </div>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Grup Kodu</th><th>Ad</th><th>Para Birimi</th><th>Satır</th><th>Toplam</th><th>Tarih</th><th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var g in Model)
        {
            <tr>
                <td>@g.GroupCode</td>
                <td>@g.Name</td>
                <td>@g.CurrencyCode</td>
                <td>@g.ItemCount</td>
                <td>@g.TotalAmount.ToString("N2")</td>
                <td>@g.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                <td><a class="btn btn-sm btn-outline-primary" asp-action="Detail" asp-route-id="@g.Id">Detay</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
