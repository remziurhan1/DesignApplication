@model MVC.ProductManagement.Application.DTOs.StockCodes.OrtakKlasör.StockCardGroupDetailDto

@{
    ViewData["Title"] = "Grup Detayı";
}

@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var groupedCards = ViewBag.StockCardsByGroup as Dictionary<string, List<SelectListItem>> ?? new();
    var groupLabels = new Dictionary<string, string>
    {
        ["SA"] = "SA Grubu (Cıvatalar)",
        ["SB"] = "SB Grubu (Somunlar)",
        ["SC"] = "SC Grubu (Rondelalar)",
        ["SD"] = "SD Grubu (Bağlantı Elemanları)",
        ["SE"] = "SE Grubu (Elektrik Malzemeleri)",
        ["SF"] = "SF Grubu (Aksesuarlar)",
        ["SG"] = "SG Grubu (Pim/Gupilya/Perçin)",
        ["Diger"] = "Diğer"
    };
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <h2>@Model.GroupCode - @Model.Name</h2>
        <a class="btn btn-secondary" asp-action="Index">Listeye Dön</a>
    </div>
    <p class="text-muted">Para Birimi: @Model.CurrencyCode | Toplam Maliyet (KDV'siz): <strong>@Model.TotalAmount.ToString("N2")</strong></p>

    <div class="card mb-4">
        <div class="card-header">Satır Ekle</div>
        <div class="card-body">
            <form asp-action="AddItem" method="post" class="row g-2" id="group-item-add-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="groupId" value="@Model.Id" />
                <input type="hidden" id="selectedStockCardId" name="stockCardId" />

                <div class="col-12">
                    <div class="row g-2">
                        @foreach (var groupKey in new[] { "SA", "SB", "SC", "SD", "SE", "SF", "SG", "Diger" })
                        {
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">@groupLabels[groupKey]</label>
                                <select class="form-select stock-group-select" data-group="@groupKey">
                                    <option value="">Seçiniz...</option>
                                    @if (groupedCards.TryGetValue(groupKey, out var options) && options.Any())
                                    {
                                        foreach (var option in options)
                                        {
                                            <option value="@option.Value">@option.Text</option>
                                        }
                                    }
                                </select>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-md-2">
                    <input class="form-control" type="number" name="quantity" min="1" value="1" />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" type="submit">Ekle</button>
                </div>
            </form>
        </div>
    </div>


    <div class="card mb-4">
        <div class="card-header">Hammadde Ekle (Stok Kodundan Bağımsız)</div>
        <div class="card-body">
            <form asp-action="AddCustomItem" method="post" class="row g-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="groupId" value="@Model.Id" />

                <div class="col-md-5">
                    <input class="form-control" type="text" name="customDescription" placeholder="Örn: 1.4301 Sac" required />
                </div>
                <div class="col-md-2">
                    <input class="form-control" type="number" min="1" name="quantity" value="1" required />
                </div>
                <div class="col-md-2">
                    <input class="form-control" type="text" name="quantityUnit" placeholder="kg / m / adet" required />
                </div>
                <div class="col-md-2">
                    <input class="form-control" type="number" step="0.0001" min="0" name="unitPrice" value="0" required />
                </div>
                <div class="col-md-1">
                    <button class="btn btn-success w-100" type="submit">Ekle</button>
                </div>
            </form>
        </div>
    </div>

    <table class="table table-sm table-bordered align-middle">
        <thead><tr><th>Stok Kodu</th><th>Açıklama</th><th>Miktar</th><th>Birim Fiyat</th><th>Hedef Fiyat</th><th>Satır Toplam</th><th></th></tr></thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.StockCode8</td>
                <td>@item.Description</td>
                <td style="width:220px;">
                    <form asp-action="UpdateQty" method="post" class="d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="groupId" value="@Model.Id" />
                        <input type="hidden" name="itemId" value="@item.ItemId" />
                        <input class="form-control form-control-sm" type="number" min="1" name="quantity" value="@item.Quantity" />
                        <button class="btn btn-sm btn-outline-primary" type="submit">Kaydet</button>
                    </form>
                    @if (!string.IsNullOrWhiteSpace(item.QuantityUnit))
                    {
                        <small class="text-muted">Birim: @item.QuantityUnit</small>
                    }
                </td>
                <td>@item.UnitPrice.ToString("N2")</td>
                <td class="@(item.TargetPrice.HasValue && item.TargetPrice.Value < item.UnitPrice ? "text-success fw-semibold" : "")">@(item.TargetPrice?.ToString("N2") ?? "-")</td>
                <td>@item.LineTotal.ToString("N2")</td>
                <td style="width:90px;">
                    <form asp-action="RemoveItem" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="groupId" value="@Model.Id" />
                        <input type="hidden" name="itemId" value="@item.ItemId" />
                        <button class="btn btn-sm btn-outline-danger" type="submit">Sil</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        (() => {
            const selects = Array.from(document.querySelectorAll('.stock-group-select'));
            const hiddenInput = document.getElementById('selectedStockCardId');
            const form = document.getElementById('group-item-add-form');

            selects.forEach(current => {
                current.addEventListener('change', () => {
                    if (!current.value) {
                        hiddenInput.value = '';
                        return;
                    }

                    hiddenInput.value = current.value;
                    selects.filter(s => s !== current).forEach(other => other.value = '');
                });
            });

            form?.addEventListener('submit', (event) => {
                if (!hiddenInput.value) {
                    event.preventDefault();
                    alert('Lütfen SA/SB/SC ... dropdownlarından bir stok kodu seçiniz.');
                }
            });
        })();
    </script>
}
