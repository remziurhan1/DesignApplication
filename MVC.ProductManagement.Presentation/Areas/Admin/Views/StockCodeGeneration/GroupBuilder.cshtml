@model IEnumerable<MVC.ProductManagement.Application.DTOs.StockCodes.Catalog.GeneratedStockCodeListDto>
@using Microsoft.AspNetCore.Mvc.Rendering

<h4>Ürün Grubu Oluşturucu</h4>
<p class="text-muted">Stok kodlarını adet bazında bir araya getirip birim ve toplam maliyetleri anlık görün.</p>

<form method="get" asp-action="GroupBuilder" class="row g-2 align-items-end mb-3">
    <div class="col-md-6">
        <label class="form-label">Alt Grup Filtresi</label>
        <select name="subGroupId" asp-items="(IEnumerable<SelectListItem>)ViewBag.SubGroups" class="form-select">
            <option value="">Tümü</option>
        </select>
    </div>
    <div class="col-md-6 text-md-end">
        <button class="btn btn-outline-primary" type="submit">Filtrele</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Stok Kodları Listesi</a>
    </div>
</form>

<div class="card mb-3">
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label" for="group-name">Ürün Grubu Adı</label>
            <input id="group-name" class="form-control" placeholder="Örn: 10 LOX STD" />
        </div>

        <div class="table-responsive">
            <table class="table table-bordered align-middle" id="group-table">
                <thead>
                    <tr>
                        <th style="width: 32%;">Stok Kodu</th>
                        <th>Açıklama</th>
                        <th style="width: 10%;">Adet</th>
                        <th style="width: 14%;">Birim Maliyet</th>
                        <th style="width: 14%;">Toplam Maliyet</th>
                        <th style="width: 8%;"></th>
                    </tr>
                </thead>
                <tbody id="group-items"></tbody>
                <tfoot>
                    <tr>
                        <th colspan="2" class="text-end">Genel Toplam</th>
                        <th id="total-quantity">0</th>
                        <th></th>
                        <th id="grand-total">0.00</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>

        <button type="button" class="btn btn-outline-success" id="add-row">Satır Ekle</button>
    </div>
</div>

<script>
    const availableCodes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Select(x => new
        {
            id = x.Id,
            generatedCode = x.GeneratedCode,
            description = x.Description ?? string.Empty,
            unitPrice = x.UnitPrice ?? 0m,
            mainGroupCode = x.MainGroupCode,
            subGroupCode = x.SubGroupCode,
            subGroupName = x.SubGroupName
        })));

    const itemsBody = document.getElementById('group-items');
    const totalQuantityCell = document.getElementById('total-quantity');
    const grandTotalCell = document.getElementById('grand-total');
    const addRowButton = document.getElementById('add-row');

    function buildOptions(selectedId) {
        const options = ['<option value="">Stok kodu seçiniz...</option>'];
        for (const item of availableCodes) {
            const selected = item.id === selectedId ? 'selected' : '';
            options.push(`<option value="${item.id}" ${selected}>${item.generatedCode} - ${item.description}</option>`);
        }

        return options.join('');
    }

    function formatCurrency(value) {
        return Number(value || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function recalculateRow(row) {
        const select = row.querySelector('.stock-code-select');
        const quantityInput = row.querySelector('.quantity-input');
        const descriptionCell = row.querySelector('.description-cell');
        const unitPriceCell = row.querySelector('.unit-price-cell');
        const totalCell = row.querySelector('.total-price-cell');

        const selected = availableCodes.find(x => x.id === select.value) || null;
        const quantity = Number(quantityInput.value || 0);
        const unitPrice = selected?.unitPrice ?? 0;
        const total = quantity * unitPrice;

        descriptionCell.textContent = selected
            ? `${selected.mainGroupCode}/${selected.subGroupCode} - ${selected.subGroupName}${selected.description ? ` | ${selected.description}` : ''}`
            : '-';
        unitPriceCell.textContent = formatCurrency(unitPrice);
        totalCell.textContent = formatCurrency(total);
    }

    function recalculateTotals() {
        let totalQuantity = 0;
        let grandTotal = 0;

        for (const row of itemsBody.querySelectorAll('tr')) {
            const quantity = Number(row.querySelector('.quantity-input')?.value || 0);
            const selectedId = row.querySelector('.stock-code-select')?.value;
            const selected = availableCodes.find(x => x.id === selectedId) || null;

            totalQuantity += quantity;
            grandTotal += quantity * (selected?.unitPrice ?? 0);
            recalculateRow(row);
        }

        totalQuantityCell.textContent = totalQuantity.toString();
        grandTotalCell.textContent = formatCurrency(grandTotal);
    }

    function addRow(selectedId = '') {
        const row = document.createElement('tr');
        row.innerHTML = `
            <td><select class="form-select stock-code-select">${buildOptions(selectedId)}</select></td>
            <td class="description-cell">-</td>
            <td><input type="number" min="0" step="1" value="1" class="form-control quantity-input" /></td>
            <td class="unit-price-cell">0.00</td>
            <td class="total-price-cell">0.00</td>
            <td><button type="button" class="btn btn-sm btn-outline-danger remove-row">Sil</button></td>
        `;

        row.querySelector('.stock-code-select')?.addEventListener('change', recalculateTotals);
        row.querySelector('.quantity-input')?.addEventListener('input', recalculateTotals);
        row.querySelector('.remove-row')?.addEventListener('click', function () {
            row.remove();
            recalculateTotals();
        });

        itemsBody.appendChild(row);
        recalculateTotals();
    }

    addRowButton?.addEventListener('click', function () {
        addRow();
    });

    addRow();
</script>
