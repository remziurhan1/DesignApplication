@model MVC.ProductManagement.Presentation.Areas.Admin.Models.SalesRequestVMs.CustomerFormVm

<div class="pagetitle">
    <h1>@ViewData["Title"]</h1>
</div>

<section class="section mt-4">
    <div class="card">
        <div class="card-body pt-4">
            <form method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="CompanyName" class="form-label"></label>
                        <input asp-for="CompanyName" class="form-control" />
                        <span asp-validation-for="CompanyName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ContactName" class="form-label"></label>
                        <input asp-for="ContactName" class="form-control" />
                        <span asp-validation-for="ContactName" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Sector" class="form-label"></label>
                        <input asp-for="Sector" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ContactPersons" class="form-label"></label>
                        <textarea asp-for="ContactPersons" class="form-control" rows="2" placeholder="Her satıra bir kişi"></textarea>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ContactPhones" class="form-label"></label>
                        <textarea asp-for="ContactPhones" class="form-control" rows="2" placeholder="Her satıra bir telefon"></textarea>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ContactEmails" class="form-label"></label>
                        <textarea asp-for="ContactEmails" class="form-control" rows="2" placeholder="Her satıra bir e-posta"></textarea>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="TaxNumber" class="form-label"></label>
                        <input asp-for="TaxNumber" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TaxOffice" class="form-label"></label>
                        <input asp-for="TaxOffice" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="City" class="form-label"></label>
                        <input asp-for="City" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Country" class="form-label"></label>
                        <input asp-for="Country" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="MainDealerCountry" class="form-label"></label>
                        <input asp-for="MainDealerCountry" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Region" class="form-label"></label>
                        <input asp-for="Region" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label asp-for="Address" class="form-label"></label>
                        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-12">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="col-12 form-check ms-2">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>
                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Listeye dön</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
}
