@model IEnumerable<MVC.ProductManagement.Presentation.Areas.Admin.Models.SalesRequestVMs.CustomerListVm>
@{
    ViewData["Title"] = "Müşteriler";
}

<div class="pagetitle d-flex justify-content-between align-items-center">
    <div>
        <h1>Müşteriler</h1>
        <p class="text-muted mb-0">Satış taleplerinde kullanılacak müşteri kartlarını yönetin.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Yeni müşteri</a>
</div>

<section class="section mt-4">
    <div class="card">
        <div class="card-body pt-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Firma</th>
                            <th>Yetkili</th>
                            <th>İletişim</th>
                            <th>Lokasyon</th>
                            <th>Durum</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.CompanyName</td>
                            <td>@item.ContactName</td>
                            <td>
                                <div>@item.Email</div>
                                <small class="text-muted">@item.Phone</small>
                            </td>
                            <td>@item.City / @item.Country</td>
                            <td>
                                <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Aktif" : "Pasif")</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Müşteriyi silmek istediğinize emin misiniz?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
