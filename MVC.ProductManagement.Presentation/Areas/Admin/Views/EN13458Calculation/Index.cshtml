@model List<MVC.ProductManagement.Presentation.Areas.Admin.Models.EN13458CalculationVMs.EN13458ListVM>
@{
    ViewData["Title"] = "EN13458 Index";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>EN13458 Hesapları</h2>
    <a asp-action="Calculate" class="btn btn-primary">Yeni Hesap</a>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Ad</th>
            <th>Dış Çap</th>
            <th>Silindirik Boy</th>
            <th>Basınç</th>
            <th>İç/Dış Gövde Yuvarlanmış T</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.OuterDiameter</td>
            <td>@item.ShellLength</td>
            <td>@item.Pressure</td>
            <td>@item.RoundedInnerShellThickness / @item.RoundedOuterShellThickness</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detay</a>
            </td>
        </tr>
    }
    </tbody>
</table>
