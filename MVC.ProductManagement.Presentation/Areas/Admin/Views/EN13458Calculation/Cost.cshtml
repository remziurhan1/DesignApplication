@model MVC.ProductManagement.Presentation.Areas.Admin.Models.EN13458CalculationVMs.EN13458DetailsVM
@using System
@using System.Globalization
@{
    ViewData["Title"] = "EN13458 Cost";
    var totalProfileLengthMm = Model.TotalProfileLength > 0 ? Model.TotalProfileLength : Model.RequiredProfileCount * Model.ProfileDevelopedLength;
    var totalProfileLengthM = totalProfileLengthMm / 1000d;
    var costTable = ViewBag.CostTable as MVC.ProductManagement.Application.DTOs.EN13458DTOs.EN13458MaterialCostTableDTO;
    var stockCodeOptions = (ViewBag.StockCodeOptions as IEnumerable<dynamic>)?.ToList() ?? new List<dynamic>();
}

<style>
    .section-title { letter-spacing: .04em; font-size: .78rem; }
    .detail-table th { width: 52%; color: #5b6472; }
    .input-table th { width: 20%; background: #f8f9fa; color: #5b6472; }
    .group-card { border: 1px solid #dbe7ff; background: #f9fbff; }
</style>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-0">EN13458 Maliyet</h2>
        <div class="text-muted small">Kayıt Id: @Model.Id</div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2">Maliyet ekranı</span>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left me-1"></i>Detay Sayfası
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
            <i class="bi bi-pencil-square me-1"></i>Tankı Güncelle
        </a>
        <a asp-action="ExportDetailExcel" asp-route-id="@Model.Id" asp-route-costAnalysisId="@costTable?.CostAnalysisId" class="btn btn-outline-secondary">
            <i class="bi bi-file-earmark-excel me-1"></i>Excel
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light fw-semibold">Sonuç Özeti</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-sm align-middle mb-0">
                <tbody>
                <tr><th class="w-50">İç Tank</th><td>@Model.RoundedInnerShellThickness.ToString("0.##", CultureInfo.InvariantCulture) mm / @Model.InnerTankWeight.ToString("0.##", CultureInfo.InvariantCulture) kg</td></tr>
                <tr><th>Dış Tank</th><td>@Model.RoundedOuterShellThickness.ToString("0.##", CultureInfo.InvariantCulture) mm / @Model.OuterTankWeight.ToString("0.##", CultureInfo.InvariantCulture) kg</td></tr>
                <tr><th>İç Bombe</th><td>@Model.RoundedInnerHeadThickness.ToString("0.##", CultureInfo.InvariantCulture) mm / @Model.InnerTankHeadWeight.ToString("0.##", CultureInfo.InvariantCulture) kg</td></tr>
                <tr><th>Dış Bombe</th><td>@Model.RoundedOuterHeadThickness.ToString("0.##", CultureInfo.InvariantCulture) mm / @Model.OuterTankHeadWeight.ToString("0.##", CultureInfo.InvariantCulture) kg</td></tr>
                <tr><th>Toplam Kaynak Uzunluğu</th><td>@Model.TotalWeldLength</td></tr>
                <tr><th>Gerekli Profil Adedi</th><td>@Model.RequiredProfileCount</td></tr>
                <tr><th>Toplam Profil Metrajı</th><td>@totalProfileLengthM.ToString("0.##", CultureInfo.InvariantCulture) m</td></tr>
                <tr><th>Perlit</th><td>@Model.PerliteWeight.ToString("0.##", CultureInfo.InvariantCulture) kg</td></tr>
                <tr><th>Gaz Azot</th><td>@Model.GasNitrogenVolume.ToString("0.##", CultureInfo.InvariantCulture) Nm³</td></tr>
                <tr><th>Sıvı Azot</th><td>@Model.LiquidNitrogenVolume.ToString("0.##", CultureInfo.InvariantCulture) kg</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card shadow-sm mt-4 border-warning-subtle">
    <div class="card-header bg-warning-subtle text-warning-emphasis fw-semibold">Maliyet Revizyonları</div>
    <div class="card-body">
        <div class="row g-4">
            <div class="col-12 col-xl-4">
                <div class="border rounded p-3 h-100 bg-light-subtle">
                    <h6 class="fw-semibold">Yeni Maliyet Analizi</h6>
                    <form asp-action="CreateCostAnalysis" method="post" class="row g-3 mt-1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="col-12">
                            <label class="form-label">Analiz Adı</label>
                            <input type="text" name="analysisName" class="form-control" value="@(costTable?.AnalysisName ?? "Maliyet Analizi")" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Not</label>
                            <textarea name="notes" class="form-control" rows="2" placeholder="İlk maliyet çalışması veya açıklama"></textarea>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-calculator me-1"></i>Yeni Analiz Oluştur
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="col-12 col-xl-4">
                <div class="border rounded p-3 h-100 bg-light-subtle">
                    <h6 class="fw-semibold">Revizyon Oluştur</h6>
                    <form asp-action="CreateCostAnalysisRevision" method="post" class="row g-3 mt-1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="sourceCostAnalysisId" value="@(costTable?.CostAnalysisId ?? Guid.Empty)" />
                        <div class="col-12">
                            <label class="form-label">Revizyon Adı</label>
                            <input type="text" name="analysisName" class="form-control" value="@(costTable?.AnalysisName ?? "Maliyet Analizi")" @(costTable?.CostAnalysisId == null ? "disabled" : null) />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Revizyon Notu</label>
                            <textarea name="notes" class="form-control" rows="2" placeholder="Örn. 1900 çap revizyonu" @(costTable?.CostAnalysisId == null ? "disabled" : null)></textarea>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-outline-warning" @(costTable?.CostAnalysisId == null ? "disabled" : null)>
                                <i class="bi bi-layers me-1"></i>REV Oluştur
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="col-12 col-xl-4">
                <div class="border rounded p-3 h-100 bg-light-subtle">
                    <h6 class="fw-semibold">Kayıtlı Revizyonlar</h6>
                    @if (Model.CostAnalyses.Any())
                    {
                        <div class="list-group">
                            @foreach (var analysis in Model.CostAnalyses)
                            {
                                <a asp-action="Cost" asp-route-id="@Model.Id" asp-route-costAnalysisId="@analysis.Id"
                                   class="list-group-item list-group-item-action @(analysis.Id == costTable?.CostAnalysisId ? "active" : string.Empty)">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <strong>@analysis.RevisionCode</strong>
                                        <span>@analysis.GrandTotalCost.ToString("N2")</span>
                                    </div>
                                    <div class="small">@analysis.Name</div>
                                    <div class="small @(analysis.Id == costTable?.CostAnalysisId ? string.Empty : "text-muted")">@analysis.CreatedDate.ToString("dd.MM.yyyy HH:mm")</div>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small">Henüz kayıtlı maliyet analizi yok. İsterseniz önce yeni analiz oluşturun.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (costTable != null)
{
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-light fw-semibold d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>Maliyet Analizi @costTable.RevisionCode - @costTable.AnalysisName</span>
            <span class="badge @(costTable.IsPreview ? "bg-secondary" : "bg-success")">@(costTable.IsPreview ? "Ön İzleme" : "Kayıtlı Revizyon")</span>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="small text-muted">Toplam Malzeme Maliyeti</div>
                        <div class="fs-5 fw-semibold">@costTable.TotalMaterialCost.ToString("N2")</div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="small text-muted">Film / İzolasyon</div>
                        <div class="fs-5 fw-semibold">@costTable.TotalFilmCost.ToString("N2")</div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="border rounded p-3 h-100 bg-success-subtle border-success-subtle">
                        <div class="small text-muted">Genel Toplam</div>
                        <div class="fs-5 fw-semibold">@costTable.GrandTotalCost.ToString("N2")</div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-3">
                @foreach (var group in costTable.GroupTotals)
                {
                    <div class="col-12 col-md-4">
                        <div class="border rounded p-3 h-100">
                            <div class="small text-muted">@group.CostGroupCode - @group.CostGroupName</div>
                            <div class="fs-5 fw-semibold">@group.TotalCost.ToString("N2")</div>
                        </div>
                    </div>
                }
            </div>

            @if (!costTable.IsPreview && costTable.CostAnalysisId.HasValue)
            {
                <div class="card shadow-sm mt-4 border-success-subtle">
                    <div class="card-header bg-success-subtle text-success-emphasis fw-semibold">Ek Stok / Grup Maliyeti</div>
                    <div class="card-body">
                        <div class="row g-4">
                            <div class="col-12 col-xl-6">
                                <div class="border rounded p-3 h-100 bg-light-subtle">
                                    <h6 class="fw-semibold mb-3">Stok Kod Grubu Ekle</h6>
                                    <form asp-action="AddStockGroup" method="post" class="row g-3">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <input type="hidden" name="costAnalysisId" value="@costTable.CostAnalysisId" />
                                        <div class="col-12">
                                            <label class="form-label">Grup</label>
                                            <select name="stockProductGroupId" class="form-select" asp-items="Model.AvailableStockGroups">
                                                <option value="">Grup seçiniz</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Çarpan</label>
                                            <input type="text" name="multiplier" class="form-control js-decimal-input" inputmode="decimal" value="1" />
                                        </div>
                                        <div class="col-12">
                                            <button type="submit" class="btn btn-success">
                                                <i class="bi bi-collection me-1"></i>Grubu Maliyete Ekle
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                            <div class="col-12 col-xl-6">
                                <div class="border rounded p-3 h-100 bg-light-subtle">
                                    <h6 class="fw-semibold mb-3">Tekil Stok Kodu Ekle</h6>
                                    <form asp-action="AddStockCode" method="post" class="row g-3">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <input type="hidden" name="costAnalysisId" value="@costTable.CostAnalysisId" />
                                        <div class="col-12">
                                            <label class="form-label">Stok Kodu</label>
                                            <select name="generatedStockCodeId" class="form-select cost-stock-select">
                                                <option value="">Stok kodu seçiniz</option>
                                                @foreach (var stockOption in stockCodeOptions)
                                                {
                                                    <option value="@stockOption.id" data-unit-price="@Convert.ToDouble(stockOption.unitPrice).ToString(CultureInfo.InvariantCulture)">@stockOption.text</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Miktar</label>
                                            <input type="text" name="quantity" class="form-control js-decimal-input js-quantity-input" inputmode="decimal" value="1" />
                                        </div>
                                        <div class="col-md-4 form-check mt-4">
                                            <input class="form-check-input js-manual-toggle" type="checkbox" name="useManualUnitPrice" value="true" />
                                            <label class="form-check-label">Manuel fiyat</label>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Manuel Birim Fiyat</label>
                                            <input type="text" name="manualUnitPrice" class="form-control js-manual-price js-decimal-input" inputmode="decimal" disabled />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Birim Fiyat</label>
                                            <input type="text" class="form-control js-effective-unit-price" value="0,00" readonly />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Toplam</label>
                                            <input type="text" class="form-control js-line-total" value="0,00" readonly />
                                        </div>
                                        <div class="col-12">
                                            <button type="submit" class="btn btn-primary">
                                                <i class="bi bi-plus-circle me-1"></i>Stok Kodunu Ekle
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (!costTable.IsPreview && costTable.CostAnalysisId.HasValue)
            {
                <form asp-action="BulkUpdateCostItems" method="post" class="mt-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="costAnalysisId" value="@costTable.CostAnalysisId" />
                    <div class="table-responsive">
                        <table class="table table-sm table-striped align-middle mb-0">
                            <thead>
                            <tr>
                                <th>Grup</th>
                                <th>Kalem</th>
                                <th>Malzeme / Form</th>
                                <th class="text-end">Miktar</th>
                                <th>Birim</th>
                                <th>Stok Seçimi</th>
                                <th class="text-end">Stok Fiyatı</th>
                                <th class="text-end">Birim Fiyat</th>
                                <th class="text-end">Tutar</th>
                                <th class="text-end">İşlem</th>
                            </tr>
                            </thead>
                            <tbody>
                            @{ var itemIndex = 0; }
                            @foreach (var groupItems in costTable.Items.GroupBy(x => new { x.CostGroupCode, x.CostGroupName }))
                            {
                                <tr class="table-primary">
                                    <td colspan="10" class="fw-semibold">@groupItems.Key.CostGroupCode - @groupItems.Key.CostGroupName | Grup Toplamı: @groupItems.Sum(x => x.ItemCost).ToString("N2")</td>
                                </tr>

                                @foreach (var item in groupItems)
                                {
                                    <tr>
                                        <td>@item.CostGroupCode</td>
                                        <td>
                                            <div>@item.ItemName</div>
                                            <div class="small text-muted">@item.ItemKey</div>
                                        </td>
                                        <td>
                                            <div>@item.MaterialName</div>
                                            <div class="small text-muted">@item.FormType</div>
                                        </td>
                                        <td class="text-end">
                                            @if (item.IsManual)
                                            {
                                                <input type="text"
                                                       name="items[@itemIndex].Quantity"
                                                       value="@item.Quantity.ToString(CultureInfo.InvariantCulture)"
                                                       class="form-control form-control-sm text-end js-quantity-input js-decimal-input" inputmode="decimal" />
                                            }
                                            else
                                            {
                                                @item.Quantity.ToString("N2")
                                            }
                                        </td>
                                        <td>@item.Unit</td>
                                        <td>
                                            <input type="hidden" name="items[@itemIndex].CostAnalysisItemId" value="@item.CostAnalysisItemId" />
                                            <div class="small fw-semibold mb-1">@(string.IsNullOrWhiteSpace(item.StockCodeName) ? "Stok seçilmedi" : $"Seçili: {item.StockCodeName}")</div>
                                            <select name="items[@itemIndex].GeneratedStockCodeId" class="form-select form-select-sm mb-2 cost-stock-select">
                                                <option value="">Stok seçiniz</option>
                                                @foreach (var stockOption in stockCodeOptions)
                                                {
                                                    if (item.GeneratedStockCodeId?.ToString() == stockOption.id.ToString())
                                                    {
                                                        <option value="@stockOption.id"
                                                                data-unit-price="@Convert.ToDouble(stockOption.unitPrice).ToString(CultureInfo.InvariantCulture)"
                                                                selected>
                                                            @stockOption.text
                                                        </option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@stockOption.id"
                                                                data-unit-price="@Convert.ToDouble(stockOption.unitPrice).ToString(CultureInfo.InvariantCulture)">
                                                            @stockOption.text
                                                        </option>
                                                    }
                                                }
                                            </select>
                                            <div class="form-check mb-2">
                                                <input type="hidden" name="items[@itemIndex].UseManualUnitPrice" value="false" />
                                                <input class="form-check-input js-manual-toggle" type="checkbox" name="items[@itemIndex].UseManualUnitPrice" value="true" @(item.UseManualUnitPrice ? "checked" : null) />
                                                <label class="form-check-label small">Manuel fiyat gir</label>
                                            </div>
                                            <input type="text" name="items[@itemIndex].ManualUnitPrice" value="@item.ManualUnitPrice?.ToString(CultureInfo.InvariantCulture)" class="form-control form-control-sm js-manual-price js-decimal-input" inputmode="decimal" @(!item.UseManualUnitPrice ? "disabled" : null) />
                                        </td>
                                        <td class="text-end js-stock-price-cell" data-value="@item.StockUnitPrice.ToString(CultureInfo.InvariantCulture)">@item.StockUnitPrice.ToString("N2")</td>
                                        <td class="text-end js-effective-price-cell" data-value="@item.UnitPrice.ToString(CultureInfo.InvariantCulture)">@item.UnitPrice.ToString("N2")</td>
                                        <td class="text-end fw-semibold js-line-total-cell" data-quantity="@item.Quantity.ToString(CultureInfo.InvariantCulture)" data-value="@item.ItemCost.ToString(CultureInfo.InvariantCulture)">@item.ItemCost.ToString("N2")</td>
                                        <td class="text-end">
                                            @if (item.IsManual && item.CostAnalysisItemId.HasValue)
                                            {
                                                <div class="d-flex flex-column gap-2 align-items-end">
                                                    <span class="small text-muted">Manuel</span>
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            formaction="@Url.Action("RemoveCostItem", "EN13458Calculation", new { area = "Admin" })"
                                                            formmethod="post"
                                                            name="costAnalysisItemId"
                                                            value="@item.CostAnalysisItemId">
                                                        <i class="bi bi-trash me-1"></i>Sil
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="small text-muted">Hesap</span>
                                            }
                                        </td>
                                    </tr>
                                    itemIndex++;
                                }
                            }
                            </tbody>
                            <tfoot>
                            <tr>
                                <th colspan="8" class="text-end">Genel Toplam</th>
                                <th class="text-end">@costTable.GrandTotalCost.ToString("N2")</th>
                                <th></th>
                            </tr>
                            <tr>
                                <td colspan="10" class="text-end">
                                    <button type="submit" class="btn btn-primary px-4">
                                        <i class="bi bi-check2-circle me-1"></i>Uygula
                                    </button>
                                </td>
                            </tr>
                            </tfoot>
                        </table>
                    </div>
                </form>
            }
            else
            {
                <div class="table-responsive mt-4">
                    <table class="table table-sm table-striped align-middle mb-0">
                        <thead>
                        <tr>
                            <th>Grup</th>
                            <th>Kalem</th>
                            <th>Malzeme / Form</th>
                            <th class="text-end">Miktar</th>
                            <th>Birim</th>
                            <th>Stok Kodu</th>
                            <th class="text-end">Stok Fiyatı</th>
                            <th class="text-end">Birim Fiyat</th>
                            <th class="text-end">Tutar</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var groupItems in costTable.Items.GroupBy(x => new { x.CostGroupCode, x.CostGroupName }))
                        {
                            <tr class="table-primary">
                                <td colspan="9" class="fw-semibold">@groupItems.Key.CostGroupCode - @groupItems.Key.CostGroupName | Grup Toplamı: @groupItems.Sum(x => x.ItemCost).ToString("N2")</td>
                            </tr>
                            @foreach (var item in groupItems)
                            {
                                <tr>
                                    <td>@item.CostGroupCode</td>
                                    <td>@item.ItemName</td>
                                    <td>@item.MaterialName / @item.FormType</td>
                                    <td class="text-end">@item.Quantity.ToString("N2")</td>
                                    <td>@item.Unit</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.StockCodeName) ? "-" : item.StockCodeName)</td>
                                    <td class="text-end">@item.StockUnitPrice.ToString("N2")</td>
                                    <td class="text-end">@item.UnitPrice.ToString("N2")</td>
                                    <td class="text-end fw-semibold">@item.ItemCost.ToString("N2")</td>
                                </tr>
                            }
                        }
                        </tbody>
                        <tfoot>
                        <tr>
                            <th colspan="8" class="text-end">Genel Toplam</th>
                            <th class="text-end">@costTable.GrandTotalCost.ToString("N2")</th>
                        </tr>
                        </tfoot>
                    </table>
                </div>
            }        </div>
    </div>
}

@section Scripts {
    <script>
        (() => {
            const parseDecimal = (value) => {
                if (value === null || value === undefined) return 0;
                const normalized = String(value).trim().replace(/\s+/g, '').replace(',', '.');
                if (!normalized) return 0;
                const parsed = Number(normalized);
                return Number.isFinite(parsed) ? parsed : 0;
            };

            const formatDecimal = (value) => Number(value || 0).toLocaleString('tr-TR', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });

            const normalizeDecimalInputs = (scope) => {
                scope.querySelectorAll('.js-decimal-input').forEach((input) => {
                    if (input.disabled) return;
                    const rawValue = input.value?.trim();
                    if (!rawValue) return;
                    input.value = String(parseDecimal(rawValue)).replace(',', '.');
                });
            };

            const resolveManualInput = (checkbox) => {
                const container = checkbox.closest('td, .row, .col-md-4, .col-12, form');
                if (!container) return null;

                return container.querySelector('.js-manual-price')
                    || checkbox.closest('tr')?.querySelector(`input[name="${checkbox.name.replace('UseManualUnitPrice', 'ManualUnitPrice')}"]`)
                    || checkbox.closest('form')?.querySelector('.js-manual-price');
            };

            const updateAddStockForm = (form) => {
                const quantityInput = form.querySelector('.js-quantity-input');
                const stockSelect = form.querySelector('.cost-stock-select');
                const manualToggle = form.querySelector('.js-manual-toggle');
                const manualInput = form.querySelector('.js-manual-price');
                const effectiveUnitPriceInput = form.querySelector('.js-effective-unit-price');
                const totalInput = form.querySelector('.js-line-total');

                if (!quantityInput || !stockSelect || !effectiveUnitPriceInput || !totalInput) return;

                const selectedOption = stockSelect.options[stockSelect.selectedIndex];
                const stockUnitPrice = parseDecimal(selectedOption?.dataset?.unitPrice);
                const manualUnitPrice = parseDecimal(manualInput?.value);
                const quantity = parseDecimal(quantityInput.value);
                const effectiveUnitPrice = manualToggle?.checked ? manualUnitPrice : stockUnitPrice;

                effectiveUnitPriceInput.value = formatDecimal(effectiveUnitPrice);
                totalInput.value = formatDecimal(quantity * effectiveUnitPrice);
            };

            const updateCostRow = (row) => {
                const stockSelect = row.querySelector('.cost-stock-select');
                const manualToggle = row.querySelector('.js-manual-toggle');
                const manualInput = row.querySelector('.js-manual-price');
                const quantityInput = row.querySelector('.js-quantity-input');
                const stockPriceCell = row.querySelector('.js-stock-price-cell');
                const effectivePriceCell = row.querySelector('.js-effective-price-cell');
                const totalCell = row.querySelector('.js-line-total-cell');

                if (!stockSelect || !stockPriceCell || !effectivePriceCell || !totalCell) return;

                const selectedOption = stockSelect.options[stockSelect.selectedIndex];
                const stockUnitPrice = parseDecimal(selectedOption?.dataset?.unitPrice);
                const manualUnitPrice = parseDecimal(manualInput?.value);
                const quantity = quantityInput ? parseDecimal(quantityInput.value) : parseDecimal(totalCell.dataset.quantity);
                const effectiveUnitPrice = manualToggle?.checked ? manualUnitPrice : stockUnitPrice;
                const total = quantity * effectiveUnitPrice;

                stockPriceCell.dataset.value = String(stockUnitPrice);
                stockPriceCell.textContent = formatDecimal(stockUnitPrice);
                effectivePriceCell.dataset.value = String(effectiveUnitPrice);
                effectivePriceCell.textContent = formatDecimal(effectiveUnitPrice);
                totalCell.dataset.quantity = String(quantity);
                totalCell.dataset.value = String(total);
                totalCell.textContent = formatDecimal(total);
            };

            document.querySelectorAll('.js-manual-toggle').forEach((checkbox) => {
                const manualInput = resolveManualInput(checkbox);
                const sync = () => {
                    if (!manualInput) return;
                    manualInput.disabled = !checkbox.checked;
                    if (!checkbox.checked) {
                        manualInput.value = '';
                    }

                    const form = checkbox.closest('form');
                    const row = checkbox.closest('tr');
                    if (row) {
                        updateCostRow(row);
                    } else if (form) {
                        updateAddStockForm(form);
                    }
                };

                checkbox.addEventListener('change', sync);
                sync();
            });

            document.querySelectorAll('.cost-stock-select').forEach((select) => {
                const handler = () => {
                    const row = select.closest('tr');
                    const form = select.closest('form');
                    if (row) {
                        updateCostRow(row);
                    } else if (form) {
                        updateAddStockForm(form);
                    }
                };

                select.addEventListener('change', handler);
                handler();
            });

            document.querySelectorAll('.js-manual-price, .js-quantity-input').forEach((input) => {
                const handler = () => {
                    const row = input.closest('tr');
                    const form = input.closest('form');
                    if (row) {
                        updateCostRow(row);
                    } else if (form) {
                        updateAddStockForm(form);
                    }
                };

                input.addEventListener('input', handler);
                input.addEventListener('change', handler);
            });

            document.querySelectorAll('form').forEach((form) => {
                form.addEventListener('submit', () => normalizeDecimalInputs(form));
            });
        })();
    </script>
}
