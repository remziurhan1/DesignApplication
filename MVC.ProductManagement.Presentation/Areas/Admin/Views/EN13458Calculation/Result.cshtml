@model MVC.ProductManagement.Presentation.Areas.Admin.Models.EN13458CalculationVMs.EN13458ResultVM
@using System.Globalization
@{
    ViewData["Title"] = "EN13458 Result";
    var totalProfileLengthMm = Model.RequiredProfileCount * Model.ProfileDevelopedLength;
    var totalProfileLengthM = totalProfileLengthMm / 1000d;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="mb-0">EN13458 Sonuç</h2>
    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle px-3 py-2">Hesaplama tamamlandı</span>
</div>

<div class="row g-4">
    <div class="col-12 col-xl-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light fw-semibold">Girilen Değerler</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover table-sm align-middle mb-0">
                        <tbody>
                        <tr><th class="w-50">Ad</th><td>@Model.Name</td></tr>
                        <tr><th>İç Tank Çapı</th><td>@Model.OuterDiameter</td></tr>
                        <tr><th>Dış Tank Çapı</th><td>@Model.OuterTankDiameter</td></tr>
                        <tr><th>Silindirik Boy</th><td>@Model.ShellLength</td></tr>
                        <tr><th>Basınç</th><td>@Model.Pressure</td></tr>
                        <tr><th>Depolanacak Ürün</th><td>@Model.StorageTypeName</td></tr>
                        <tr><th>Sıvı Yoğunluğu</th><td>@Model.LiquidDensity</td></tr>
                        <tr><th>Kaynak Boyu 1500</th><td>@Model.WeldLength1500</td></tr>
                        <tr><th>Kaynak Boyu 2000</th><td>@Model.WeldLength2000</td></tr>
                        <tr><th>Kaynak Boyu 2500</th><td>@Model.WeldLength2500</td></tr>
                        <tr><th>Kaynak Boyu 3000</th><td>@Model.WeldLength3000</td></tr>
                        <tr><th>Tank Yönelimi</th><td>@Model.TankOrientation</td></tr>
                        <tr><th>Cold Stretch Uygulandı mı?</th><td>@(Model.IsColdStretchApplied ? "Evet" : "Hayır")</td></tr>

                        <tr><th>İç Tank Gövde Malzemesi</th><td>@Model.InnerShellMaterialName</td></tr>
                        <tr><th>İç Tank Gövde Malzeme Formu</th><td>@Model.InnerShellMaterialFormName</td></tr>
                        <tr><th>İç Tank Bombe Malzemesi</th><td>@Model.InnerHeadMaterialName</td></tr>
                        <tr><th>İç Tank Bombe Malzeme Formu</th><td>@Model.InnerHeadMaterialFormName</td></tr>
                        <tr><th>Dış Tank Gövde Malzemesi</th><td>@Model.OuterShellMaterialName</td></tr>
                        <tr><th>Dış Tank Gövde Malzeme Formu</th><td>@Model.OuterShellMaterialFormName</td></tr>
                        <tr><th>Dış Tank Bombe Malzemesi</th><td>@Model.OuterHeadMaterialName</td></tr>
                        <tr><th>Dış Tank Bombe Malzeme Formu</th><td>@Model.OuterHeadMaterialFormName</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light fw-semibold">Hesap Sonuçları</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover table-sm align-middle mb-0">
                        <tbody>
                        <tr><th class="w-50">İç Gövde Akma Dayanımı (MPa)</th><td>@Model.InnerShellMaterialStrength</td></tr>
                        <tr><th>İç Bombe Akma Dayanımı (MPa)</th><td>@Model.InnerHeadMaterialStrength</td></tr>
                        <tr><th>Dış Gövde Akma Dayanımı (MPa)</th><td>@Model.OuterShellMaterialStrength</td></tr>
                        <tr><th>Dış Bombe Akma Dayanımı (MPa)</th><td>@Model.OuterHeadMaterialStrength</td></tr>

                        <tr><th>İç Gövde Kalınlığı</th><td>@Model.InnerShellThickness</td></tr>
                        <tr><th>İç Bombe Kalınlığı</th><td>@Model.InnerHeadThickness</td></tr>
                        <tr><th>Dış Gövde Kalınlığı</th><td>@Model.OuterShellThickness</td></tr>
                        <tr><th>Dış Bombe Kalınlığı</th><td>@Model.OuterHeadThickness</td></tr>

                        <tr><th>Yuvarlanmış İç Gövde Kalınlığı</th><td>@Model.RoundedInnerShellThickness</td></tr>
                        <tr><th>Yuvarlanmış İç Bombe Kalınlığı</th><td>@Model.RoundedInnerHeadThickness</td></tr>
                        <tr><th>Yuvarlanmış Dış Gövde Kalınlığı</th><td>@Model.RoundedOuterShellThickness</td></tr>
                        <tr><th>Yuvarlanmış Dış Bombe Kalınlığı</th><td>@Model.RoundedOuterHeadThickness</td></tr>

                        <tr><th>Design Pressure</th><td>@Model.DesignPressure</td></tr>
                        <tr><th>Test Pressure</th><td>@Model.TestPressure</td></tr>
                        <tr><th>Static Pressure</th><td>@Model.StaticPressure</td></tr>
                        <tr><th>İç Tank Toplam Uzunluk</th><td>@Model.InnerTankTotalLength</td></tr>
                        <tr><th>Dış Tank Toplam Uzunluk</th><td>@Model.OuterTankTotalLength</td></tr>

                        <tr><th>İç Hacim</th><td>@Model.InnerVolume</td></tr>
                        <tr><th>Dış Hacim</th><td>@Model.OuterVolume</td></tr>
                        <tr><th>İç Yüzey Alanı</th><td>@Model.InnerSurfaceArea</td></tr>
                        <tr><th>Dış Yüzey Alanı</th><td>@Model.OuterSurfaceArea</td></tr>
                        <tr><th>İç Tank Ağırlığı</th><td>@Model.InnerTankWeight</td></tr>
                        <tr><th>Dış Tank Ağırlığı</th><td>@Model.OuterTankWeight</td></tr>
                        <tr><th>Perlit Hacmi</th><td>@Model.PerliteVolume</td></tr>
                        <tr><th>Perlit Ağırlığı (kg)</th><td>@Model.PerliteWeight</td></tr>
                        <tr><th>Gaz Azot Hacmi</th><td>@Model.GasNitrogenVolume</td></tr>
                        <tr><th>Sıvı Azot Hacmi</th><td>@Model.LiquidNitrogenVolume</td></tr>
                        <tr><th>Burkulma Dalga Sayısı (n)</th><td>@Model.BucklingWaveNumber</td></tr>
                        <tr><th>Elastik Burkulma Basıncı P1 (bar)</th><td>@Model.ElasticBucklingPressureP1</td></tr>
                        <tr><th>Plastik Çökme Basıncı P2 (bar)</th><td>@Model.PlasticCollapsePressureP2</td></tr>
                        <tr><th>Tasarım Dış Basıncı Pv (bar)</th><td>@Model.DesignExternalPressurePv</td></tr>
                        <tr><th>Destek Ring Gerekli mi?</th><td>@(Model.SupportRingRequired ? "Evet" : "Hayır")</td></tr>
                        <tr><th>Ring Elastik Kritik Basınç Pe (bar)</th><td>@Model.SupportRingCriticalPressurePe</td></tr>
                        <tr><th>Ring Gerilme X (N/mm²)</th><td>@Model.SupportRingStressX</td></tr>
                        <tr><th>Ring İzinli Gerilme (N/mm²)</th><td>@Model.SupportRingAllowableStress</td></tr>
                        <tr><th>Ring Yeterlilik</th><td>@(Model.SupportRingAdequate ? "Yeterli" : "Yetersiz")</td></tr>
                        <tr><th>Head Çökme Basıncı (bar)</th><td>@Model.HeadCollapsePressure</td></tr>
                        <tr><th>Gerekli Profil Adedi</th><td>@Model.RequiredProfileCount</td></tr>
                        <tr><th>Profil Açınım Uzunluğu (mm)</th><td>@Model.ProfileDevelopedLength</td></tr>
                        <tr><th>Toplam Profil Metrajı (m)</th><td>@totalProfileLengthM.ToString("0.##", CultureInfo.InvariantCulture)</td></tr>
                        <tr><th>Toplam Profil Boyu (mm)</th><td>@totalProfileLengthMm.ToString("0.##", CultureInfo.InvariantCulture)</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="card shadow-sm mt-4">
    <div class="card-header bg-light fw-semibold">Sac Oryantasyonu (Sektör Bazlı)</div>
    <div class="card-body">
        <p class="text-muted mb-2">Format: <strong>Et (mm) x Sektör Genişliği (mm) x Sac Açınımı (mm)</strong></p>

        <h6 class="text-muted text-uppercase fw-semibold mb-2">İç Tank Gövde</h6>
        <div class="table-responsive mb-3">
            <table class="table table-sm table-striped table-bordered align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sektör Genişliği</th>
                        <th>Parça Adedi</th>
                        <th>Sac Açınımı</th>
                        <th>Kesim Listesi</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>1500 mm</td><td>@GetPieceCount(Model.InnerSectorPlan1500) adet</td><td>@Model.InnerDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td><td>@Model.InnerSectorPlan1500</td></tr>
                    <tr><td>2000 mm</td><td>@GetPieceCount(Model.InnerSectorPlan2000) adet</td><td>@Model.InnerDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td><td>@Model.InnerSectorPlan2000</td></tr>
                    <tr><td>2500 mm</td><td>@GetPieceCount(Model.InnerSectorPlan2500) adet</td><td>@Model.InnerDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td><td>@Model.InnerSectorPlan2500</td></tr>
                    <tr><td>3000 mm</td><td>@GetPieceCount(Model.InnerSectorPlan3000) adet</td><td>@Model.InnerDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td><td>@Model.InnerSectorPlan3000</td></tr>
                </tbody>
            </table>
        </div>

        <h6 class="text-muted text-uppercase fw-semibold mb-2">Dış Tank Gövde</h6>
        <div class="table-responsive">
            <table class="table table-sm table-striped table-bordered align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sektör Genişliği</th>
                        <th>Parça Adedi</th>
                        <th>Sac Açınımı</th>
                        <th>Kesim Listesi</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>1500 mm</td><td>@GetPieceCount(Model.OuterSectorPlan1500) adet</td><td>@Model.OuterDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td><td>@Model.OuterSectorPlan1500</td></tr>
                    <tr><td>2000 mm</td><td>@GetPieceCount(Model.OuterSectorPlan2000) adet</td><td>@Model.OuterDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td><td>@Model.OuterSectorPlan2000</td></tr>
                    <tr><td>2500 mm</td><td>@GetPieceCount(Model.OuterSectorPlan2500) adet</td><td>@Model.OuterDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td><td>@Model.OuterSectorPlan2500</td></tr>
                    <tr><td>3000 mm</td><td>@GetPieceCount(Model.OuterSectorPlan3000) adet</td><td>@Model.OuterDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td><td>@Model.OuterSectorPlan3000</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@{
    var costTable = ViewBag.CostTable as MVC.ProductManagement.Application.DTOs.EN13458DTOs.EN13458MaterialCostTableDTO;
}
@if (costTable != null)
{
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-light fw-semibold">Maliyet Grupları</div>
        <div class="card-body">
            <div class="row g-3 mb-3">
                @foreach (var group in costTable.GroupTotals)
                {
                    <div class="col-12 col-md-4">
                        <div class="border rounded p-3 h-100">
                            <div class="small text-muted">@group.CostGroupCode - @group.CostGroupName</div>
                            <div class="fs-5 fw-semibold">@group.TotalCost.ToString("N2")</div>
                        </div>
                    </div>
                }
            </div>

            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Grup</th>
                            <th>Kalem</th>
                            <th>Stok Kodu</th>
                            <th>Malzeme</th>
                            <th class="text-end">Miktar</th>
                            <th>Birim</th>
                            <th class="text-end">Birim Fiyat</th>
                            <th class="text-end">Tutar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in costTable.Items)
                        {
                            <tr>
                                <td>@item.CostGroupCode</td>
                                <td>@item.ItemName</td>
                                <td>@item.StockCode</td>
                                <td>@item.MaterialName</td>
                                <td class="text-end">@item.Quantity.ToString("N2")</td>
                                <td>@item.Unit</td>
                                <td class="text-end">@item.UnitPrice.ToString("N2")</td>
                                <td class="text-end fw-semibold">@item.ItemCost.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="7" class="text-end">Genel Toplam</th>
                            <th class="text-end">@costTable.GrandTotalCost.ToString("N2")</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}


<form asp-action="Save" method="post" class="mt-4 mb-5 pb-4 p-3 border rounded bg-light d-flex flex-wrap gap-2 justify-content-end">
    @Html.AntiForgeryToken()
    @foreach (var p in ViewData.ModelMetadata.Properties)
    {
        if (p.PropertyName == nameof(Model.SelectedStockCardGroupIds))
        {
            continue;
        }

        <input type="hidden" name="@p.PropertyName" value="@ViewData.ModelExplorer.GetExplorerForProperty(p.PropertyName).Model" />
    }

    @for (var i = 0; i < Model.SelectedStockCardGroupIds.Count; i++)
    {
        <input type="hidden" name="SelectedStockCardGroupIds[@i]" value="@Model.SelectedStockCardGroupIds[i]" />
    }

    <button type="submit" class="btn btn-success px-4">
        <i class="bi bi-check2-circle me-1"></i>Kaydet
    </button>
    <a asp-action="Calculate" class="btn btn-primary px-4">
        <i class="bi bi-plus-circle me-1"></i>Yeni Hesap
    </a>
</form>


@functions {
    private static int GetPieceCount(string? cutList)
    {
        if (string.IsNullOrWhiteSpace(cutList)) return 0;
        return cutList.Split(" + ", StringSplitOptions.RemoveEmptyEntries).Length;
    }
}
