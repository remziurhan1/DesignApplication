@model MVC.ProductManagement.Presentation.Areas.Admin.Models.EN13458CalculationVMs.EN13458CalculateVM
@{
    ViewData["Title"] = "EN13458 Calculate";
}

<h2>EN13458 Hesapla</h2>

<form asp-action="Calculate" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="OuterDiameter" class="form-label">İç Tank Çapı (mm)</label>
            <input asp-for="OuterDiameter" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="OuterTankDiameter" class="form-label">Dış Tank Çapı (mm)</label>
            <input asp-for="OuterTankDiameter" class="form-control" />
            <small class="text-muted">Boş bırakılırsa EN13458 otomatik kuralı uygulanır.</small>
        </div>
        <div class="col-md-4">
            <label asp-for="ShellLength" class="form-label"></label>
            <input asp-for="ShellLength" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Pressure" class="form-label"></label>
            <input asp-for="Pressure" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="StorageTypeId" class="form-label">Depolama Tipi</label>
            <select asp-for="StorageTypeId" asp-items="ViewBag.StorageTypes" class="form-select">
                <option value="">Seçiniz</option>
            </select>
            <span asp-validation-for="StorageTypeId" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="LiquidDensity" class="form-label">Sıvı Yoğunluğu (kg/m³)</label>
            <input asp-for="LiquidDensity" class="form-control" readonly />
            <small class="text-muted">Yoğunluk, seçilen depolama tipinin termodinamik verilerinden otomatik hesaplanır.</small>
        </div>
        <div class="col-md-4">
            <label asp-for="TankOrientation" class="form-label">Tank Yönelimi</label>
            <select asp-for="TankOrientation" asp-items="Html.GetEnumSelectList<MVC.ProductManagement.Domain.Enums.TankOrientation>()" class="form-select"></select>
        </div>
        <div class="col-md-4 form-check mt-4 ms-2">
            <input asp-for="IsColdStretchApplied" class="form-check-input" />
            <label asp-for="IsColdStretchApplied" class="form-check-label">Cold Stretch Uygulansın</label>
        </div>
    </div>

    <hr />
    <h5>İç Tank</h5>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">İç Gövde Malzeme Sınıfı</label><select id="InnerShellMaterialGroup" asp-items="ViewBag.MaterialGroups" class="form-select"><option value="">Seçiniz</option></select></div>
        <div class="col-md-6"><label class="form-label">İç Bombe Malzeme Sınıfı</label><select id="InnerHeadMaterialGroup" asp-items="ViewBag.MaterialGroups" class="form-select"><option value="">Seçiniz</option></select></div>

        <div class="col-md-6">
            <label asp-for="InnerShellMaterialId" class="form-label">İç Gövde Malzemesi</label>
            <select asp-for="InnerShellMaterialId" asp-items="ViewBag.Materials" class="form-select"><option value="">Seçiniz</option></select>
        </div>
        <div class="col-md-6">
            <label asp-for="InnerHeadMaterialId" class="form-label">İç Bombe Malzemesi</label>
            <select asp-for="InnerHeadMaterialId" asp-items="ViewBag.Materials" class="form-select"><option value="">Seçiniz</option></select>
        </div>

        <div class="col-md-6"><label class="form-label">İç Gövde Form Tipi</label><select id="InnerShellMaterialFormType" class="form-select"><option value="">Seçiniz</option></select></div>
        <div class="col-md-6"><label class="form-label">İç Bombe Form Tipi</label><select id="InnerHeadMaterialFormType" class="form-select"><option value="">Seçiniz</option></select></div>

        <div class="col-md-6">
            <label asp-for="InnerShellMaterialFormId" class="form-label">İç Gövde Formu</label>
            <select asp-for="InnerShellMaterialFormId" asp-items="ViewBag.MaterialForms" class="form-select"><option value="">Seçiniz</option></select>
        </div>
        <div class="col-md-6">
            <label asp-for="InnerHeadMaterialFormId" class="form-label">İç Bombe Formu</label>
            <select asp-for="InnerHeadMaterialFormId" asp-items="ViewBag.MaterialForms" class="form-select"><option value="">Seçiniz</option></select>
        </div>
    </div>

    <hr />
    <h5>Dış Tank</h5>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">Dış Gövde Malzeme Sınıfı</label><select id="OuterShellMaterialGroup" asp-items="ViewBag.MaterialGroups" class="form-select"><option value="">Seçiniz</option></select></div>
        <div class="col-md-6"><label class="form-label">Dış Bombe Malzeme Sınıfı</label><select id="OuterHeadMaterialGroup" asp-items="ViewBag.MaterialGroups" class="form-select"><option value="">Seçiniz</option></select></div>

        <div class="col-md-6">
            <label asp-for="OuterShellMaterialId" class="form-label">Dış Gövde Malzemesi</label>
            <select asp-for="OuterShellMaterialId" asp-items="ViewBag.Materials" class="form-select"><option value="">Seçiniz</option></select>
        </div>
        <div class="col-md-6">
            <label asp-for="OuterHeadMaterialId" class="form-label">Dış Bombe Malzemesi</label>
            <select asp-for="OuterHeadMaterialId" asp-items="ViewBag.Materials" class="form-select"><option value="">Seçiniz</option></select>
        </div>

        <div class="col-md-6"><label class="form-label">Dış Gövde Form Tipi</label><select id="OuterShellMaterialFormType" class="form-select"><option value="">Seçiniz</option></select></div>
        <div class="col-md-6"><label class="form-label">Dış Bombe Form Tipi</label><select id="OuterHeadMaterialFormType" class="form-select"><option value="">Seçiniz</option></select></div>

        <div class="col-md-6">
            <label asp-for="OuterShellMaterialFormId" class="form-label">Dış Gövde Formu</label>
            <select asp-for="OuterShellMaterialFormId" asp-items="ViewBag.MaterialForms" class="form-select"><option value="">Seçiniz</option></select>
        </div>
        <div class="col-md-6">
            <label asp-for="OuterHeadMaterialFormId" class="form-label">Dış Bombe Formu</label>
            <select asp-for="OuterHeadMaterialFormId" asp-items="ViewBag.MaterialForms" class="form-select"><option value="">Seçiniz</option></select>
        </div>
    </div>

    <hr class="my-4" />
    <h5 class="mb-3">Dış Basınç (Outer Vessel) Girdileri</h5>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="CorrosionAllowance" class="form-label">Korozyon/Tolerans Payı c (mm)</label>
            <input asp-for="CorrosionAllowance" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-4">
            <label asp-for="BucklingLength" class="form-label">Desteklenmemiş Boy lb (mm)</label>
            <input asp-for="BucklingLength" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-4">
            <label asp-for="ElasticModulus" class="form-label">Elastisite Modülü E (MPa)</label>
            <input asp-for="ElasticModulus" class="form-control" type="number" step="1" />
        </div>
        <div class="col-md-4">
            <label asp-for="PoissonRatio" class="form-label">Poisson Oranı ν</label>
            <input asp-for="PoissonRatio" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-4">
            <label asp-for="RoundnessErrorPercent" class="form-label">Dairesellik Hatası u (%)</label>
            <input asp-for="RoundnessErrorPercent" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-4">
            <label asp-for="YieldFactorK" class="form-label">K Katsayısı (MPa)</label>
            <input asp-for="YieldFactorK" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-4 form-check mt-4 ms-2">
            <input asp-for="UseGeneralElasticFormula" class="form-check-input" />
            <label asp-for="UseGeneralElasticFormula" class="form-check-label">Genel elastik denklem kullan</label>
        </div>
        <div class="col-md-4 form-check mt-4 ms-2">
            <input asp-for="HasStiffener" class="form-check-input" />
            <label asp-for="HasStiffener" class="form-check-label">Stiffener mevcut</label>
        </div>
        <div class="col-md-4">
            <label asp-for="StiffenerInertia" class="form-label">Stiffener Atalet Momenti I</label>
            <input asp-for="StiffenerInertia" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-4">
            <label asp-for="StiffenerArea" class="form-label">Stiffener Kesit Alanı A</label>
            <input asp-for="StiffenerArea" class="form-control" type="number" step="0.01" />
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Hesapla</button>
        <a asp-action="Index" class="btn btn-secondary">Liste</a>
    </div>
</form>


@section Scripts {
    <script>
        const formsByMaterial = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MaterialFormsByMaterial));
        const storageTypeDensities = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.StorageTypeDensities));
        const materialsByGroup = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MaterialsByGroup));
        const formTypesByMaterial = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MaterialFormTypesByMaterial));

        function fillOptions(selectElement, options, placeholder = 'Seçiniz') {
            if (!selectElement) return;
            const current = selectElement.value;
            selectElement.innerHTML = '';

            const defaultOption = document.createElement('option');
            defaultOption.value = '';
            defaultOption.text = placeholder;
            selectElement.appendChild(defaultOption);

            (options || []).forEach(item => {
                const opt = document.createElement('option');
                opt.value = item.value;
                opt.text = item.text;
                selectElement.appendChild(opt);
            });

            if ([...selectElement.options].some(x => x.value === current)) {
                selectElement.value = current;
            }
        }

        function bindMaterialCascade(groupSelectId, materialSelectId, formTypeSelectId, formSelectId) {
            const groupSelect = document.getElementById(groupSelectId);
            const materialSelect = document.getElementById(materialSelectId);
            const formTypeSelect = document.getElementById(formTypeSelectId);
            const formSelect = document.getElementById(formSelectId);
            if (!groupSelect || !materialSelect || !formTypeSelect || !formSelect) return;

            const refillMaterials = () => {
                const selectedGroup = groupSelect.value;
                const materialOptions = materialsByGroup[selectedGroup] || [];
                fillOptions(materialSelect, materialOptions);
                refillFormTypes();
            };

            const refillFormTypes = () => {
                const selectedMaterialId = materialSelect.value;
                const types = formTypesByMaterial[selectedMaterialId] || [];
                const options = types.map(type => ({ value: type, text: type }));
                fillOptions(formTypeSelect, options);
                refillForms();
            };

            const refillForms = () => {
                const selectedMaterialId = materialSelect.value;
                const selectedFormType = formTypeSelect.value;
                const baseForms = formsByMaterial[selectedMaterialId] || [];
                const filtered = selectedFormType
                    ? baseForms.filter(x => x.formType === selectedFormType)
                    : baseForms;
                fillOptions(formSelect, filtered);
            };

            groupSelect.addEventListener('change', refillMaterials);
            materialSelect.addEventListener('change', refillFormTypes);
            formTypeSelect.addEventListener('change', refillForms);

            refillMaterials();
        }


        function bindStorageTypeDensity(storageTypeSelectId, densityInputId) {
            const storageTypeSelect = document.getElementById(storageTypeSelectId);
            const densityInput = document.getElementById(densityInputId);
            if (!storageTypeSelect || !densityInput) return;

            const refill = () => {
                const selectedStorageTypeId = storageTypeSelect.value;
                const density = storageTypeDensities[selectedStorageTypeId];
                densityInput.value = density != null ? density : '';
            };

            storageTypeSelect.addEventListener('change', refill);
            refill();
        }
        bindMaterialCascade('InnerShellMaterialGroup', 'InnerShellMaterialId', 'InnerShellMaterialFormType', 'InnerShellMaterialFormId');
        bindMaterialCascade('InnerHeadMaterialGroup', 'InnerHeadMaterialId', 'InnerHeadMaterialFormType', 'InnerHeadMaterialFormId');
        bindMaterialCascade('OuterShellMaterialGroup', 'OuterShellMaterialId', 'OuterShellMaterialFormType', 'OuterShellMaterialFormId');
        bindMaterialCascade('OuterHeadMaterialGroup', 'OuterHeadMaterialId', 'OuterHeadMaterialFormType', 'OuterHeadMaterialFormId');
        bindStorageTypeDensity('StorageTypeId', 'LiquidDensity');
    </script>
}
