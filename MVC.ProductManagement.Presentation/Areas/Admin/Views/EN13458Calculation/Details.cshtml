@model MVC.ProductManagement.Presentation.Areas.Admin.Models.EN13458CalculationVMs.EN13458DetailsVM
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "EN13458 Details";
    var totalProfileLengthMm = Model.TotalProfileLength > 0 ? Model.TotalProfileLength : Model.RequiredProfileCount * Model.ProfileDevelopedLength;
    var totalProfileLengthM = totalProfileLengthMm / 1000d;
}


<style>
    .section-title { letter-spacing: .04em; font-size: .78rem; }
    .detail-table th { width: 52%; color: #5b6472; }
    .input-table th { width: 20%; background: #f8f9fa; color: #5b6472; }
    .group-card { border: 1px solid #dbe7ff; background: #f9fbff; }
</style>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="mb-0">EN13458 Detay</h2>
    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-2">Kayıt detayı</span>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light fw-semibold">Giriş Verileri</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered table-sm align-middle mb-0 input-table">
                <tbody>
                    <tr>
                        <th>Ad</th><td>@Model.Name</td>
                        <th>İç Tank Çapı</th><td>@Model.OuterDiameter</td>
                        <th>Dış Tank Çapı</th><td>@Model.OuterTankDiameter</td>
                    </tr>
                    <tr>
                        <th>Silindirik Boy</th><td>@Model.ShellLength</td>
                        <th>Basınç</th><td>@Model.Pressure</td>
                        <th>Depolanacak Ürün</th><td>@Model.StorageTypeName</td>
                    </tr>
                    <tr>
                        <th>Sıvı Yoğunluğu</th><td>@Model.LiquidDensity</td>
                        <th>Tank Yönelimi</th><td>@Model.TankOrientation</td>
                        <th>Cold Stretch</th><td>@(Model.IsColdStretchApplied ? "Evet" : "Hayır")</td>
                    </tr>
                    <tr>
                        <th>Kaynak Metrajları</th>
                        <td colspan="5">1500: @Model.WeldLength1500.ToString("0.##", CultureInfo.InvariantCulture) m | 2000: @Model.WeldLength2000.ToString("0.##", CultureInfo.InvariantCulture) m | 2500: @Model.WeldLength2500.ToString("0.##", CultureInfo.InvariantCulture) m | 3000: @Model.WeldLength3000.ToString("0.##", CultureInfo.InvariantCulture) m</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="row g-4">
    <div class="col-12 col-xxl-6">
        <div class="card shadow-sm h-100 border-primary-subtle">
            <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold">İç Tank</div>
            <div class="card-body">
                <h6 class="text-muted text-uppercase fw-semibold mb-2">Malzeme</h6>
                <table class="table table-sm table-striped align-middle mb-3 detail-table">
                    <tbody>
                    <tr><th class="w-50">Gövde Malzemesi</th><td>@Model.InnerShellMaterialName</td></tr>
                    <tr><th>Gövde Malzeme Formu</th><td>@Model.InnerShellMaterialFormName</td></tr>
                    <tr><th>Bombe Malzemesi</th><td>@Model.InnerHeadMaterialName</td></tr>
                    <tr><th>Bombe Malzeme Formu</th><td>@Model.InnerHeadMaterialFormName</td></tr>
                    <tr><th>Gövde Akma Dayanımı (MPa)</th><td>@Model.InnerShellMaterialStrength</td></tr>
                    <tr><th>Bombe Akma Dayanımı (MPa)</th><td>@Model.InnerHeadMaterialStrength</td></tr>
                    </tbody>
                </table>

                <h6 class="text-muted text-uppercase fw-semibold mb-2">Kalınlık ve Uzunluk</h6>
                <table class="table table-sm table-striped align-middle mb-3 detail-table">
                    <tbody>
                    <tr><th class="w-50">Gövde Kalınlığı</th><td>@Model.InnerShellThickness</td></tr>
                    <tr><th>Bombe Kalınlığı</th><td>@Model.InnerHeadThickness</td></tr>
                    <tr><th>Yuvarlanmış Gövde Kalınlığı</th><td>@Model.RoundedInnerShellThickness</td></tr>
                    <tr><th>Yuvarlanmış Bombe Kalınlığı</th><td>@Model.RoundedInnerHeadThickness</td></tr>
                    <tr><th>Bombe Pulu Çapı</th><td>@Model.InnerTankHeadPulDiameter</td></tr>
                    <tr><th>Toplam Uzunluk</th><td>@Model.InnerTankTotalLength</td></tr>
                    </tbody>
                </table>

                <h6 class="text-muted text-uppercase fw-semibold mb-2">Kaynak, Hacim ve Ağırlık</h6>
                <table class="table table-sm table-striped align-middle mb-0 detail-table">
                    <tbody>
                    <tr><th class="w-50">Bombe Kaynak Uzunluğu</th><td>@Model.InnerTankHeadWeldLength</td></tr>
                    <tr><th>Çevre Kaynak Uzunluğu</th><td>@Model.InnerTankCircumferenceWeldLength</td></tr>
                    <tr><th>İç Hacim</th><td>@Model.InnerVolume</td></tr>
                    <tr><th>İç Yüzey Alanı</th><td>@Model.InnerSurfaceArea</td></tr>
                    <tr><th>Bombe Ağırlığı</th><td>@Model.InnerTankHeadWeight</td></tr>
                    <tr><th>Tank Ağırlığı</th><td>@Model.InnerTankWeight</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12 col-xxl-6">
        <div class="card shadow-sm h-100 border-secondary-subtle">
            <div class="card-header bg-secondary-subtle text-secondary-emphasis fw-semibold">Dış Tank</div>
            <div class="card-body">
                <h6 class="text-muted text-uppercase fw-semibold mb-2">Malzeme</h6>
                <table class="table table-sm table-striped align-middle mb-3 detail-table">
                    <tbody>
                    <tr><th class="w-50">Gövde Malzemesi</th><td>@Model.OuterShellMaterialName</td></tr>
                    <tr><th>Gövde Malzeme Formu</th><td>@Model.OuterShellMaterialFormName</td></tr>
                    <tr><th>Bombe Malzemesi</th><td>@Model.OuterHeadMaterialName</td></tr>
                    <tr><th>Bombe Malzeme Formu</th><td>@Model.OuterHeadMaterialFormName</td></tr>
                    <tr><th>Gövde Akma Dayanımı (MPa)</th><td>@Model.OuterShellMaterialStrength</td></tr>
                    <tr><th>Bombe Akma Dayanımı (MPa)</th><td>@Model.OuterHeadMaterialStrength</td></tr>
                    </tbody>
                </table>

                <h6 class="text-muted text-uppercase fw-semibold mb-2">Kalınlık ve Uzunluk</h6>
                <table class="table table-sm table-striped align-middle mb-3 detail-table">
                    <tbody>
                    <tr><th class="w-50">Gövde Kalınlığı</th><td>@Model.OuterShellThickness</td></tr>
                    <tr><th>Bombe Kalınlığı</th><td>@Model.OuterHeadThickness</td></tr>
                    <tr><th>Yuvarlanmış Gövde Kalınlığı</th><td>@Model.RoundedOuterShellThickness</td></tr>
                    <tr><th>Yuvarlanmış Bombe Kalınlığı</th><td>@Model.RoundedOuterHeadThickness</td></tr>
                    <tr><th>Bombe Pulu Çapı</th><td>@Model.OuterTankHeadPulDiameter</td></tr>
                    <tr><th>Toplam Uzunluk</th><td>@Model.OuterTankTotalLength</td></tr>
                    </tbody>
                </table>

                <h6 class="text-muted text-uppercase fw-semibold mb-2">Kaynak, Hacim ve Ağırlık</h6>
                <table class="table table-sm table-striped align-middle mb-0 detail-table">
                    <tbody>
                    <tr><th class="w-50">Bombe Kaynak Uzunluğu</th><td>@Model.OuterTankHeadWeldLength</td></tr>
                    <tr><th>Çevre Kaynak Uzunluğu</th><td>@Model.OuterTankCircumferenceWeldLength</td></tr>
                    <tr><th>Dış Hacim</th><td>@Model.OuterVolume</td></tr>
                    <tr><th>Dış Yüzey Alanı</th><td>@Model.OuterSurfaceArea</td></tr>
                    <tr><th>Bombe Ağırlığı</th><td>@Model.OuterTankHeadWeight</td></tr>
                    <tr><th>Tank Ağırlığı</th><td>@Model.OuterTankWeight</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mt-4">
    <div class="card-header bg-light fw-semibold">Ortak Sonuçlar</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-sm align-middle mb-0">
                <tbody>
                <tr><th class="w-50">Design Pressure</th><td>@Model.DesignPressure</td></tr>
                <tr><th>Test Pressure</th><td>@Model.TestPressure</td></tr>
                <tr><th>Static Pressure</th><td>@Model.StaticPressure</td></tr>
                <tr><th>Toplam Kaynak Uzunluğu</th><td>@Model.TotalWeldLength</td></tr>
                <tr><th>Gerekli Profil Adedi</th><td>@Model.RequiredProfileCount</td></tr>
                <tr><th>Profil Açınım Uzunluğu (mm)</th><td>@Model.ProfileDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture)</td></tr>
                <tr><th>Toplam Profil Metrajı (m)</th><td>@totalProfileLengthM.ToString("0.##", CultureInfo.InvariantCulture)</td></tr>
                <tr><th>Toplam Profil Boyu (mm)</th><td>@totalProfileLengthMm.ToString("0.##", CultureInfo.InvariantCulture)</td></tr>
                <tr><th>Profil Kaynak Metrajı (mm)</th><td>@Model.ProfileWeldLength.ToString("0.##", CultureInfo.InvariantCulture)</td></tr>
                <tr><th>Perlit Hacmi</th><td>@Model.PerliteVolume</td></tr>
                <tr><th>Perlit Ağırlığı (kg)</th><td>@Model.PerliteWeight</td></tr>
                <tr><th>Gaz Azot Hacmi</th><td>@Model.GasNitrogenVolume</td></tr>
                <tr><th>Sıvı Azot Hacmi</th><td>@Model.LiquidNitrogenVolume</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>


<div class="card shadow-sm mt-4">
    <div class="card-header bg-light fw-semibold">Sac Oryantasyonu (Sektör Bazlı)</div>
    <div class="card-body">
        <p class="text-muted mb-2">Format: <strong>Et (mm) x Sektör Genişliği (mm) x Sac Açınımı (mm)</strong></p>

        <h6 class="text-muted text-uppercase fw-semibold mb-2">İç Tank Gövde</h6>
        <div class="table-responsive mb-3">
            <table class="table table-sm table-striped table-bordered align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sektör Genişliği</th>
                        <th>Parça Adedi</th>
                        <th>Sac Açınımı</th>
                        <th>Kaynak Metrajı</th>
                        <th>Kesim Listesi</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>1500 mm</td><td>@GetPieceCount(Model.InnerSectorPlan1500) adet</td><td>@Model.InnerDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td><td>@Model.WeldLength1500.ToString("0.##", CultureInfo.InvariantCulture) m</td><td>@FormatCutList(Model.InnerSectorPlan1500)</td></tr>
                    <tr><td>2000 mm</td><td>@GetPieceCount(Model.InnerSectorPlan2000) adet</td><td>@Model.InnerDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td><td>@Model.WeldLength2000.ToString("0.##", CultureInfo.InvariantCulture) m</td><td>@FormatCutList(Model.InnerSectorPlan2000)</td></tr>
                    <tr><td>2500 mm</td><td>@GetPieceCount(Model.InnerSectorPlan2500) adet</td><td>@Model.InnerDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td><td>@Model.WeldLength2500.ToString("0.##", CultureInfo.InvariantCulture) m</td><td>@FormatCutList(Model.InnerSectorPlan2500)</td></tr>
                    <tr><td>3000 mm</td><td>@GetPieceCount(Model.InnerSectorPlan3000) adet</td><td>@Model.InnerDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td><td>@Model.WeldLength3000.ToString("0.##", CultureInfo.InvariantCulture) m</td><td>@FormatCutList(Model.InnerSectorPlan3000)</td></tr>
                </tbody>
            </table>
        </div>

        <h6 class="text-muted text-uppercase fw-semibold mb-2">Dış Tank Gövde</h6>
        <div class="table-responsive">
            <table class="table table-sm table-striped table-bordered align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sektör Genişliği</th>
                        <th>Parça Adedi</th>
                        <th>Sac Açınımı</th>
                        <th>Kaynak Metrajı</th>
                        <th>Kesim Listesi</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>1500 mm</td><td>@GetPieceCount(Model.OuterSectorPlan1500) adet</td><td>@Model.OuterDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td><td>@Model.WeldLength1500.ToString("0.##", CultureInfo.InvariantCulture) m</td><td>@FormatCutList(Model.OuterSectorPlan1500)</td></tr>
                    <tr><td>2000 mm</td><td>@GetPieceCount(Model.OuterSectorPlan2000) adet</td><td>@Model.OuterDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td><td>@Model.WeldLength2000.ToString("0.##", CultureInfo.InvariantCulture) m</td><td>@FormatCutList(Model.OuterSectorPlan2000)</td></tr>
                    <tr><td>2500 mm</td><td>@GetPieceCount(Model.OuterSectorPlan2500) adet</td><td>@Model.OuterDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td><td>@Model.WeldLength2500.ToString("0.##", CultureInfo.InvariantCulture) m</td><td>@FormatCutList(Model.OuterSectorPlan2500)</td></tr>
                    <tr><td>3000 mm</td><td>@GetPieceCount(Model.OuterSectorPlan3000) adet</td><td>@Model.OuterDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td><td>@Model.WeldLength3000.ToString("0.##", CultureInfo.InvariantCulture) m</td><td>@FormatCutList(Model.OuterSectorPlan3000)</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@{
    var costTable = ViewBag.CostTable as MVC.ProductManagement.Application.DTOs.EN13458DTOs.EN13458MaterialCostTableDTO;
}
@if (costTable != null)
{
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-light fw-semibold">Maliyet Grupları</div>
        <div class="card-body">
            <div class="row g-3 mb-3">
                @foreach (var group in costTable.GroupTotals)
                {
                    <div class="col-12 col-md-4">
                        <div class="border rounded p-3 h-100">
                            <div class="small text-muted">@group.CostGroupCode - @group.CostGroupName</div>
                            <div class="fs-5 fw-semibold">@group.TotalCost.ToString("N2")</div>
                        </div>
                    </div>
                }
            </div>

            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle mb-0">
                    <thead>
                    <tr>
                        <th>Grup</th>
                        <th>Kalem</th>
                        <th>Stok Kodu</th>
                        <th>Malzeme</th>
                        <th class="text-end">Miktar</th>
                        <th>Birim</th>
                        <th class="text-end">Birim Fiyat</th>
                        <th class="text-end">Tutar</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var groupItems in costTable.Items.GroupBy(x => new { x.CostGroupCode, x.CostGroupName }))
                    {
                        <tr class="table-primary">
                            <td colspan="8" class="fw-semibold">@groupItems.Key.CostGroupCode - @groupItems.Key.CostGroupName | Grup Toplamı: @groupItems.Sum(x => x.ItemCost).ToString("N2")</td>
                        </tr>

                        @foreach (var item in groupItems)
                        {
                            <tr>
                                <td>@item.CostGroupCode</td>
                                <td>@item.ItemName</td>
                                <td>@item.StockCode</td>
                                <td>@item.MaterialName</td>
                                <td class="text-end">@item.Quantity.ToString("N2")</td>
                                <td>@item.Unit</td>
                                <td class="text-end">@item.UnitPrice.ToString("N2")</td>
                                <td class="text-end fw-semibold">@item.ItemCost.ToString("N2")</td>
                            </tr>
                        }
                    }
                    </tbody>
                    <tfoot>
                    <tr>
                        <th colspan="7" class="text-end">Genel Toplam</th>
                        <th class="text-end">@costTable.GrandTotalCost.ToString("N2")</th>
                    </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}


<div class="mt-4 mb-5 pb-4 p-3 border rounded bg-light d-flex flex-wrap gap-2 justify-content-end">
    <a asp-action="ExportDetailExcel" asp-route-id="@Model.Id" class="btn btn-success px-4">
        <i class="bi bi-file-earmark-excel me-1"></i>Excel Çıktı
    </a>
    <a asp-action="Index" class="btn btn-secondary px-4">
        <i class="bi bi-arrow-left-circle me-1"></i>Listeye Dön
    </a>
    <a asp-action="Calculate" class="btn btn-primary px-4">
        <i class="bi bi-plus-circle me-1"></i>Yeni Hesap
    </a>
</div>


@functions {
    private static int GetPieceCount(string? cutList)
    {
        if (string.IsNullOrWhiteSpace(cutList)) return 0;
        return cutList.Split(" + ", StringSplitOptions.RemoveEmptyEntries).Length;
    }

    private static string FormatCutList(string? cutList)
    {
        if (string.IsNullOrWhiteSpace(cutList))
        {
            return "-";
        }

        var grouped = cutList
            .Split(" + ", StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .GroupBy(x => x)
            .Select(x => $"{x.Count()} adet {x.Key.Replace(" x ", "x")}");

        return string.Join(" + ", grouped);
    }
}
