@model MVC.ProductManagement.Presentation.Areas.Admin.Models.EN13458CalculationVMs.EN13458DetailsVM
@using System.Globalization
@{
    ViewData["Title"] = "EN13458 Details";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="mb-0">EN13458 Detay</h2>
    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-2">Kayıt detayı</span>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light fw-semibold">Giriş Verileri</div>
    <div class="card-body">
        <div class="row g-3 row-cols-1 row-cols-md-2 row-cols-xl-4">
            <div class="col">
                <div class="border rounded p-3 h-100 bg-body-tertiary">
                    <div class="small text-muted mb-1">Ad</div>
                    <div class="fw-semibold">@Model.Name</div>
                </div>
            </div>
            <div class="col">
                <div class="border rounded p-3 h-100 bg-body-tertiary">
                    <div class="small text-muted mb-1">İç Tank Çapı</div>
                    <div class="fw-semibold">@Model.OuterDiameter</div>
                </div>
            </div>
            <div class="col">
                <div class="border rounded p-3 h-100 bg-body-tertiary">
                    <div class="small text-muted mb-1">Dış Tank Çapı</div>
                    <div class="fw-semibold">@Model.OuterTankDiameter</div>
                </div>
            </div>
            <div class="col">
                <div class="border rounded p-3 h-100 bg-body-tertiary">
                    <div class="small text-muted mb-1">Silindirik Boy</div>
                    <div class="fw-semibold">@Model.ShellLength</div>
                </div>
            </div>
            <div class="col">
                <div class="border rounded p-3 h-100 bg-body-tertiary">
                    <div class="small text-muted mb-1">Basınç</div>
                    <div class="fw-semibold">@Model.Pressure</div>
                </div>
            </div>
            <div class="col">
                <div class="border rounded p-3 h-100 bg-body-tertiary">
                    <div class="small text-muted mb-1">Depolanacak Ürün</div>
                    <div class="fw-semibold">@Model.StorageTypeName</div>
                </div>
            </div>
            <div class="col">
                <div class="border rounded p-3 h-100 bg-body-tertiary">
                    <div class="small text-muted mb-1">Sıvı Yoğunluğu</div>
                    <div class="fw-semibold">@Model.LiquidDensity</div>
                </div>
            </div>
            <div class="col">
                <div class="border rounded p-3 h-100 bg-body-tertiary">
                    <div class="small text-muted mb-1">Kaynak Boyları</div>
                    <div class="fw-semibold">1500: @Model.WeldLength1500 | 2000: @Model.WeldLength2000 | 2500: @Model.WeldLength2500 | 3000: @Model.WeldLength3000</div>
                </div>
            </div>
            <div class="col">
                <div class="border rounded p-3 h-100 bg-body-tertiary">
                    <div class="small text-muted mb-1">Tank Yönelimi</div>
                    <div class="fw-semibold">@Model.TankOrientation</div>
                </div>
            </div>
            <div class="col">
                <div class="border rounded p-3 h-100 bg-body-tertiary">
                    <div class="small text-muted mb-1">Cold Stretch</div>
                    <div class="fw-semibold">@(Model.IsColdStretchApplied ? "Evet" : "Hayır")</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-xxl-6">
        <div class="card shadow-sm h-100 border-primary-subtle">
            <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold">İç Tank</div>
            <div class="card-body">
                <h6 class="text-muted text-uppercase fw-semibold mb-2">Malzeme</h6>
                <table class="table table-sm table-striped align-middle mb-3">
                    <tbody>
                    <tr><th class="w-50">Gövde Malzemesi</th><td>@Model.InnerShellMaterialName</td></tr>
                    <tr><th>Gövde Malzeme Formu</th><td>@Model.InnerShellMaterialFormName</td></tr>
                    <tr><th>Bombe Malzemesi</th><td>@Model.InnerHeadMaterialName</td></tr>
                    <tr><th>Bombe Malzeme Formu</th><td>@Model.InnerHeadMaterialFormName</td></tr>
                    <tr><th>Gövde Akma Dayanımı (MPa)</th><td>@Model.InnerShellMaterialStrength</td></tr>
                    <tr><th>Bombe Akma Dayanımı (MPa)</th><td>@Model.InnerHeadMaterialStrength</td></tr>
                    </tbody>
                </table>

                <h6 class="text-muted text-uppercase fw-semibold mb-2">Kalınlık ve Uzunluk</h6>
                <table class="table table-sm table-striped align-middle mb-3">
                    <tbody>
                    <tr><th class="w-50">Gövde Kalınlığı</th><td>@Model.InnerShellThickness</td></tr>
                    <tr><th>Bombe Kalınlığı</th><td>@Model.InnerHeadThickness</td></tr>
                    <tr><th>Yuvarlanmış Gövde Kalınlığı</th><td>@Model.RoundedInnerShellThickness</td></tr>
                    <tr><th>Yuvarlanmış Bombe Kalınlığı</th><td>@Model.RoundedInnerHeadThickness</td></tr>
                    <tr><th>Bombe Pulu Çapı</th><td>@Model.InnerTankHeadPulDiameter</td></tr>
                    <tr><th>Toplam Uzunluk</th><td>@Model.InnerTankTotalLength</td></tr>
                    </tbody>
                </table>

                <h6 class="text-muted text-uppercase fw-semibold mb-2">Kaynak, Hacim ve Ağırlık</h6>
                <table class="table table-sm table-striped align-middle mb-0">
                    <tbody>
                    <tr><th class="w-50">Bombe Kaynak Uzunluğu</th><td>@Model.InnerTankHeadWeldLength</td></tr>
                    <tr><th>Çevre Kaynak Uzunluğu</th><td>@Model.InnerTankCircumferenceWeldLength</td></tr>
                    <tr><th>İç Hacim</th><td>@Model.InnerVolume</td></tr>
                    <tr><th>İç Yüzey Alanı</th><td>@Model.InnerSurfaceArea</td></tr>
                    <tr><th>Bombe Ağırlığı</th><td>@Model.InnerTankHeadWeight</td></tr>
                    <tr><th>Tank Ağırlığı</th><td>@Model.InnerTankWeight</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12 col-xxl-6">
        <div class="card shadow-sm h-100 border-secondary-subtle">
            <div class="card-header bg-secondary-subtle text-secondary-emphasis fw-semibold">Dış Tank</div>
            <div class="card-body">
                <h6 class="text-muted text-uppercase fw-semibold mb-2">Malzeme</h6>
                <table class="table table-sm table-striped align-middle mb-3">
                    <tbody>
                    <tr><th class="w-50">Gövde Malzemesi</th><td>@Model.OuterShellMaterialName</td></tr>
                    <tr><th>Gövde Malzeme Formu</th><td>@Model.OuterShellMaterialFormName</td></tr>
                    <tr><th>Bombe Malzemesi</th><td>@Model.OuterHeadMaterialName</td></tr>
                    <tr><th>Bombe Malzeme Formu</th><td>@Model.OuterHeadMaterialFormName</td></tr>
                    <tr><th>Gövde Akma Dayanımı (MPa)</th><td>@Model.OuterShellMaterialStrength</td></tr>
                    <tr><th>Bombe Akma Dayanımı (MPa)</th><td>@Model.OuterHeadMaterialStrength</td></tr>
                    </tbody>
                </table>

                <h6 class="text-muted text-uppercase fw-semibold mb-2">Kalınlık ve Uzunluk</h6>
                <table class="table table-sm table-striped align-middle mb-3">
                    <tbody>
                    <tr><th class="w-50">Gövde Kalınlığı</th><td>@Model.OuterShellThickness</td></tr>
                    <tr><th>Bombe Kalınlığı</th><td>@Model.OuterHeadThickness</td></tr>
                    <tr><th>Yuvarlanmış Gövde Kalınlığı</th><td>@Model.RoundedOuterShellThickness</td></tr>
                    <tr><th>Yuvarlanmış Bombe Kalınlığı</th><td>@Model.RoundedOuterHeadThickness</td></tr>
                    <tr><th>Bombe Pulu Çapı</th><td>@Model.OuterTankHeadPulDiameter</td></tr>
                    <tr><th>Toplam Uzunluk</th><td>@Model.OuterTankTotalLength</td></tr>
                    </tbody>
                </table>

                <h6 class="text-muted text-uppercase fw-semibold mb-2">Kaynak, Hacim ve Ağırlık</h6>
                <table class="table table-sm table-striped align-middle mb-0">
                    <tbody>
                    <tr><th class="w-50">Bombe Kaynak Uzunluğu</th><td>@Model.OuterTankHeadWeldLength</td></tr>
                    <tr><th>Çevre Kaynak Uzunluğu</th><td>@Model.OuterTankCircumferenceWeldLength</td></tr>
                    <tr><th>Dış Hacim</th><td>@Model.OuterVolume</td></tr>
                    <tr><th>Dış Yüzey Alanı</th><td>@Model.OuterSurfaceArea</td></tr>
                    <tr><th>Bombe Ağırlığı</th><td>@Model.OuterTankHeadWeight</td></tr>
                    <tr><th>Tank Ağırlığı</th><td>@Model.OuterTankWeight</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mt-4">
    <div class="card-header bg-light fw-semibold">Dış Tank Harici Basınç Sonuçları</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-sm align-middle mb-0">
                <tbody>
                <tr><th class="w-50">Etkin Et Kalınlığı t</th><td>@Model.EffectiveOuterThickness</td></tr>
                <tr><th>Da/t</th><td>@Model.DOverT</td></tr>
                <tr><th>lb/Da</th><td>@Model.LOverD</td></tr>
                <tr><th>Da/lb</th><td>@Model.DaOverLb</td></tr>
                <tr><th>pe (Elastik Burkulma)</th><td>@Model.ElasticBucklingPressure</td></tr>
                <tr><th>pp (Plastik Deformasyon)</th><td>@Model.PlasticDeformationPressure</td></tr>
                <tr><th>p_allow</th><td>@Model.AllowableExternalPressure</td></tr>
                <tr><th>p_design</th><td>@Model.ExternalDesignPressure</td></tr>
                <tr><th>Stiffener Malzemesi</th><td>@Model.StiffenerMaterialName</td></tr>
                <tr><th>Stiffener Formu</th><td>@Model.StiffenerMaterialFormName</td></tr>
                <tr><th>Stiffener Manuel Giriş</th><td>@(Model.UseManualStiffenerValues ? "Evet" : "Hayır")</td></tr>
                <tr><th>I (kullanılan)</th><td>@Model.StiffenerInertia</td></tr>
                <tr><th>A (kullanılan)</th><td>@Model.StiffenerArea</td></tr>
                <tr><th>I (gereken)</th><td>@Model.RequiredStiffenerInertia</td></tr>
                <tr><th>A (gereken)</th><td>@Model.RequiredStiffenerArea</td></tr>
                <tr><th>I Kontrol</th><td>@(Model.StiffenerInertiaOk.HasValue ? (Model.StiffenerInertiaOk.Value ? "Geçti" : "Kaldı") : "N/A")</td></tr>
                <tr><th>A Kontrol</th><td>@(Model.StiffenerAreaOk.HasValue ? (Model.StiffenerAreaOk.Value ? "Geçti" : "Kaldı") : "N/A")</td></tr>
                <tr><th>ν (sabit)</th><td>@Model.FixedPoissonRatio</td></tr>
                <tr><th>u (%) (sabit)</th><td>@Model.FixedOutOfRoundnessPercent</td></tr>
                <tr><th>welding u (sabit)</th><td>@Model.FixedWeldCoefficient</td></tr>
                <tr><th>Uygunluk</th><td>@(Model.ExternalPressureDesignOk ? "Uygun" : "Uygun Değil")</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card shadow-sm mt-4">
    <div class="card-header bg-light fw-semibold">Dış Tank Harici Basınç Kuralları</div>
    <div class="card-body">
        <ul class="mb-0">
            <li><code>p_allow = min(pe, pp)</code></li>
            <li>Kontrol: <code>p_allow &gt;= p_atm (0.1 MPa)</code></li>
            <li>Stiffener varsa I/A koşulları ayrıca sağlanmalıdır.</li>
        </ul>
    </div>
</div>

<div class="card shadow-sm mt-4">
    <div class="card-header bg-light fw-semibold">Ortak Sonuçlar</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-sm align-middle mb-0">
                <tbody>
                <tr><th class="w-50">Design Pressure</th><td>@Model.DesignPressure</td></tr>
                <tr><th>Test Pressure</th><td>@Model.TestPressure</td></tr>
                <tr><th>Static Pressure</th><td>@Model.StaticPressure</td></tr>
                <tr><th>Toplam Kaynak Uzunluğu</th><td>@Model.TotalWeldLength</td></tr>
                <tr><th>Perlit Hacmi</th><td>@Model.PerliteVolume</td></tr>
                <tr><th>Perlit Ağırlığı (kg)</th><td>@Model.PerliteWeight</td></tr>
                <tr><th>Gaz Azot Hacmi</th><td>@Model.GasNitrogenVolume</td></tr>
                <tr><th>Sıvı Azot Hacmi</th><td>@Model.LiquidNitrogenVolume</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>


<div class="card shadow-sm mt-4">
    <div class="card-header bg-light fw-semibold">Sac Oryantasyonu (Sektör Bazlı)</div>
    <div class="card-body">
        <p class="text-muted mb-2">Format: <strong>Et (mm) x Sektör Genişliği (mm) x Sac Açınımı (mm)</strong></p>

        <h6 class="text-muted text-uppercase fw-semibold mb-2">İç Tank Gövde</h6>
        <div class="table-responsive mb-3">
            <table class="table table-sm table-striped table-bordered align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sektör Genişliği</th>
                        <th>Parça Adedi</th>
                        <th>Sac Açınımı</th>
                        <th>Kesim Listesi</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>1500 mm</td><td>@GetPieceCount(Model.InnerSectorPlan1500) adet</td><td>@Model.InnerDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td><td>@Model.InnerSectorPlan1500</td></tr>
                    <tr><td>2000 mm</td><td>@GetPieceCount(Model.InnerSectorPlan2000) adet</td><td>@Model.InnerDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td><td>@Model.InnerSectorPlan2000</td></tr>
                    <tr><td>2500 mm</td><td>@GetPieceCount(Model.InnerSectorPlan2500) adet</td><td>@Model.InnerDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td><td>@Model.InnerSectorPlan2500</td></tr>
                    <tr><td>3000 mm</td><td>@GetPieceCount(Model.InnerSectorPlan3000) adet</td><td>@Model.InnerDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td><td>@Model.InnerSectorPlan3000</td></tr>
                </tbody>
            </table>
        </div>

        <h6 class="text-muted text-uppercase fw-semibold mb-2">Dış Tank Gövde</h6>
        <div class="table-responsive">
            <table class="table table-sm table-striped table-bordered align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sektör Genişliği</th>
                        <th>Parça Adedi</th>
                        <th>Sac Açınımı</th>
                        <th>Kesim Listesi</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>1500 mm</td><td>@GetPieceCount(Model.OuterSectorPlan1500) adet</td><td>@Model.OuterDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td><td>@Model.OuterSectorPlan1500</td></tr>
                    <tr><td>2000 mm</td><td>@GetPieceCount(Model.OuterSectorPlan2000) adet</td><td>@Model.OuterDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td><td>@Model.OuterSectorPlan2000</td></tr>
                    <tr><td>2500 mm</td><td>@GetPieceCount(Model.OuterSectorPlan2500) adet</td><td>@Model.OuterDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td><td>@Model.OuterSectorPlan2500</td></tr>
                    <tr><td>3000 mm</td><td>@GetPieceCount(Model.OuterSectorPlan3000) adet</td><td>@Model.OuterDevelopedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td><td>@Model.OuterSectorPlan3000</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-4 mb-5 pb-4 p-3 border rounded bg-light d-flex flex-wrap gap-2 justify-content-end">
    <a asp-action="Index" class="btn btn-secondary px-4">
        <i class="bi bi-arrow-left-circle me-1"></i>Listeye Dön
    </a>
    <a asp-action="Calculate" class="btn btn-primary px-4">
        <i class="bi bi-plus-circle me-1"></i>Yeni Hesap
    </a>
</div>


@functions {
    private static int GetPieceCount(string? cutList)
    {
        if (string.IsNullOrWhiteSpace(cutList)) return 0;
        return cutList.Split(" + ", StringSplitOptions.RemoveEmptyEntries).Length;
    }
}
