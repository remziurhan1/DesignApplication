@model MVC.ProductManagement.Presentation.Areas.Admin.Models.EN13458CalculationVMs.EN13458DetailsVM
@{
    ViewData["Title"] = "EN13458 Details";
}

<h2>EN13458 Detay</h2>

<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <tr><th>ID</th><td>@Model.Id</td></tr>
        <tr><th>Ad</th><td>@Model.Name</td></tr>
        <tr><th>OuterDiameter / ShellLength</th><td>@Model.OuterDiameter / @Model.ShellLength</td></tr>
        <tr><th>Design/Test/Static Pressure</th><td>@Model.DesignPressure / @Model.TestPressure / @Model.StaticPressure</td></tr>
        <tr><th>Kalınlıklar</th><td>@Model.RoundedInnerShellThickness / @Model.RoundedInnerHeadThickness / @Model.RoundedOuterShellThickness / @Model.RoundedOuterHeadThickness</td></tr>
        <tr><th>Inner-Outer Volume</th><td>@Model.InnerVolume / @Model.OuterVolume</td></tr>
        <tr><th>Inner-Outer Weight</th><td>@Model.InnerTankWeight / @Model.OuterTankWeight</td></tr>
        <tr><th>Film Cost</th><td>@Model.TotalFilmCost</td></tr>
    </table>
</div>

<a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
<a asp-action="Calculate" class="btn btn-primary">Yeni Hesap</a>
