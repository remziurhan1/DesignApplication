@model List<MVC.ProductManagement.Presentation.Areas.Admin.Models.StockCodes.SA.Properties.SaStockCodePropertyListVm>

<h2>SA Stock Code Properties</h2>
<a asp-action="Create" class="btn btn-primary">Yeni Kural</a>
<table class="table mt-3">
    <thead>
    <tr>
        <th>Ürün</th>
        <th>Feature</th>
        <th>Sabit</th>
        <th>Sabit Değer</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ProductCode - @item.ProductName</td>
            <td>@item.FeatureCode - @item.FeatureName</td>
            <td>@item.IsFixed</td>
            <td>@item.FixedValueCode - @item.FixedValueName</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                <form asp-action="Delete" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@item.Id" />
                    <button class="btn btn-sm btn-danger" type="submit">Sil</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
