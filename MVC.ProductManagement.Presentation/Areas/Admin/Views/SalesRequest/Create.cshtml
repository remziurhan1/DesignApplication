@using Microsoft.AspNetCore.Mvc.Rendering
@using MVC.ProductManagement.Domain.Enums
@model MVC.ProductManagement.Presentation.Areas.Admin.Models.SalesRequestVMs.SalesRequestCreateVm
@{
    var isEdit = ViewBag.IsEdit is true;
    var currentArea = (ViewContext.RouteData.Values["area"]?.ToString() ?? "Admin");
    ViewData["Title"] = isEdit ? "Satış Talebi Güncelle" : "Yeni Satış Talebi";
}

<div class="pagetitle d-flex justify-content-between align-items-center">
    <div>
        <h1>@(isEdit ? "Satış Talebi Güncelle" : "Yeni Satış Talebi")</h1>
        <p class="text-muted mb-0">Satışçı, müşteri ve minimum teknik bilgileri girerek bir veya birden fazla talep satırı oluşturabilir.</p>
    </div>
    <a asp-area="@currentArea" asp-controller="Customer" asp-action="Create" class="btn btn-outline-primary">Müşteri ekle</a>
</div>

<section class="section mt-4">
    <div class="card">
        <div class="card-body pt-4">
            <form method="post" enctype="multipart/form-data" asp-area="@currentArea" asp-controller="SalesRequest" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : null)">
                @Html.AntiForgeryToken()
                @if (isEdit)
                {
                    <input asp-for="Id" type="hidden" />
                }
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="CustomerId" class="form-label"></label>
                        <select asp-for="CustomerId" asp-items="Model.Customers" class="form-select">
                            <option value="">Müşteri seçin</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="RequestedByName" class="form-label"></label>
                        <input asp-for="RequestedByName" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="RequestedByDepartment" class="form-label"></label>
                        <input asp-for="RequestedByDepartment" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="RequestedByEmail" class="form-label"></label>
                        <input asp-for="RequestedByEmail" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="NeededByDate" class="form-label"></label>
                        <input asp-for="NeededByDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="RequestSource" class="form-label"></label>
                        <select asp-for="RequestSource" asp-items="Html.GetEnumSelectList<SalesRequestSource>()" class="form-select"></select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="ShipmentCountry" class="form-label"></label>
                        <input asp-for="ShipmentCountry" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="InstallationCountry" class="form-label"></label>
                        <input asp-for="InstallationCountry" class="form-control" />
                    </div>
                    <div class="col-md-3 form-check ms-2 mt-4">
                        <input asp-for="IsTransportByCustomer" class="form-check-input" />
                        <label asp-for="IsTransportByCustomer" class="form-check-label"></label>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Attachments" class="form-label"></label>
                        <input asp-for="Attachments" type="file" class="form-control" multiple accept=".pdf,.xls,.xlsx,.doc,.docx,.msg,.eml,.png,.jpg,.jpeg" />
                        <small class="text-muted">Mail, PDF, Excel ve Word eklerini aynı talep içine yükleyebilirsiniz.</small>
                    </div>
                    <div class="col-12">
                        <label asp-for="SummaryNotes" class="form-label"></label>
                        <textarea asp-for="SummaryNotes" class="form-control" rows="3"></textarea>
                    </div>
                </div>

                <hr class="my-4" />
                <h5>Talep Satırları</h5>
                <div class="text-muted small mb-3">İlk satır ana talep olur. Gerekirse aynı talebin altında farklı satırlar açabilirsiniz.</div>

                <div id="request-items">
                @for (var i = 0; i < Model.Items.Count; i++)
                {
                    <div class="border rounded p-3 mb-3 request-item">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Talep grubu</label>
                                <select asp-for="Items[i].RequestCategory" asp-items="Html.GetEnumSelectList<SalesRequestCategory>()" class="form-select request-category"></select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Akışkan grubu</label>
                                <select asp-for="Items[i].ProductGroupId" asp-items="Model.ProductGroups" class="form-select"><option value="">Seçin</option></select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Ürün</label>
                                <input asp-for="Items[i].ProductCode" class="form-control" placeholder="LIN/LOX/LAR/LNG" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Kapasite (m³)</label>
                                <input asp-for="Items[i].CapacityM3" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Tank tipi</label>
                                <select asp-for="Items[i].TankOrientation" asp-items="Html.GetEnumSelectList<RequestTankOrientation>()" class="form-select"></select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Kurulum</label>
                                <select asp-for="Items[i].PlacementType" asp-items="Html.GetEnumSelectList<PlacementType>()" class="form-select"></select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Dizayn standardı</label>
                                <input asp-for="Items[i].DesignStandardCode" class="form-control" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Dizayn basıncı</label>
                                <input asp-for="Items[i].DesignPressureBar" class="form-control" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Min sıcaklık</label>
                                <input asp-for="Items[i].DesignTemperatureMin" class="form-control" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Max sıcaklık</label>
                                <input asp-for="Items[i].DesignTemperatureMax" class="form-control" />
                            </div>
                            <div class="col-md-2 tank-fields">
                                <label class="form-label">Tank tipi</label>
                                <select asp-for="Items[i].TankType" asp-items="Html.GetEnumSelectList<RequestTankType>()" class="form-select tank-type"></select>
                            </div>
                            <div class="col-md-2 tank-fields">
                                <label class="form-label">Depolama tipi</label>
                                <select asp-for="Items[i].StorageOption" asp-items="Html.GetEnumSelectList<RequestStorageOption>()" class="form-select storage-option"></select>
                            </div>
                            <div class="col-md-2 tank-fields">
                                <label class="form-label">Transport tipi</label>
                                <select asp-for="Items[i].TransportOption" asp-items="Html.GetEnumSelectList<RequestTransportOption>()" class="form-select transport-option"></select>
                            </div>
                            <div class="col-md-2 tank-fields">
                                <label class="form-label">STD/OPS/SPC</label>
                                <select asp-for="Items[i].StdOpsSelection" asp-items="Html.GetEnumSelectList<RequestStdOpsSelection>()" class="form-select std-ops"></select>
                            </div>
                            <div class="col-md-4 tank-fields spc-details">
                                <label class="form-label">SPC teknik bilgileri</label>
                                <input asp-for="Items[i].SpcTechnicalDetails" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Tüketim kapasitesi</label>
                                <input asp-for="Items[i].ConsumptionCapacity" class="form-control" />
                                <small class="text-muted">Tank altı buharlaştırıcı hesabı için referans veri.</small>
                            </div>
                            <div class="col-md-3 form-check ms-2 mt-4">
                                <input asp-for="Items[i].HasTankConsumptionCapacity" class="form-check-input" />
                                <label asp-for="Items[i].HasTankConsumptionCapacity" class="form-check-label"></label>
                            </div>
                            <div class="col-md-2 evap-fields">
                                <label class="form-label">Ortam min</label>
                                <input asp-for="Items[i].AmbientTemperatureMin" class="form-control" />
                            </div>
                            <div class="col-md-2 evap-fields">
                                <label class="form-label">Ortam max</label>
                                <input asp-for="Items[i].AmbientTemperatureMax" class="form-control" />
                            </div>
                            <div class="col-md-4 facility-fields">
                                <label class="form-label">Tesis tipi</label>
                                <input asp-for="Items[i].FacilityType" class="form-control" />
                            </div>
                            <div class="col-md-2 facility-fields">
                                <label class="form-label">Giriş P</label>
                                <input asp-for="Items[i].FacilityInletPressureBar" class="form-control" />
                            </div>
                            <div class="col-md-2 facility-fields">
                                <label class="form-label">Çıkış P</label>
                                <input asp-for="Items[i].FacilityOutletPressureBar" class="form-control" />
                            </div>
                            <div class="col-md-2 facility-fields">
                                <label class="form-label">Giriş T</label>
                                <input asp-for="Items[i].FacilityInletTemperature" class="form-control" />
                            </div>
                            <div class="col-md-2 facility-fields">
                                <label class="form-label">Çıkış T</label>
                                <input asp-for="Items[i].FacilityOutletTemperature" class="form-control" />
                            </div>
                            <div class="col-md-2 facility-fields">
                                <label class="form-label">Tesis Nm3/h</label>
                                <input asp-for="Items[i].FacilityCapacityNm3h" class="form-control" />
                            </div>
                            <div class="col-md-3 form-check ms-2 mt-4 facility-fields">
                                <input asp-for="Items[i].HasPump" class="form-check-input" />
                                <label asp-for="Items[i].HasPump" class="form-check-label"></label>
                            </div>
                            <div class="col-md-3 facility-fields">
                                <label class="form-label">Pompa detay</label>
                                <input asp-for="Items[i].PumpDetails" class="form-control" />
                            </div>
                            <div class="col-md-3 form-check ms-2 mt-4 facility-fields">
                                <input asp-for="Items[i].HasElectricHeater" class="form-check-input" />
                                <label asp-for="Items[i].HasElectricHeater" class="form-check-label"></label>
                            </div>
                            <div class="col-md-3 facility-fields">
                                <label class="form-label">Isıtıcı detay</label>
                                <input asp-for="Items[i].ElectricHeaterDetails" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Ek sorular/cevaplar (JSON)</label>
                                <textarea asp-for="Items[i].AdditionalQuestionsJson" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Minimum teknik bilgiler</label>
                                <textarea asp-for="Items[i].MinimumTechnicalNotes" class="form-control" rows="2" placeholder="Basınç, standart, vana isteği, özel saha şartı vb."></textarea>
                            </div>
                        </div>
                    </div>
                }
                </div>

                <button type="button" class="btn btn-outline-secondary" id="add-item">+ Satır ekle</button>
                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">@(isEdit ? "Talebi güncelle" : "Talebi oluştur")</button>
                    <a asp-area="@currentArea" asp-controller="SalesRequest" asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
    <script>
        const categoryTank = '@((int)SalesRequestCategory.Tank)';
        const categoryEvap = '@((int)SalesRequestCategory.Evaporator)';
        const categoryFacility = '@((int)SalesRequestCategory.Facility)';
        const tankTypeStorage = '@((int)RequestTankType.Storage)';

        const productOptions = `@Html.Raw(string.Join("", Model.ProductGroups.Select(x => $"<option value=\"{x.Value}\">{x.Text}</option>")))`;
        const orientationOptions = `@Html.Raw(string.Join("", Html.GetEnumSelectList<RequestTankOrientation>().Select(x => $"<option value=\"{x.Value}\">{x.Text}</option>")))`;
        const placementOptions = `@Html.Raw(string.Join("", Html.GetEnumSelectList<PlacementType>().Select(x => $"<option value=\"{x.Value}\">{x.Text}</option>")))`;
        const categoryOptions = `@Html.Raw(string.Join("", Html.GetEnumSelectList<SalesRequestCategory>().Select(x => $"<option value=\"{x.Value}\">{x.Text}</option>")))`;
        const tankTypeOptions = `@Html.Raw(string.Join("", Html.GetEnumSelectList<RequestTankType>().Select(x => $"<option value=\"{x.Value}\">{x.Text}</option>")))`;
        const storageOptions = `@Html.Raw(string.Join("", Html.GetEnumSelectList<RequestStorageOption>().Select(x => $"<option value=\"{x.Value}\">{x.Text}</option>")))`;
        const transportOptions = `@Html.Raw(string.Join("", Html.GetEnumSelectList<RequestTransportOption>().Select(x => $"<option value=\"{x.Value}\">{x.Text}</option>")))`;
        const stdOpsOptions = `@Html.Raw(string.Join("", Html.GetEnumSelectList<RequestStdOpsSelection>().Select(x => $"<option value=\"{x.Value}\">{x.Text}</option>")))`;
        function toggleCategoryFields(item) {
            const categoryValue = item.querySelector('.request-category')?.value;
            const showTank = categoryValue === categoryTank;
            const showEvap = categoryValue === categoryEvap;
            const showFacility = categoryValue === categoryFacility;

            item.querySelectorAll('.tank-fields').forEach(x => x.style.display = showTank ? '' : 'none');
            item.querySelectorAll('.evap-fields').forEach(x => x.style.display = showEvap ? '' : 'none');
            item.querySelectorAll('.facility-fields').forEach(x => x.style.display = showFacility ? '' : 'none');

            toggleTankTypeFields(item);
        }

        function toggleTankTypeFields(item) {
            const tankType = item.querySelector('.tank-type');
            const storage = item.querySelector('.storage-option');
            const transport = item.querySelector('.transport-option');
            if (!tankType || !storage || !transport) return;

            if (tankType.value === tankTypeStorage) {
                transport.value = '';
                transport.disabled = true;
                storage.disabled = false;
            } else if (tankType.value) {
                storage.value = '';
                storage.disabled = true;
                transport.disabled = false;
            } else {
                storage.disabled = false;
                transport.disabled = false;
            }
        }

        function wireItemEvents(item) {
            const category = item.querySelector('.request-category');
            const tankType = item.querySelector('.tank-type');
            if (category) category.addEventListener('change', () => toggleCategoryFields(item));
            if (tankType) tankType.addEventListener('change', () => toggleTankTypeFields(item));
            toggleCategoryFields(item);
        }

        document.getElementById('add-item').addEventListener('click', function () {
            const container = document.getElementById('request-items');
            const index = container.querySelectorAll('.request-item').length;
            const html = `
                <div class="border rounded p-3 mb-3 request-item">
                    <div class="row g-3">
                        <div class="col-md-4"><label class="form-label">Talep grubu</label><select name="Items[${index}].RequestCategory" class="form-select request-category">${categoryOptions}</select></div>
                        <div class="col-md-4"><label class="form-label">Akışkan grubu</label><select name="Items[${index}].ProductGroupId" class="form-select"><option value="">Seçin</option>${productOptions}</select></div>
                        <div class="col-md-4"><label class="form-label">Ürün</label><input name="Items[${index}].ProductCode" class="form-control" /></div>
                        <div class="col-md-2"><label class="form-label">Kapasite (m³)</label><input name="Items[${index}].CapacityM3" class="form-control" /></div>
                        <div class="col-md-3"><label class="form-label">Tank tipi</label><select name="Items[${index}].TankOrientation" class="form-select">${orientationOptions}</select></div>
                        <div class="col-md-3"><label class="form-label">Kurulum</label><select name="Items[${index}].PlacementType" class="form-select">${placementOptions}</select></div>
                        <div class="col-md-4"><label class="form-label">Dizayn standardı</label><input name="Items[${index}].DesignStandardCode" class="form-control" /></div>
                        <div class="col-md-2"><label class="form-label">Dizayn basıncı</label><input name="Items[${index}].DesignPressureBar" class="form-control" /></div>
                        <div class="col-md-2"><label class="form-label">Min sıcaklık</label><input name="Items[${index}].DesignTemperatureMin" class="form-control" /></div>
                        <div class="col-md-2"><label class="form-label">Max sıcaklık</label><input name="Items[${index}].DesignTemperatureMax" class="form-control" /></div>
                        <div class="col-md-2 tank-fields"><label class="form-label">Tank tipi</label><select name="Items[${index}].TankType" class="form-select tank-type">${tankTypeOptions}</select></div>
                        <div class="col-md-2 tank-fields"><label class="form-label">Depolama</label><select name="Items[${index}].StorageOption" class="form-select storage-option">${storageOptions}</select></div>
                        <div class="col-md-2 tank-fields"><label class="form-label">Transport</label><select name="Items[${index}].TransportOption" class="form-select transport-option">${transportOptions}</select></div>
                        <div class="col-md-2 tank-fields"><label class="form-label">STD/OPS/SPC</label><select name="Items[${index}].StdOpsSelection" class="form-select">${stdOpsOptions}</select></div>
                        <div class="col-md-4 tank-fields"><label class="form-label">SPC teknik bilgileri</label><input name="Items[${index}].SpcTechnicalDetails" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label">Tüketim kapasitesi</label><input name="Items[${index}].ConsumptionCapacity" class="form-control" /></div>
                        <div class="col-md-2 evap-fields"><label class="form-label">Ortam min</label><input name="Items[${index}].AmbientTemperatureMin" class="form-control" /></div>
                        <div class="col-md-2 evap-fields"><label class="form-label">Ortam max</label><input name="Items[${index}].AmbientTemperatureMax" class="form-control" /></div>
                        <div class="col-md-4 facility-fields"><label class="form-label">Tesis tipi</label><input name="Items[${index}].FacilityType" class="form-control" /></div>
                        <div class="col-md-2 facility-fields"><label class="form-label">Giriş P</label><input name="Items[${index}].FacilityInletPressureBar" class="form-control" /></div>
                        <div class="col-md-2 facility-fields"><label class="form-label">Çıkış P</label><input name="Items[${index}].FacilityOutletPressureBar" class="form-control" /></div>
                        <div class="col-md-8"><label class="form-label">Minimum teknik bilgiler</label><textarea name="Items[${index}].MinimumTechnicalNotes" class="form-control" rows="2"></textarea></div>
                    </div>
                </div>`;
            container.insertAdjacentHTML('beforeend', html);
            wireItemEvents(container.lastElementChild);
        });

        document.querySelectorAll('#request-items .request-item').forEach(wireItemEvents);
    </script>
}
