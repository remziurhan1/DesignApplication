                        <div class="col-md-2 flow-l4 non-spare-fields"><label class="form-label">Max sıcaklık</label><input name="Items[${index}].DesignTemperatureMax" class="form-control" /></div>
                        <div class="col-12 tank-fields flow-l3"><div class="border rounded p-3 bg-light-subtle"><h6 class="mb-3">Tank giriş bilgileri</h6><div class="row g-3"><div class="col-md-3"><label class="form-label">Tank tipi</label><select name="Items[${index}].TankType" class="form-select tank-type">${tankTypeOptions}</select></div><div class="col-md-3"><label class="form-label">Depolama</label><select name="Items[${index}].StorageOption" class="form-select storage-option">${storageOptions}</select></div><div class="col-md-3"><label class="form-label">Transport</label><select name="Items[${index}].TransportOption" class="form-select transport-option">${transportOptions}</select></div><div class="col-md-3"><label class="form-label">STD/OPS/SPC</label><select name="Items[${index}].StdOpsSelection" class="form-select">${stdOpsOptions}</select></div><div class="col-12"><label class="form-label">SPC teknik bilgileri</label><input name="Items[${index}].SpcTechnicalDetails" class="form-control" /></div></div></div></div>
