                        <div class="col-md-6 flow-l1 non-spare-fields"><label class="form-label">Ek sorular/cevaplar (JSON)</label><textarea name="Items[${index}].AdditionalQuestionsJson" class="form-control" rows="2"></textarea></div>
                        <div class="col-md-6 flow-l1 non-spare-fields"><label class="form-label">Minimum teknik bilgiler</label><textarea name="Items[${index}].MinimumTechnicalNotes" class="form-control" rows="2"></textarea></div>
                    </div>
                </div>`;
            container.insertAdjacentHTML('beforeend', html);
            wireItemEvents(container.lastElementChild);
        });

        document.querySelectorAll('#request-items .request-item').forEach(wireItemEvents);
