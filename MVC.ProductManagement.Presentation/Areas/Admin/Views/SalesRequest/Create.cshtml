@using Microsoft.AspNetCore.Mvc.Rendering
@using MVC.ProductManagement.Domain.Enums
@model MVC.ProductManagement.Presentation.Areas.Admin.Models.SalesRequestVMs.SalesRequestCreateVm
@{
    var isEdit = ViewBag.IsEdit is true;
    var isRevision = ViewBag.IsRevision is true;
    var currentArea = (ViewContext.RouteData.Values["area"]?.ToString() ?? "Admin");
    var isSalesArea = string.Equals(currentArea, "Sales", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = isEdit ? "Satış Talebi Güncelle" : "Yeni Satış Talebi";
}

<style>
    .request-page {
        background: #f6f8fb;
        border-radius: 1.25rem;
        padding: 1rem;
    }

    .request-hero {
        background: linear-gradient(135deg, #0d6efd 0%, #1f2a44 100%);
        color: #fff;
        border-radius: 1.25rem;
        padding: 1.5rem;
        box-shadow: 0 18px 40px rgba(13, 110, 253, 0.18);
    }

    .request-hero .hero-step {
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.22);
        border-radius: 999px;
        padding: .45rem .8rem;
        font-size: .85rem;
        white-space: nowrap;
    }

    .easy-card {
        border: 1px solid #e5ebf3;
        border-radius: 1.1rem;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.05);
        overflow: hidden;
    }

    .easy-step-head {
        background: #fff;
        border-bottom: 1px solid #edf1f6;
        padding: 1rem 1.25rem;
    }

    .step-number {
        width: 2.35rem;
        height: 2.35rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #0d6efd;
        color: #fff;
        font-weight: 800;
        flex: 0 0 auto;
    }

    .helper-box {
        background: #eef6ff;
        border: 1px solid #cfe7ff;
        border-radius: .9rem;
        padding: .85rem 1rem;
    }

    .request-item {
        border: 1px solid #dfe6f1 !important;
        border-radius: 1rem !important;
        background-color: #fff;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.04);
    }

    .request-item-head {
        background: #f7faff;
        border: 1px solid #d9e8ff;
        border-radius: .85rem;
        padding: .75rem .95rem;
        margin-bottom: 1rem;
    }

    .mini-section {
        border: 1px solid #edf1f6;
        border-radius: .9rem;
        padding: 1rem;
        background: #fbfcfe;
    }

    .mini-section-title {
        font-weight: 700;
        color: #1f2a44;
        margin-bottom: .75rem;
    }

    .field-hint {
        color: #6c757d;
        font-size: .82rem;
    }

    .sticky-actions {
        position: sticky;
        bottom: 0;
        background: rgba(255, 255, 255, 0.94);
        border-top: 1px solid #e9eef5;
        padding: 1rem 0 0;
        backdrop-filter: blur(6px);
        z-index: 5;
    }
</style>

<div class="pagetitle d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <h1>@(isEdit ? "Satış Talebi Güncelle" : "Yeni Satış Talebi")</h1>
        <p class="text-muted mb-0">Form en kolay sıraya alındı: önce müşteri, sonra tarih/teslimat, en son teknik ihtiyaç.</p>
    </div>
    <a asp-area="@currentArea" asp-controller="Customer" asp-action="Create" class="btn btn-outline-primary">Müşteri ekle</a>
</div>

<section class="section mt-4 request-page">
    <div class="request-hero mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <h4 class="mb-2">Adım adım talep oluştur</h4>
                <p class="mb-0 opacity-75">Zor alanlar kategori seçimine göre otomatik açılır. Emin olmadığın teknik detayları “Minimum teknik bilgiler” alanına yazman yeterli.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <span class="hero-step">1. Kim için?</span>
                <span class="hero-step">2. Ne zaman?</span>
                <span class="hero-step">3. Nereye?</span>
                <span class="hero-step">4. Ne isteniyor?</span>
                <span class="hero-step">5. Kontrol et</span>
            </div>
        </div>
    </div>

    <form method="post" enctype="multipart/form-data" asp-area="@currentArea" asp-controller="SalesRequest" asp-action="@(isRevision ? "Revise" : isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : null)">
        @Html.AntiForgeryToken()
        @if (isEdit)
        {
            <input asp-for="Id" type="hidden" />
        }
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="card easy-card mb-4">
            <div class="easy-step-head d-flex gap-3 align-items-start">
                <span class="step-number">1</span>
                <div>
                    <h5 class="mb-1">Müşteriyi ve talebi açan kişiyi seç</h5>
                    <div class="text-muted small">Satışçı bilgileri otomatik gelir; sadece müşteriyi seçmen yeterli.</div>
                </div>
            </div>
            <div class="card-body">
                <div class="helper-box mb-3 small">Yeni müşteri listede yoksa sağ üstteki <strong>Müşteri ekle</strong> butonuyla önce müşteri kartını oluştur.</div>
                <div class="row g-3">
                    <div class="col-lg-4">
                        <label asp-for="CustomerId" class="form-label"></label>
                        <select asp-for="CustomerId" asp-items="Model.Customers" class="form-select form-select-lg">
                            <option value="">Müşteri seçin</option>
                        </select>
                    </div>
                    <div class="col-lg-3">
                        <label asp-for="RequestedByName" class="form-label"></label>
                        <input asp-for="RequestedByName" class="form-control" readonly />
                    </div>
                    <div class="col-lg-2">
                        <label asp-for="RequestedByDepartment" class="form-label"></label>
                        <input asp-for="RequestedByDepartment" class="form-control" readonly />
                    </div>
                    <div class="col-lg-3">
                        <label asp-for="RequestedByEmail" class="form-label"></label>
                        <input asp-for="RequestedByEmail" class="form-control" readonly />
                    </div>
                </div>
            </div>
        </div>

        <div class="card easy-card mb-4">
            <div class="easy-step-head d-flex gap-3 align-items-start">
                <span class="step-number">2</span>
                <div>
                    <h5 class="mb-1">Tarih ve kaynak bilgilerini gir</h5>
                    <div class="text-muted small">Talep ne zaman geldi ve teklif ne zamana gerekli?</div>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="RequestReceivedAt" class="form-label"></label>
                        <input asp-for="RequestReceivedAt" type="date" class="form-control" />
                        <span asp-validation-for="RequestReceivedAt" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="NeededByDate" class="form-label"></label>
                        <input asp-for="NeededByDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="RequestSource" class="form-label"></label>
                        <select asp-for="RequestSource" asp-items="Html.GetEnumSelectList<SalesRequestSource>()" class="form-select"></select>
                    </div>
                    @if (!isSalesArea)
                    {
                        <div class="col-md-4">
                            <label asp-for="OfferStatus" class="form-label"></label>
                            <select asp-for="OfferStatus" asp-items="Html.GetEnumSelectList<SalesOfferStatus>()" class="form-select"></select>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card easy-card mb-4">
            <div class="easy-step-head d-flex gap-3 align-items-start">
                <span class="step-number">3</span>
                <div>
                    <h5 class="mb-1">Teslimat, ekler ve kısa açıklamayı tamamla</h5>
                    <div class="text-muted small">Ülke, nakliye ve müşteri notlarını tek yerde topla.</div>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="ShipmentCountry" class="form-label"></label>
                        <input asp-for="ShipmentCountry" class="form-control" placeholder="Örn: Türkiye" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="InstallationCountry" class="form-label"></label>
                        <input asp-for="InstallationCountry" class="form-control" placeholder="Örn: Almanya" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input asp-for="IsTransportByCustomer" class="form-check-input" />
                            <label asp-for="IsTransportByCustomer" class="form-check-label"></label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Attachments" class="form-label"></label>
                        <input asp-for="Attachments" type="file" class="form-control" multiple accept=".pdf,.xls,.xlsx,.doc,.docx,.msg,.eml,.png,.jpg,.jpeg" />
                        <span asp-validation-for="Attachments" class="text-danger"></span>
                        <div class="field-hint">Mail, PDF, Excel, Word ve görselleri aynı talebe ekleyebilirsin.</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SummaryNotes" class="form-label"></label>
                        <textarea asp-for="SummaryNotes" class="form-control" rows="3" placeholder="Müşterinin istediğini 1-2 cümleyle özetle."></textarea>
                    </div>
                    @if (isRevision)
                    {
                        <div class="col-12">
                            <label asp-for="RevisionReason" class="form-label"></label>
                            <textarea asp-for="RevisionReason" class="form-control" rows="2" required placeholder="Revizyon nedeni zorunludur. Örn: müşteri kapasiteyi değiştirdi."></textarea>
                            <span asp-validation-for="RevisionReason" class="text-danger"></span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card easy-card mb-4">
            <div class="easy-step-head d-flex flex-wrap justify-content-between gap-3 align-items-start">
                <div class="d-flex gap-3 align-items-start">
                    <span class="step-number">4</span>
                    <div>
                        <h5 class="mb-1">İstenen ürün veya hizmeti sırayla doldur</h5>
                        <div class="text-muted small">Önce kategori ve akışkan seç; ardından sadece ilgili alanları görürsün.</div>
                    </div>
                </div>
                <button type="button" class="btn btn-outline-secondary" id="add-item">+ Yeni talep satırı</button>
            </div>
            <div class="card-body">
                <div id="request-items">
                    @for (var i = 0; i < Model.Items.Count; i++)
                    {
                        <div class="p-3 mb-3 request-item">
                            <div class="request-item-head d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <div>
                                    <strong>Talep Satırı #@(i + 1)</strong>
                                    <div class="small text-muted">Bu satırda bir ürün/hizmet ihtiyacını tarif et.</div>
                                </div>
                                <span class="badge bg-primary-subtle text-primary-emphasis">Kategoriye göre sadeleşir</span>
                            </div>

                            <div class="mini-section mb-3">
                                <div class="mini-section-title">A) Önce ne istendiğini seç</div>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label">Talep grubu</label>
                                        <select asp-for="Items[i].RequestCategory" asp-items="Html.GetEnumSelectList<SalesRequestCategory>()" class="form-select request-category"></select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Akışkan grubu</label>
                                        <select asp-for="Items[i].ProductGroupId" asp-items="Model.ProductGroups" class="form-select product-group"><option value="">Seçin</option></select>
                                    </div>
                                    <div class="col-md-4 non-spare-fields">
                                        <label class="form-label">Akışkan</label>
                                        <input type="text" class="form-control product-name-display" readonly value="@Model.Items[i].ProductCode" placeholder="Akışkan grubundan otomatik gelir" />
                                        <input asp-for="Items[i].ProductCode" type="hidden" class="product-code" />
                                    </div>
                                </div>
                            </div>

                            <input asp-for="Items[i].TankOrientation" type="hidden" value="@((int)RequestTankOrientation.Vertical)" />

                            <div class="mini-section mb-3 tank-only-fields">
                                <div class="mini-section-title">B) Tank için temel bilgiler</div>
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label class="form-label">Hacim (m³)</label>
                                        <input asp-for="Items[i].CapacityM3" class="form-control" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Kurulum</label>
                                        <select asp-for="Items[i].PlacementType" asp-items="Html.GetEnumSelectList<PlacementType>()" class="form-select"></select>
                                    </div>
                                </div>
                            </div>

                            <div class="mini-section mb-3 non-spare-fields">
                                <div class="mini-section-title">B) Basınç ve standart bilgileri</div>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label">Dizayn basıncı (bar)</label>
                                        <input asp-for="Items[i].DesignPressureBar" class="form-control" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Dizayn standardı</label>
                                        <input asp-for="Items[i].DesignStandardCode" class="form-control" placeholder="Örn: EN 13458" />
                                    </div>
                                </div>
                            </div>

                            <div class="mini-section mb-3 tank-fields">
                                <div class="mini-section-title">C) Tank tipi ve standart seçimleri</div>
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label class="form-label">Tank tipi</label>
                                        <select asp-for="Items[i].TankType" asp-items="Html.GetEnumSelectList<RequestTankType>()" class="form-select tank-type"></select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Depolama tipi</label>
                                        <select asp-for="Items[i].StorageOption" asp-items="Html.GetEnumSelectList<RequestStorageOption>()" class="form-select storage-option"></select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Transport tipi</label>
                                        <select asp-for="Items[i].TransportOption" asp-items="Html.GetEnumSelectList<RequestTransportOption>()" class="form-select transport-option"></select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">STD/OPS/SPC</label>
                                        <select asp-for="Items[i].StdOpsSelection" asp-items="Html.GetEnumSelectList<RequestStdOpsSelection>()" class="form-select std-ops"></select>
                                    </div>
                                    <div class="col-12 spc-details">
                                        <label class="form-label">SPC teknik bilgileri</label>
                                        <input asp-for="Items[i].SpcTechnicalDetails" class="form-control" placeholder="SPC seçildiyse özel bilgileri yaz" />
                                    </div>
                                </div>
                            </div>

                            <div class="mini-section mb-3 tank-only-fields">
                                <div class="mini-section-title">D) Varsa tank tüketim bilgisi</div>
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-4">
                                        <div class="form-check mb-2">
                                            <input asp-for="Items[i].HasTankConsumptionCapacity" class="form-check-input consumption-toggle" />
                                            <label asp-for="Items[i].HasTankConsumptionCapacity" class="form-check-label"></label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Tüketim kapasitesi</label>
                                        <input asp-for="Items[i].ConsumptionCapacity" class="form-control consumption-input" @@(Model.Items[i].HasTankConsumptionCapacity ? "" : "disabled") />
                                        <div class="field-hint">Tank altı buharlaştırıcı hesabı için referans veri.</div>
                                    </div>
                                </div>
                            </div>

                            <div class="mini-section mb-3 evap-fields">
                                <div class="mini-section-title">B) Evaporatör için ortam bilgileri</div>
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label class="form-label">Ortam min sıcaklık (°C)</label>
                                        <input asp-for="Items[i].AmbientTemperatureMin" class="form-control" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Ortam max sıcaklık (°C)</label>
                                        <input asp-for="Items[i].AmbientTemperatureMax" class="form-control" />
                                    </div>
                                </div>
                            </div>

                            <div class="mini-section mb-3 facility-fields">
                                <div class="mini-section-title">B) Tesis için giriş/çıkış bilgileri</div>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label">Tesis tipi</label>
                                        <input asp-for="Items[i].FacilityType" class="form-control" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Giriş P (bar)</label>
                                        <input asp-for="Items[i].FacilityInletPressureBar" class="form-control" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Çıkış P (bar)</label>
                                        <input asp-for="Items[i].FacilityOutletPressureBar" class="form-control" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Giriş T (°C)</label>
                                        <input asp-for="Items[i].FacilityInletTemperature" class="form-control" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Çıkış T (°C)</label>
                                        <input asp-for="Items[i].FacilityOutletTemperature" class="form-control" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Tesis kapasitesi (Nm3/h)</label>
                                        <input asp-for="Items[i].FacilityCapacityNm3h" class="form-control" />
                                    </div>
                                    <div class="col-md-3 d-flex align-items-end">
                                        <div class="form-check mb-2">
                                            <input asp-for="Items[i].HasPump" class="form-check-input" />
                                            <label asp-for="Items[i].HasPump" class="form-check-label"></label>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Pompa detay</label>
                                        <input asp-for="Items[i].PumpDetails" class="form-control" />
                                    </div>
                                    <div class="col-md-3 d-flex align-items-end">
                                        <div class="form-check mb-2">
                                            <input asp-for="Items[i].HasElectricHeater" class="form-check-input" />
                                            <label asp-for="Items[i].HasElectricHeater" class="form-check-label"></label>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Isıtıcı detay</label>
                                        <input asp-for="Items[i].ElectricHeaterDetails" class="form-control" />
                                    </div>
                                </div>
                            </div>

                            <div class="mini-section mb-3 spare-fields">
                                <div class="mini-section-title">B) Yedek parça bilgisi</div>
                                <div class="row g-3">
                                    <div class="col-md-8">
                                        <label class="form-label">Açıklama</label>
                                        <input asp-for="Items[i].SparePartDetails" class="form-control" placeholder="Talep edilen yedek parçayı anlaşılır şekilde yaz" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Ek yükle</label>
                                        <input asp-for="Attachments" type="file" class="form-control" multiple accept=".pdf,.xls,.xlsx,.doc,.docx,.msg,.eml,.png,.jpg,.jpeg" />
                                        <div class="field-hint">Yedek parçada en az bir ek önerilir.</div>
                                    </div>
                                </div>
                            </div>

                            <div class="mini-section non-spare-fields">
                                <div class="mini-section-title">Son notlar</div>
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label class="form-label">Min sıcaklık (°C)</label>
                                        <input asp-for="Items[i].DesignTemperatureMin" class="form-control" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Max sıcaklık (°C)</label>
                                        <input asp-for="Items[i].DesignTemperatureMax" class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Ek sorular / cevaplar</label>
                                        <textarea asp-for="Items[i].AdditionalQuestionsJson" class="form-control" rows="2" placeholder="JSON zorunlu değil; varsa ek soru-cevapları yaz."></textarea>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Minimum teknik bilgiler</label>
                                        <textarea asp-for="Items[i].MinimumTechnicalNotes" class="form-control" rows="2" placeholder="Basınç, standart, vana isteği, özel saha şartı vb."></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card easy-card mb-4">
            <div class="easy-step-head d-flex gap-3 align-items-start">
                <span class="step-number">5</span>
                <div>
                    <h5 class="mb-1">Kontrol et ve kaydet</h5>
                    <div class="text-muted small">Eksik teknik detay varsa not alanına yazdıysan talebi oluşturabilirsin.</div>
                </div>
            </div>
            <div class="card-body sticky-actions">
                <div class="d-flex flex-wrap gap-2 justify-content-end">
                    <a asp-area="@currentArea" asp-controller="SalesRequest" asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                    <button type="submit" class="btn btn-primary btn-lg">@(isRevision ? "Revizyonu kaydet" : isEdit ? "Talebi güncelle" : "Talebi oluştur")</button>
                </div>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
    <script>
        const categoryTank = '@((int)SalesRequestCategory.Tank)';
        const categoryEvap = '@((int)SalesRequestCategory.Evaporator)';
        const categoryFacility = '@((int)SalesRequestCategory.Facility)';
        const categorySparePart = '@((int)SalesRequestCategory.SparePart)';
        const tankTypeStorage = '@((int)RequestTankType.Storage)';

        const productOptions = `@Html.Raw(string.Join("", Model.ProductGroups.Select(x => $"<option value=\"{x.Value}\">{x.Text}</option>")))`;
        const placementOptions = `@Html.Raw(string.Join("", Html.GetEnumSelectList<PlacementType>().Select(x => $"<option value=\"{x.Value}\">{x.Text}</option>")))`;
        const categoryOptions = `@Html.Raw(string.Join("", Html.GetEnumSelectList<SalesRequestCategory>().Select(x => $"<option value=\"{x.Value}\">{x.Text}</option>")))`;
        const tankTypeOptions = `@Html.Raw(string.Join("", Html.GetEnumSelectList<RequestTankType>().Select(x => $"<option value=\"{x.Value}\">{x.Text}</option>")))`;
        const storageOptions = `@Html.Raw(string.Join("", Html.GetEnumSelectList<RequestStorageOption>().Select(x => $"<option value=\"{x.Value}\">{x.Text}</option>")))`;
        const transportOptions = `@Html.Raw(string.Join("", Html.GetEnumSelectList<RequestTransportOption>().Select(x => $"<option value=\"{x.Value}\">{x.Text}</option>")))`;
        const stdOpsOptions = `@Html.Raw(string.Join("", Html.GetEnumSelectList<RequestStdOpsSelection>().Select(x => $"<option value=\"{x.Value}\">{x.Text}</option>")))`;

        function toggleCategoryFields(item) {
            const categoryValue = item.querySelector('.request-category')?.value;
            const showTank = categoryValue === categoryTank;
            const showEvap = categoryValue === categoryEvap;
            const showFacility = categoryValue === categoryFacility;
            const showSparePart = categoryValue === categorySparePart;

            item.querySelectorAll('.tank-fields').forEach(x => x.style.display = showTank ? '' : 'none');
            item.querySelectorAll('.tank-only-fields').forEach(x => x.style.display = showTank ? '' : 'none');
            item.querySelectorAll('.evap-fields').forEach(x => x.style.display = showEvap ? '' : 'none');
            item.querySelectorAll('.facility-fields').forEach(x => x.style.display = showFacility ? '' : 'none');
            item.querySelectorAll('.spare-fields').forEach(x => x.style.display = showSparePart ? '' : 'none');
            item.querySelectorAll('.non-spare-fields').forEach(x => x.style.display = showSparePart ? 'none' : '');

            toggleTankTypeFields(item);
        }

        function toggleTankTypeFields(item) {
            const tankType = item.querySelector('.tank-type');
            const storage = item.querySelector('.storage-option');
            const transport = item.querySelector('.transport-option');
            if (!tankType || !storage || !transport) return;

            if (tankType.value === tankTypeStorage) {
                transport.value = '';
                transport.disabled = true;
                storage.disabled = false;
            } else if (tankType.value) {
                storage.value = '';
                storage.disabled = true;
                transport.disabled = false;
            } else {
                storage.disabled = false;
                transport.disabled = false;
            }
        }

        function toggleConsumptionCapacity(item) {
            const checkbox = item.querySelector('.consumption-toggle');
            const input = item.querySelector('.consumption-input');
            if (!checkbox || !input) return;

            input.disabled = !checkbox.checked;
            if (!checkbox.checked) {
                input.value = '';
            }
        }

        function syncProductCode(item) {
            const groupSelect = item.querySelector('.product-group');
            const productCodeInput = item.querySelector('.product-code');
            const productDisplay = item.querySelector('.product-name-display');
            if (!groupSelect || !productCodeInput || !productDisplay) return;

            const selectedText = groupSelect.selectedOptions.length ? groupSelect.selectedOptions[0].text.trim() : '';
            const normalized = selectedText && selectedText !== 'Seçin' ? selectedText : '';

            productCodeInput.value = normalized;
            productDisplay.value = normalized;
        }

        function wireItemEvents(item) {
            const category = item.querySelector('.request-category');
            const tankType = item.querySelector('.tank-type');
            const productGroup = item.querySelector('.product-group');
            const consumptionToggle = item.querySelector('.consumption-toggle');
            if (category) category.addEventListener('change', () => toggleCategoryFields(item));
            if (tankType) tankType.addEventListener('change', () => toggleTankTypeFields(item));
            if (productGroup) productGroup.addEventListener('change', () => syncProductCode(item));
            if (consumptionToggle) consumptionToggle.addEventListener('change', () => toggleConsumptionCapacity(item));
            syncProductCode(item);
            toggleConsumptionCapacity(item);
            toggleCategoryFields(item);
        }

        document.getElementById('add-item').addEventListener('click', function () {
            const container = document.getElementById('request-items');
            const index = container.querySelectorAll('.request-item').length;
            const html = `
                <div class="p-3 mb-3 request-item">
                    <div class="request-item-head d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div><strong>Talep Satırı #${index + 1}</strong><div class="small text-muted">Bu satırda bir ürün/hizmet ihtiyacını tarif et.</div></div>
                        <span class="badge bg-primary-subtle text-primary-emphasis">Kategoriye göre sadeleşir</span>
                    </div>
                    <div class="mini-section mb-3"><div class="mini-section-title">A) Önce ne istendiğini seç</div><div class="row g-3"><div class="col-md-4"><label class="form-label">Talep grubu</label><select name="Items[${index}].RequestCategory" class="form-select request-category">${categoryOptions}</select></div><div class="col-md-4"><label class="form-label">Akışkan grubu</label><select name="Items[${index}].ProductGroupId" class="form-select product-group"><option value="">Seçin</option>${productOptions}</select></div><div class="col-md-4 non-spare-fields"><label class="form-label">Akışkan</label><input class="form-control product-name-display" readonly placeholder="Akışkan grubundan otomatik gelir" /><input name="Items[${index}].ProductCode" type="hidden" class="product-code" /></div></div></div>
                    <input name="Items[${index}].TankOrientation" type="hidden" value="@((int)RequestTankOrientation.Vertical)" />
                    <div class="mini-section mb-3 tank-only-fields"><div class="mini-section-title">B) Tank için temel bilgiler</div><div class="row g-3"><div class="col-md-3"><label class="form-label">Hacim (m³)</label><input name="Items[${index}].CapacityM3" class="form-control" /></div><div class="col-md-3"><label class="form-label">Kurulum</label><select name="Items[${index}].PlacementType" class="form-select">${placementOptions}</select></div></div></div>
                    <div class="mini-section mb-3 non-spare-fields"><div class="mini-section-title">B) Basınç ve standart bilgileri</div><div class="row g-3"><div class="col-md-4"><label class="form-label">Dizayn basıncı (bar)</label><input name="Items[${index}].DesignPressureBar" class="form-control" /></div><div class="col-md-4"><label class="form-label">Dizayn standardı</label><input name="Items[${index}].DesignStandardCode" class="form-control" placeholder="Örn: EN 13458" /></div></div></div>
                    <div class="mini-section mb-3 tank-fields"><div class="mini-section-title">C) Tank tipi ve standart seçimleri</div><div class="row g-3"><div class="col-md-3"><label class="form-label">Tank tipi</label><select name="Items[${index}].TankType" class="form-select tank-type">${tankTypeOptions}</select></div><div class="col-md-3"><label class="form-label">Depolama tipi</label><select name="Items[${index}].StorageOption" class="form-select storage-option">${storageOptions}</select></div><div class="col-md-3"><label class="form-label">Transport tipi</label><select name="Items[${index}].TransportOption" class="form-select transport-option">${transportOptions}</select></div><div class="col-md-3"><label class="form-label">STD/OPS/SPC</label><select name="Items[${index}].StdOpsSelection" class="form-select std-ops">${stdOpsOptions}</select></div><div class="col-12 spc-details"><label class="form-label">SPC teknik bilgileri</label><input name="Items[${index}].SpcTechnicalDetails" class="form-control" placeholder="SPC seçildiyse özel bilgileri yaz" /></div></div></div>
                    <div class="mini-section mb-3 tank-only-fields"><div class="mini-section-title">D) Varsa tank tüketim bilgisi</div><div class="row g-3 align-items-end"><div class="col-md-4"><div class="form-check mb-2"><input name="Items[${index}].HasTankConsumptionCapacity" type="checkbox" class="form-check-input consumption-toggle" /><label class="form-check-label">Tank tüketim kapasitesi aktif</label></div></div><div class="col-md-4"><label class="form-label">Tüketim kapasitesi</label><input name="Items[${index}].ConsumptionCapacity" class="form-control consumption-input" disabled /><div class="field-hint">Tank altı buharlaştırıcı hesabı için referans veri.</div></div></div></div>
                    <div class="mini-section mb-3 evap-fields"><div class="mini-section-title">B) Evaporatör için ortam bilgileri</div><div class="row g-3"><div class="col-md-3"><label class="form-label">Ortam min sıcaklık (°C)</label><input name="Items[${index}].AmbientTemperatureMin" class="form-control" /></div><div class="col-md-3"><label class="form-label">Ortam max sıcaklık (°C)</label><input name="Items[${index}].AmbientTemperatureMax" class="form-control" /></div></div></div>
                    <div class="mini-section mb-3 facility-fields"><div class="mini-section-title">B) Tesis için giriş/çıkış bilgileri</div><div class="row g-3"><div class="col-md-4"><label class="form-label">Tesis tipi</label><input name="Items[${index}].FacilityType" class="form-control" /></div><div class="col-md-2"><label class="form-label">Giriş P (bar)</label><input name="Items[${index}].FacilityInletPressureBar" class="form-control" /></div><div class="col-md-2"><label class="form-label">Çıkış P (bar)</label><input name="Items[${index}].FacilityOutletPressureBar" class="form-control" /></div><div class="col-md-2"><label class="form-label">Giriş T (°C)</label><input name="Items[${index}].FacilityInletTemperature" class="form-control" /></div><div class="col-md-2"><label class="form-label">Çıkış T (°C)</label><input name="Items[${index}].FacilityOutletTemperature" class="form-control" /></div><div class="col-md-3"><label class="form-label">Tesis kapasitesi (Nm3/h)</label><input name="Items[${index}].FacilityCapacityNm3h" class="form-control" /></div><div class="col-md-3 d-flex align-items-end"><div class="form-check mb-2"><input name="Items[${index}].HasPump" type="checkbox" class="form-check-input" /><label class="form-check-label">Pompa var mı?</label></div></div><div class="col-md-3"><label class="form-label">Pompa detay</label><input name="Items[${index}].PumpDetails" class="form-control" /></div><div class="col-md-3 d-flex align-items-end"><div class="form-check mb-2"><input name="Items[${index}].HasElectricHeater" type="checkbox" class="form-check-input" /><label class="form-check-label">Elektrikli ısıtıcı var mı?</label></div></div><div class="col-md-3"><label class="form-label">Isıtıcı detay</label><input name="Items[${index}].ElectricHeaterDetails" class="form-control" /></div></div></div>
                    <div class="mini-section mb-3 spare-fields"><div class="mini-section-title">B) Yedek parça bilgisi</div><div class="row g-3"><div class="col-md-8"><label class="form-label">Açıklama</label><input name="Items[${index}].SparePartDetails" class="form-control" placeholder="Talep edilen yedek parçayı anlaşılır şekilde yaz" /></div><div class="col-md-4"><label class="form-label">Ek yükle</label><input name="Attachments" type="file" class="form-control" multiple accept=".pdf,.xls,.xlsx,.doc,.docx,.msg,.eml,.png,.jpg,.jpeg" /><div class="field-hint">Yedek parçada en az bir ek önerilir.</div></div></div></div>
                    <div class="mini-section non-spare-fields"><div class="mini-section-title">Son notlar</div><div class="row g-3"><div class="col-md-3"><label class="form-label">Min sıcaklık (°C)</label><input name="Items[${index}].DesignTemperatureMin" class="form-control" /></div><div class="col-md-3"><label class="form-label">Max sıcaklık (°C)</label><input name="Items[${index}].DesignTemperatureMax" class="form-control" /></div><div class="col-md-6"><label class="form-label">Ek sorular / cevaplar</label><textarea name="Items[${index}].AdditionalQuestionsJson" class="form-control" rows="2" placeholder="JSON zorunlu değil; varsa ek soru-cevapları yaz."></textarea></div><div class="col-12"><label class="form-label">Minimum teknik bilgiler</label><textarea name="Items[${index}].MinimumTechnicalNotes" class="form-control" rows="2" placeholder="Basınç, standart, vana isteği, özel saha şartı vb."></textarea></div></div></div>
                </div>`;
            container.insertAdjacentHTML('beforeend', html);
            wireItemEvents(container.lastElementChild);
        });

        document.querySelectorAll('#request-items .request-item').forEach(wireItemEvents);
    </script>
}
