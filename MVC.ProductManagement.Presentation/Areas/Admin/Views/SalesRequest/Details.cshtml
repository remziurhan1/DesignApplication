                                </div>

                                <div class="subitem-section spare-fields">
                                    <div class="subitem-section-title">B) Yedek parça bilgisi</div>
                                    <label asp-for="NewSubItem.SparePartDetails" class="form-label"></label>
                                    <input asp-for="NewSubItem.SparePartDetails" class="form-control" placeholder="Talep edilen yedek parçayı yaz" />
                                </div>

                                <div class="subitem-section non-spare-fields">
                                    <div class="subitem-section-title">Son notlar</div>
                                    <div class="row g-3">
                                        <div class="col-md-6"><label asp-for="NewSubItem.DesignTemperatureMin" class="form-label"></label><input asp-for="NewSubItem.DesignTemperatureMin" class="form-control" /></div>
                                        <div class="col-md-6"><label asp-for="NewSubItem.DesignTemperatureMax" class="form-label"></label><input asp-for="NewSubItem.DesignTemperatureMax" class="form-control" /></div>
