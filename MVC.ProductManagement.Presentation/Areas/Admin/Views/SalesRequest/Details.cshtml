@using Microsoft.AspNetCore.Mvc.Rendering
@using MVC.ProductManagement.Domain.Enums
@model MVC.ProductManagement.Presentation.Areas.Admin.Models.SalesRequestVMs.SalesRequestDetailVm
@{
    ViewData["Title"] = Model.IsManagerView ? "Talep Yönetici Detayı" : "Talep Satışçı Detayı";

    string StatusClass(SalesRequestWorkflowStatus status) => status switch
    {
        SalesRequestWorkflowStatus.Approved => "success",
        SalesRequestWorkflowStatus.Rejected => "danger",
        SalesRequestWorkflowStatus.PricingInProgress => "warning",
        _ => "info"
    };

    string? BuildTechnicalLink(MVC.ProductManagement.Presentation.Areas.Admin.Models.SalesRequestVMs.SalesRequestDetailItemVm item)
        => item.LinkedCalculationType switch
        {
            SalesRequestCalculationType.AD2000 when item.LinkedCalculationId.HasValue => Url.Action("Details", "AD2000Calculation", new { area = "Admin", id = item.LinkedCalculationId.Value, mode = "sales" }),
            SalesRequestCalculationType.EN13458 when item.LinkedCalculationId.HasValue => Url.Action("Details", "EN13458Calculation", new { area = "Admin", id = item.LinkedCalculationId.Value, mode = "sales" }),
            _ => null
        };

    string? BuildAnalysisLink(MVC.ProductManagement.Presentation.Areas.Admin.Models.SalesRequestVMs.SalesRequestDetailItemVm item)
        => item.LinkedCalculationType switch
        {
            SalesRequestCalculationType.AD2000 when item.LinkedCalculationId.HasValue && item.LinkedCostAnalysisId.HasValue
                => Url.Action("Cost", "AD2000Calculation", new { area = "Admin", id = item.LinkedCalculationId.Value, costAnalysisId = item.LinkedCostAnalysisId.Value }),
            SalesRequestCalculationType.EN13458 when item.LinkedCalculationId.HasValue && item.LinkedCostAnalysisId.HasValue
                => Url.Action("Cost", "EN13458Calculation", new { area = "Admin", id = item.LinkedCalculationId.Value, costAnalysisId = item.LinkedCostAnalysisId.Value }),
            _ => null
        };

    string TextOrDash(object? value) => string.IsNullOrWhiteSpace(value?.ToString()) ? "-" : value.ToString()!;

    void RenderFact(string label, object? value, string columnClass = "col-md-4")
    {
        <div class="@columnClass">
            <div class="detail-label">@label</div>
            <div class="detail-value">@TextOrDash(value)</div>
        </div>
    }

    void RenderLongFact(string label, string? value)
    {
        <div class="col-12">
            <div class="detail-label">@label</div>
            <div class="detail-note">@TextOrDash(value)</div>
        </div>
    }

    void RenderItem(MVC.ProductManagement.Presentation.Areas.Admin.Models.SalesRequestVMs.SalesRequestDetailItemVm item, int depth)
    {
        var technicalLink = BuildTechnicalLink(item);
        var analysisLink = BuildAnalysisLink(item);
        var indentClass = depth > 0 ? "child-item" : string.Empty;

        <div class="request-line-card @indentClass">
            <div class="request-line-head">
                <div>
                    <span class="badge bg-secondary">@item.ItemCode</span>
                    <h5 class="mb-1 mt-2">@item.ItemTitle</h5>
                    <div class="text-muted small">@item.ProductGroupName</div>
                </div>
                <div class="d-flex flex-wrap gap-2 justify-content-end">
                    <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis">@item.RequestCategory</span>
                    <span class="badge rounded-pill bg-@StatusClass(item.WorkflowStatus)">@item.WorkflowStatus</span>
                </div>
            </div>

            <div class="line-section">
                <div class="line-section-title">A) Temel istek</div>
                <div class="row g-3">
                    @{ RenderFact("Akışkan / Ürün", item.ProductCode); }
                    @{ RenderFact("Kapasite", item.RequestCategory == SalesRequestCategory.Tank ? $"{item.CapacityM3:0.##} m³" : "-"); }
                    @{ RenderFact("Dizayn basıncı", item.DesignPressureBar?.ToString("0.##")); }
                    @{ RenderFact("Dizayn standardı", item.DesignStandardCode); }
                    @{ RenderFact("Dizayn sıcaklığı", $"{TextOrDash(item.DesignTemperatureMin)} / {TextOrDash(item.DesignTemperatureMax)}"); }
                    @{ RenderFact("Tüketim", item.ConsumptionCapacity?.ToString("0.##")); }
                </div>
            </div>

            @if (item.RequestCategory == SalesRequestCategory.Tank)
            {
                <div class="line-section">
                    <div class="line-section-title">B) Tank bilgileri</div>
                    <div class="row g-3">
                        @{ RenderFact("Tank tipi", item.TankType); }
                        @{ RenderFact("Depolama", item.StorageOption); }
                        @{ RenderFact("Transport", item.TransportOption); }
                        @{ RenderFact("Kurulum", item.PlacementType); }
                        @{ RenderFact("STD/OPS/SPC", item.StdOpsSelection); }
                        @{ RenderLongFact("SPC teknik bilgileri", item.SpcTechnicalDetails); }
                    </div>
                </div>
            }

            @if (item.RequestCategory == SalesRequestCategory.Evaporator)
            {
                <div class="line-section">
                    <div class="line-section-title">B) Evaporatör bilgileri</div>
                    <div class="row g-3">
                        @{ RenderFact("Ortam sıcaklığı", $"{TextOrDash(item.AmbientTemperatureMin)} / {TextOrDash(item.AmbientTemperatureMax)}"); }
                        @{ RenderFact("Tank tüketim kapasitesi", item.HasTankConsumptionCapacity ? "Aktif" : "Pasif"); }
                    </div>
                </div>
            }

            @if (item.RequestCategory == SalesRequestCategory.Facility)
            {
                <div class="line-section">
                    <div class="line-section-title">B) Tesis bilgileri</div>
                    <div class="row g-3">
                        @{ RenderFact("Tesis tipi", item.FacilityType); }
                        @{ RenderFact("Basınç (G/Ç)", $"{TextOrDash(item.FacilityInletPressureBar)} / {TextOrDash(item.FacilityOutletPressureBar)}"); }
                        @{ RenderFact("Sıcaklık (G/Ç)", $"{TextOrDash(item.FacilityInletTemperature)} / {TextOrDash(item.FacilityOutletTemperature)}"); }
                        @{ RenderFact("Tesis kapasitesi", item.FacilityCapacityNm3h); }
                        @{ RenderFact("Pompa", item.HasPump ? "Var" : "Yok"); }
                        @{ RenderFact("Elektrikli ısıtıcı", item.HasElectricHeater ? "Var" : "Yok"); }
                        @{ RenderLongFact("Pompa detay", item.PumpDetails); }
                        @{ RenderLongFact("Isıtıcı detay", item.ElectricHeaterDetails); }
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(item.AdditionalQuestionsJson) || !string.IsNullOrWhiteSpace(item.MinimumTechnicalNotes) || !string.IsNullOrWhiteSpace(item.DesignDetails))
            {
                <div class="line-section">
                    <div class="line-section-title">C) Notlar</div>
                    <div class="row g-3">
                        @{ RenderLongFact("Ek sorular / cevaplar", item.AdditionalQuestionsJson); }
                        @{ RenderLongFact("Minimum teknik veri", item.MinimumTechnicalNotes); }
                        @{ RenderLongFact("Teknik özet", item.DesignDetails); }
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(item.LinkedCalculationName) || Model.IsManagerView)
            {
                <div class="line-section mb-0">
                    <div class="line-section-title">D) Fiyatlandırma ve teknik bağlantılar</div>
                    <div class="row g-3 align-items-center">
                        @if (!string.IsNullOrWhiteSpace(item.LinkedCalculationName))
                        {
                            <div class="col-12">
                                <div class="detail-label">Bağlı teknik hesap</div>
                                <div class="detail-value">
                                    @item.LinkedCalculationType · @item.LinkedCalculationName
                                    @if (!string.IsNullOrWhiteSpace(technicalLink))
                                    {
                                        <a href="@technicalLink" class="btn btn-sm btn-outline-primary ms-2">Teknik hesabı aç</a>
                                    }
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="detail-label">Bağlı maliyet çalışması</div>
                                <div class="detail-value">
                                    @item.LinkedCostAnalysisRevisionCode · @(item.LinkedCostAnalysisTotal?.ToString("N2") ?? "-") ₺
                                    @if (!string.IsNullOrWhiteSpace(analysisLink))
                                    {
                                        <a href="@analysisLink" class="btn btn-sm btn-outline-secondary ms-2">Maliyet detayını aç</a>
                                    }
                                </div>
                            </div>
                        }
                        @if (Model.IsManagerView)
                        {
                            @{ RenderFact("Maliyet", item.EstimatedCost.HasValue ? $"{item.EstimatedCost:N2} ₺" : "-"); }
                            @{ RenderFact("Minimum satış fiyatı", item.MinimumSalesPrice.HasValue ? $"{item.MinimumSalesPrice:N2} ₺" : "-"); }
                            @{ RenderFact("Satış fiyatı", item.ApprovedSalesPrice.HasValue ? $"{item.ApprovedSalesPrice:N2} ₺" : "-"); }
                            @{ RenderLongFact("İç açıklama", item.SalesEngineeringNotes); }
                        }
                    </div>
                </div>
            }
        </div>

        foreach (var child in item.Children)
        {
            RenderItem(child, depth + 1);
        }
    }
}

<style>
    .detail-page {
        background: #f6f8fb;
        border-radius: 1.25rem;
        padding: 1rem;
    }

    .detail-hero {
        background: linear-gradient(135deg, #0d6efd 0%, #1f2a44 100%);
        color: #fff;
        border-radius: 1.25rem;
        padding: 1.5rem;
        box-shadow: 0 18px 40px rgba(13, 110, 253, 0.18);
    }

    .hero-pill {
        background: rgba(255, 255, 255, .14);
        border: 1px solid rgba(255, 255, 255, .24);
        border-radius: 999px;
        padding: .45rem .8rem;
        font-size: .85rem;
    }

    .easy-card,
    .request-line-card {
        border: 1px solid #e5ebf3;
        border-radius: 1.1rem;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.05);
        background: #fff;
    }

    .easy-card .card-header {
        background: #fff;
        border-bottom: 1px solid #edf1f6;
        padding: 1rem 1.25rem;
    }

    .step-number {
        width: 2.35rem;
        height: 2.35rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #0d6efd;
        color: #fff;
        font-weight: 800;
        flex: 0 0 auto;
    }

    .detail-label {
        color: #6c757d;
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .02em;
        text-transform: uppercase;
    }

    .detail-value {
        color: #1f2a44;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .detail-note {
        color: #495057;
        background: #fbfcfe;
        border: 1px solid #edf1f6;
        border-radius: .75rem;
        padding: .65rem .75rem;
        min-height: 2.5rem;
        overflow-wrap: anywhere;
    }

    .request-line-card {
        padding: 1rem;
        margin-bottom: 1rem;
    }

    .request-line-card.child-item {
        margin-left: 1.25rem;
        border-left: .35rem solid #cfe7ff;
    }

    .request-line-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        flex-wrap: wrap;
        background: #f7faff;
        border: 1px solid #d9e8ff;
        border-radius: .9rem;
        padding: .85rem 1rem;
        margin-bottom: 1rem;
    }

    .line-section,
    .subitem-section {
        border: 1px solid #edf1f6;
        border-radius: .9rem;
        padding: 1rem;
        background: #fbfcfe;
        margin-bottom: 1rem;
    }

    .line-section-title,
    .subitem-section-title {
        font-weight: 800;
        color: #1f2a44;
        margin-bottom: .8rem;
    }

    .side-card {
        position: sticky;
        top: 1rem;
    }
</style>

<div class="pagetitle d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <h1>@Model.RequestNo</h1>
        <p class="text-muted mb-0">@Model.Title</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (Model.IsManagerView)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Talebi güncelle</a>
            <a asp-action="Pricing" asp-route-id="@Model.Id" class="btn btn-primary">Fiyatlandırma ekranı</a>
            @if (Model.WorkflowStatus == SalesRequestWorkflowStatus.Approved)
            {
                <a asp-area="Sales" asp-controller="SalesRequest" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-success">Satışçı görünümü</a>
            }
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Listeye dön</a>
    </div>
</div>

<section class="section mt-4 detail-page">
    <div class="detail-hero mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <h4 class="mb-2">Talep detayını adım adım oku</h4>
                <p class="mb-0 opacity-75">Müşteri, teslimat, teknik satırlar, ekler ve revizyonlar aynı oluşturma ekranındaki sırayla gösterilir.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <span class="hero-pill">Durum: @Model.WorkflowStatus</span>
                <span class="hero-pill">Revizyon: @Model.RevisionCode</span>
                <span class="hero-pill">Kalem: @Model.Items.Count</span>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card easy-card mb-4">
                <div class="card-header d-flex gap-3 align-items-start">
                    <span class="step-number">1</span>
                    <div>
                        <h5 class="mb-1">Müşteri ve talep sahibi</h5>
                        <div class="text-muted small">Talebin kimin için ve kim tarafından açıldığını hızlıca kontrol et.</div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="detail-label">Müşteri</div>
                            <div class="detail-value"><a asp-controller="Customer" asp-action="Details" asp-route-id="@Model.CustomerId">@Model.CustomerName</a></div>
                        </div>
                        @{ RenderFact("Yetkili", Model.CustomerContact); }
                        <div class="col-md-4">
                            <div class="detail-label">İletişim</div>
                            <div class="detail-value">@TextOrDash(Model.CustomerEmail)<br />@TextOrDash(Model.CustomerPhone)</div>
                        </div>
                        @{ RenderFact("Satışçı", Model.RequestedByName); }
                        @{ RenderFact("Departman", Model.RequestedByDepartment); }
                        <div class="col-md-4">
                            <div class="detail-label">Durum</div>
                            <div><span class="badge bg-@StatusClass(Model.WorkflowStatus)">@Model.WorkflowStatus</span></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card easy-card mb-4">
                <div class="card-header d-flex gap-3 align-items-start">
                    <span class="step-number">2</span>
                    <div>
                        <h5 class="mb-1">Tarih ve kaynak</h5>
                        <div class="text-muted small">Talebin geliş ve ihtiyaç tarihleri.</div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @{ RenderFact("Talep oluşturma", Model.SalesOpenedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")); }
                        @{ RenderFact("Talep alma", Model.RequestReceivedAt.HasValue ? Model.RequestReceivedAt.Value.ToString("dd.MM.yyyy") : "-"); }
                        @{ RenderFact("İhtiyaç tarihi", Model.NeededByDate.ToLocalTime().ToString("dd.MM.yyyy")); }
                        @{ RenderFact("Talep kaynağı", Model.RequestSource); }
                        @{ RenderFact("Müşteri bildirimi", Model.CustomerQuoteStatus); }
                        @{ RenderFact("Revizyon", Model.RevisionCode); }
                    </div>
                </div>
            </div>

            <div class="card easy-card mb-4">
                <div class="card-header d-flex gap-3 align-items-start">
                    <span class="step-number">3</span>
                    <div>
                        <h5 class="mb-1">Teslimat ve özet</h5>
                        <div class="text-muted small">Sevk, kurulum, bölge ve satış özeti.</div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @{ RenderFact("Sevk ülkesi", Model.ShipmentCountry); }
                        @{ RenderFact("Kurulum ülkesi", Model.InstallationCountry); }
                        @{ RenderFact("Nakliye", Model.IsTransportByCustomer ? "Müşteri" : "Biz"); }
                        @{ RenderFact("Müşteri sektörü", Model.CustomerSector); }
                        @{ RenderFact("Ana bayi ülkesi", Model.CustomerMainDealerCountry); }
                        @{ RenderFact("Bölge", Model.CustomerRegion); }
                        @{ RenderLongFact("Satış özeti", Model.SummaryNotes); }
                    </div>
                </div>
            </div>

            <div class="card easy-card mb-4">
                <div class="card-header d-flex gap-3 align-items-start">
                    <span class="step-number">4</span>
                    <div>
                        <h5 class="mb-1">Talep satırları</h5>
                        <div class="text-muted small">Her teknik ihtiyaç ayrı kartta ve kategoriye göre gruplanır.</div>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.Items.Any())
                    {
                        @foreach (var item in Model.Items)
                        {
                            RenderItem(item, 0);
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">Talep satırı bulunmuyor.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="side-card">
                <div class="card easy-card mb-3">
                    <div class="card-header d-flex gap-3 align-items-start">
                        <span class="step-number">5</span>
                        <div>
                            <h5 class="mb-1">Ekler</h5>
                            <div class="text-muted small">Talebe bağlı dosyalar.</div>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (Model.Attachments.Any())
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var file in Model.Attachments)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <a href="@file.RelativePath" target="_blank">@file.OriginalFileName</a>
                                        <small class="text-muted">@(file.FileSize / 1024) KB</small>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Ek dosya yok.</p>
                        }
                    </div>
                </div>

                <div class="card easy-card mb-3">
                    <div class="card-header">
                        <h5 class="mb-1">Talep yorumları</h5>
                        <div class="text-muted small">Yönetici notları ve geçmiş yorumlar.</div>
                    </div>
                    <div class="card-body">
                        <form asp-action="AddComment" method="post" class="mb-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="SalesRequestId" value="@Model.NewComment.SalesRequestId" />
                            <textarea name="CommentText" class="form-control" rows="3" placeholder="Yönetici yorumu ekleyin"></textarea>
                            <button type="submit" class="btn btn-sm btn-outline-primary mt-2">Yorum ekle</button>
                        </form>

                        @if (Model.Comments.Any())
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var comment in Model.Comments)
                                {
                                    <li class="list-group-item px-0">
                                        <div class="small text-muted">@comment.CommentedBy · @comment.CommentedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                                        <div>@comment.CommentText</div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Yorum bulunmuyor.</p>
                        }
                    </div>
                </div>

                <div class="card easy-card mb-3">
                    <div class="card-header">
                        <h5 class="mb-1">Revizyon ekranları</h5>
                        <div class="text-muted small">Revizyon bazlı maliyet ve satış bilgileri.</div>
                    </div>
                    <div class="card-body">
                        @if (Model.RevisionCosts.Any())
                        {
                            @foreach (var revision in Model.RevisionCosts)
                            {
                                <div class="border rounded-3 p-3 mb-2 bg-light-subtle">
                                    <div class="d-flex justify-content-between flex-wrap gap-2">
                                        <div><strong>@revision.RevisionCode</strong> - @revision.RevisionReason</div>
                                        <div><strong>Toplam:</strong> @(revision.TotalCost?.ToString("N2") ?? "-") ₺</div>
                                    </div>
                                    <small class="text-muted">@revision.RevisedBy · @revision.RevisedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                                    <div class="mt-2">
                                        <a asp-action="Revision"
                                           asp-route-id="@Model.Id"
                                           asp-route-revisionNo="@revision.RevisionNo"
                                           asp-route-mode="@(Model.IsManagerView ? "manager" : "sales")"
                                           class="btn btn-sm btn-outline-primary">
                                            @revision.RevisionCode ekranını aç
                                        </a>
                                    </div>
                                    <div class="mt-2">
                                        @foreach (var revisionItem in revision.Items)
                                        {
                                            <div class="small text-muted">
                                                @revisionItem.ItemCode · @revisionItem.CapacityM3 m³ · @(revisionItem.LinkedCostAnalysisRevisionCode ?? "-") · Maliyet: @(revisionItem.LinkedCostAnalysisTotal?.ToString("N2") ?? "-") ₺ · İletilen: @(revisionItem.SharedSalesPrice?.ToString("N2") ?? "-") ₺ · Satılan: @(revisionItem.SoldSalesPrice?.ToString("N2") ?? "-") ₺
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted mb-0">Revizyon kaydı bulunmuyor.</p>
                        }
                    </div>
                </div>

                @if (Model.IsManagerView)
                {
                    <div class="card easy-card">
                        <div class="card-header">
                            <h5 class="mb-1">Alt talep ekle</h5>
                            <div class="text-muted small">Oluşturma ekranındaki aynı sırayla ek satır gir.</div>
                        </div>
                        <div class="card-body">
                            <form asp-action="AddSubItem" method="post" id="subitem-form">
                                @Html.AntiForgeryToken()
                                <input asp-for="NewSubItem.SalesRequestId" type="hidden" />

                                <div class="subitem-section">
                                    <div class="subitem-section-title">A) Önce ne istendiğini seç</div>
                                    <div class="mb-3">
                                        <label class="form-label">Bağlı olduğu üst satır</label>
                                        <select asp-for="NewSubItem.ParentSalesRequestItemId" class="form-select">
                                            <option value="">Ana talep seviyesinde ekle</option>
                                            @foreach (var root in Model.Items)
                                            {
                                                <option value="@root.Id">@root.ItemCode - @root.ItemTitle</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="NewSubItem.RequestCategory" class="form-label"></label>
                                        <select asp-for="NewSubItem.RequestCategory" asp-items="Html.GetEnumSelectList<SalesRequestCategory>()" class="form-select subitem-category"></select>
                                    </div>
                                    <div class="mb-0">
                                        <label asp-for="NewSubItem.ProductGroupId" class="form-label"></label>
                                        <select asp-for="NewSubItem.ProductGroupId" class="form-select" asp-items="Model.NewSubItem.ProductGroups">
                                            <option value="">Akışkan seçin</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="subitem-section tank-only-fields">
                                    <div class="subitem-section-title">B) Tank için temel bilgiler</div>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label asp-for="NewSubItem.CapacityM3" class="form-label"></label>
                                            <input asp-for="NewSubItem.CapacityM3" class="form-control" />
                                        </div>
