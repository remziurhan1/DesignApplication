                                            <label asp-for="NewSubItem.PlacementType" class="form-label"></label>
                                            <select asp-for="NewSubItem.PlacementType" asp-items="Html.GetEnumSelectList<PlacementType>()" class="form-select"></select>
                                        </div>
                                    </div>
                                </div>

                                <div class="subitem-section non-spare-fields">
                                    <div class="subitem-section-title">B) Basınç ve standart bilgileri</div>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label asp-for="NewSubItem.DesignPressureBar" class="form-label"></label>
                                            <input asp-for="NewSubItem.DesignPressureBar" class="form-control" />
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="NewSubItem.DesignStandardCode" class="form-label"></label>
                                            <input asp-for="NewSubItem.DesignStandardCode" class="form-control" />
                                        </div>
                                    </div>
                                </div>

                                <div class="subitem-section tank-fields">
                                    <div class="subitem-section-title">C) Tank tipi</div>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label asp-for="NewSubItem.TankType" class="form-label"></label>
                                            <select asp-for="NewSubItem.TankType" asp-items="Html.GetEnumSelectList<RequestTankType>()" class="form-select subitem-tank-type"></select>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="NewSubItem.StorageOption" class="form-label"></label>
                                            <select asp-for="NewSubItem.StorageOption" asp-items="Html.GetEnumSelectList<RequestStorageOption>()" class="form-select subitem-storage-option"></select>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="NewSubItem.TransportOption" class="form-label"></label>
                                            <select asp-for="NewSubItem.TransportOption" asp-items="Html.GetEnumSelectList<RequestTransportOption>()" class="form-select subitem-transport-option"></select>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="NewSubItem.StdOpsSelection" class="form-label"></label>
                                            <select asp-for="NewSubItem.StdOpsSelection" asp-items="Html.GetEnumSelectList<RequestStdOpsSelection>()" class="form-select"></select>
                                        </div>
                                        <div class="col-12">
                                            <label asp-for="NewSubItem.SpcTechnicalDetails" class="form-label"></label>
                                            <input asp-for="NewSubItem.SpcTechnicalDetails" class="form-control" />
                                        </div>
                                    </div>
                                </div>

                                <div class="subitem-section tank-only-fields">
                                    <div class="subitem-section-title">D) Varsa tüketim</div>
                                    <div class="form-check mb-3">
                                        <input asp-for="NewSubItem.HasTankConsumptionCapacity" class="form-check-input subitem-consumption-toggle" />
                                        <label asp-for="NewSubItem.HasTankConsumptionCapacity" class="form-check-label"></label>
                                    </div>
                                    <label asp-for="NewSubItem.ConsumptionCapacity" class="form-label"></label>
                                    <input asp-for="NewSubItem.ConsumptionCapacity" class="form-control subitem-consumption-input" />
                                </div>

                                <div class="subitem-section evap-fields">
                                    <div class="subitem-section-title">B) Evaporatör ortam bilgisi</div>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label asp-for="NewSubItem.AmbientTemperatureMin" class="form-label"></label>
                                            <input asp-for="NewSubItem.AmbientTemperatureMin" class="form-control" />
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="NewSubItem.AmbientTemperatureMax" class="form-label"></label>
                                            <input asp-for="NewSubItem.AmbientTemperatureMax" class="form-control" />
                                        </div>
                                    </div>
                                </div>

                                <div class="subitem-section facility-fields">
                                    <div class="subitem-section-title">B) Tesis giriş/çıkış bilgileri</div>
                                    <div class="row g-3">
                                        <div class="col-12"><label asp-for="NewSubItem.FacilityType" class="form-label"></label><input asp-for="NewSubItem.FacilityType" class="form-control" /></div>
                                        <div class="col-md-6"><label asp-for="NewSubItem.FacilityInletPressureBar" class="form-label"></label><input asp-for="NewSubItem.FacilityInletPressureBar" class="form-control" /></div>
