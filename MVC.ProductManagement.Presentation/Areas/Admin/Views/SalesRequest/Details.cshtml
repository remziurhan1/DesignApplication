                                        <div class="col-12"><label asp-for="NewSubItem.MinimumTechnicalNotes" class="form-label"></label><textarea asp-for="NewSubItem.MinimumTechnicalNotes" class="form-control" rows="3"></textarea></div>
                                    </div>
                                </div>

                                <button class="btn btn-outline-primary w-100" type="submit">Alt talep ekle</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const subCategoryTank = '@((int)SalesRequestCategory.Tank)';
        const subCategoryEvap = '@((int)SalesRequestCategory.Evaporator)';
        const subCategoryFacility = '@((int)SalesRequestCategory.Facility)';
        const subCategorySparePart = '@((int)SalesRequestCategory.SparePart)';
        const subTankTypeStorage = '@((int)RequestTankType.Storage)';

        const subitemForm = document.getElementById('subitem-form');

        function toggleSubitemCategoryFields() {
            if (!subitemForm) return;

            const categoryValue = subitemForm.querySelector('.subitem-category')?.value;
            const showTank = categoryValue === subCategoryTank;
            const showEvap = categoryValue === subCategoryEvap;
            const showFacility = categoryValue === subCategoryFacility;
            const showSparePart = categoryValue === subCategorySparePart;

            subitemForm.querySelectorAll('.tank-fields').forEach(x => x.style.display = showTank ? '' : 'none');
            subitemForm.querySelectorAll('.tank-only-fields').forEach(x => x.style.display = showTank ? '' : 'none');
            subitemForm.querySelectorAll('.evap-fields').forEach(x => x.style.display = showEvap ? '' : 'none');
            subitemForm.querySelectorAll('.facility-fields').forEach(x => x.style.display = showFacility ? '' : 'none');
            subitemForm.querySelectorAll('.spare-fields').forEach(x => x.style.display = showSparePart ? '' : 'none');
            subitemForm.querySelectorAll('.non-spare-fields').forEach(x => x.style.display = showSparePart ? 'none' : '');
            toggleSubitemTankTypeFields();
        }

        function toggleSubitemTankTypeFields() {
            if (!subitemForm) return;

            const tankType = subitemForm.querySelector('.subitem-tank-type');
            const storage = subitemForm.querySelector('.subitem-storage-option');
            const transport = subitemForm.querySelector('.subitem-transport-option');
            if (!tankType || !storage || !transport) return;

            if (tankType.value === subTankTypeStorage) {
                transport.value = '';
                transport.disabled = true;
                storage.disabled = false;
            } else if (tankType.value) {
                storage.value = '';
                storage.disabled = true;
                transport.disabled = false;
            } else {
                storage.disabled = false;
                transport.disabled = false;
            }
        }

        function toggleSubitemConsumptionCapacity() {
            if (!subitemForm) return;

            const checkbox = subitemForm.querySelector('.subitem-consumption-toggle');
            const input = subitemForm.querySelector('.subitem-consumption-input');
            if (!checkbox || !input) return;

            input.disabled = !checkbox.checked;
            if (!checkbox.checked) {
                input.value = '';
            }
        }

        if (subitemForm) {
            subitemForm.querySelector('.subitem-category')?.addEventListener('change', toggleSubitemCategoryFields);
            subitemForm.querySelector('.subitem-tank-type')?.addEventListener('change', toggleSubitemTankTypeFields);
            subitemForm.querySelector('.subitem-consumption-toggle')?.addEventListener('change', toggleSubitemConsumptionCapacity);
            toggleSubitemCategoryFields();
            toggleSubitemConsumptionCapacity();
        }
    </script>
}
