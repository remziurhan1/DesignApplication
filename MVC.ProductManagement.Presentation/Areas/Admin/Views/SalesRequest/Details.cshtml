                                        <div class="col-md-6"><label asp-for="NewSubItem.PumpDetails" class="form-label"></label><input asp-for="NewSubItem.PumpDetails" class="form-control" /></div>
                                        <div class="col-md-6"><label asp-for="NewSubItem.ElectricHeaterDetails" class="form-label"></label><input asp-for="NewSubItem.ElectricHeaterDetails" class="form-control" /></div>
