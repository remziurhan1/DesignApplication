@model MVC.ProductManagement.Presentation.Areas.Admin.Models.AD2000CalculationVMs.AD2000ResultVM
@{
    ViewData["Title"] = "AD2000 Result";
}

<h2>AD2000 Sonuç</h2>
<div class="card">
    <div class="card-body">
        <h5 class="mb-3">Giriş Değerleri</h5>
        <div class="row">
            <div class="col-md-6">
                <p><strong>Tank:</strong> @Model.Name</p>
                <p><strong>Çap:</strong> @Model.Diameter.ToString("F2") mm</p>
                <p><strong>Silindir Boyu:</strong> @Model.ShellLength.ToString("F2") mm</p>
                <p><strong>Dizayn Basıncı:</strong> @Model.DesignPressure.ToString("F2") bar</p>
                <p><strong>Dizayn Sıcaklığı:</strong> @Model.DesignTemperatureMin °C / @Model.DesignTemperatureMax °C</p>
                <p><strong>Korozyon Payı:</strong> @Model.CorrosionAllowance.ToString("F2") mm</p>
            </div>
            <div class="col-md-6">
                <p><strong>Kaynak Faktörü (z):</strong> @Model.WeldJointFactor.ToString("F2")</p>
                <p><strong>Beta:</strong> @Model.Beta.ToString("F2")</p>
                <p><strong>Tank Yönelimi:</strong> @Model.TankOrientation</p>
                <p><strong>Sıvı Yoğunluğu:</strong> @Model.LiquidDensity.ToString("F2") kg/m³</p>
                <p><strong>Statik Basınç:</strong> @Model.StaticPressure.ToString("F3") bar</p>
                <p><strong>Interpolasyon Sıcaklığı (Dizayn Max):</strong> @Model.DesignTemperatureMax.ToString("F2") °C</p>
                <p><strong>Tahmini Gövde Et:</strong> @Model.EstimatedShellThickness.ToString("F2") mm</p>
                <p><strong>Tahmini Bombe Et:</strong> @Model.EstimatedHeadThickness.ToString("F2") mm</p>
                <p><strong>Gövde Akma Dayanımı:</strong> @Model.ShellAllowableStress.ToString("F2") MPa</p>
                <p><strong>Bombe Akma Dayanımı:</strong> @Model.HeadAllowableStress.ToString("F2") MPa</p>
            </div>
        </div>

        <hr />
        <h5 class="mb-3">Çıkış Değerleri</h5>
        <p><strong>Hesaplanan Gövde Et:</strong> @Model.ShellThickness.ToString("F2") mm</p>
        <p><strong>Seçilen Gövde Et:</strong> @Model.RoundedShellThickness.ToString("F2") mm</p>
        <p><strong>Hesaplanan Bombe Et:</strong> @Model.HeadThickness.ToString("F2") mm</p>
        <p><strong>Seçilen Bombe Et:</strong> @Model.RoundedHeadThickness.ToString("F2") mm</p>
        <p><strong>Test Basıncı:</strong> @Model.TestPressure.ToString("F2") bar</p>

        <form asp-action="Save" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(x => x.Id)
            @Html.HiddenFor(x => x.Name)
            @Html.HiddenFor(x => x.Diameter)
            @Html.HiddenFor(x => x.ShellLength)
            @Html.HiddenFor(x => x.DesignPressure)
            @Html.HiddenFor(x => x.DesignTemperatureMin)
            @Html.HiddenFor(x => x.DesignTemperatureMax)
            @Html.HiddenFor(x => x.CorrosionAllowance)
            @Html.HiddenFor(x => x.WeldJointFactor)
            @Html.HiddenFor(x => x.AllowableStress)
            @Html.HiddenFor(x => x.ShellAllowableStress)
            @Html.HiddenFor(x => x.HeadAllowableStress)
            @Html.HiddenFor(x => x.EstimatedShellThickness)
            @Html.HiddenFor(x => x.EstimatedHeadThickness)
            @Html.HiddenFor(x => x.Beta)
            @Html.HiddenFor(x => x.TankOrientation)
            @Html.HiddenFor(x => x.StorageTypeId)
            @Html.HiddenFor(x => x.IsManualDensity)
            @Html.HiddenFor(x => x.LiquidDensity)
            @Html.HiddenFor(x => x.StaticPressure)
            @Html.HiddenFor(x => x.ShellMaterialId)
            @Html.HiddenFor(x => x.ShellMaterialFormId)
            @Html.HiddenFor(x => x.HeadMaterialId)
            @Html.HiddenFor(x => x.HeadMaterialFormId)
            @Html.HiddenFor(x => x.ShellThickness)
            @Html.HiddenFor(x => x.HeadThickness)
            @Html.HiddenFor(x => x.RoundedShellThickness)
            @Html.HiddenFor(x => x.RoundedHeadThickness)
            @Html.HiddenFor(x => x.TestPressure)
            <button type="submit" class="btn btn-primary">Kaydet</button>
        </form>
        <a asp-action="Calculate" class="btn btn-secondary">Yeni Hesap</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Kayıt Listesi</a>
    </div>
</div>
