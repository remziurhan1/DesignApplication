@model MVC.ProductManagement.Presentation.Areas.Admin.Models.AD2000CalculationVMs.AD2000ResultVM
@using System
@using System.Globalization
@using System.Linq
@using System.Collections.Generic
@{
    ViewData["Title"] = "AD2000 Cost";
    var totalWeld = Model.WeldLength1500 + Model.WeldLength2000 + Model.WeldLength3000 + Model.WeldLength4000;
}

@section Styles {
    <link rel="stylesheet" href="~/css/en13458.css" asp-append-version="true" />
}

<div class="en-page">
    <section class="en-hero">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <span class="en-kicker"><i class="bi bi-cash-stack"></i> AD2000 maliyet görünümü</span>
                <h2>AD2000 maliyet hazırlık ekranı</h2>
                <p class="mb-0">Bu ekran, AD2000 hesabından çıkan üretim ve maliyet sürücülerini aynı EN13458 akış mantığıyla okunabilir bir düzende sunar.</p>
            </div>
            <div class="col-lg-4">
                <div class="en-hero-actions">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light"><i class="bi bi-arrow-left me-1"></i>Detay</a>
                    <a asp-action="Index" class="btn btn-outline-light"><i class="bi bi-list-ul me-1"></i>Liste</a>
                </div>
            </div>
        </div>
    </section>

    <div class="en-metric-grid">
        <div class="en-metric-card"><span class="en-metric-label">Yüzey Alanı</span><div class="en-metric-value">@Model.SurfaceArea.ToString("N2") m²</div></div>
        <div class="en-metric-card"><span class="en-metric-label">Toplam Kaynak</span><div class="en-metric-value">@totalWeld.ToString("N2") mm</div></div>
        <div class="en-metric-card"><span class="en-metric-label">Gövde Seçili Et</span><div class="en-metric-value">@Model.RoundedShellThickness.ToString("N2") mm</div></div>
        <div class="en-metric-card"><span class="en-metric-label">Bombe Seçili Et</span><div class="en-metric-value">@Model.RoundedHeadThickness.ToString("N2") mm</div></div>
    </div>

    <div class="row g-4">
        <div class="col-xl-6">
            <div class="card h-100 border-primary-subtle">
                <div class="card-header bg-primary-subtle text-primary-emphasis">Maliyet etkileyen ana girdiler</div>
                <div class="card-body p-0">
                    <table class="table table-striped align-middle mb-0"><tbody>
                        <tr><th>Gövde Malzemesi</th><td>@Model.ShellMaterialName</td></tr>
                        <tr><th>Gövde Formu</th><td>@Model.ShellMaterialFormName</td></tr>
                        <tr><th>Bombe Malzemesi</th><td>@Model.HeadMaterialName</td></tr>
                        <tr><th>Bombe Formu</th><td>@Model.HeadMaterialFormName</td></tr>
                        <tr><th>Dizayn Basıncı</th><td>@Model.DesignPressure.ToString("N2") bar</td></tr>
                        <tr><th>Statik Basınç</th><td>@Model.StaticPressure.ToString("N3") bar</td></tr>
                        <tr><th>Sıvı Yoğunluğu</th><td>@Model.LiquidDensity.ToString("N2") kg/m³</td></tr>
                        <tr><th>Yüzey Alanı</th><td>@Model.SurfaceArea.ToString("N2") m²</td></tr>
                    </tbody></table>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card h-100 border-success-subtle">
                <div class="card-header bg-success-subtle text-success-emphasis">Üretim hazırlık özeti</div>
                <div class="card-body p-0">
                    <table class="table table-striped align-middle mb-0"><tbody>
                        <tr><th>Hesaplanan Gövde Et</th><td>@Model.ShellThickness.ToString("N2") mm</td></tr>
                        <tr><th>Seçilen Gövde Et</th><td>@Model.RoundedShellThickness.ToString("N2") mm</td></tr>
                        <tr><th>Hesaplanan Bombe Et</th><td>@Model.HeadThickness.ToString("N2") mm</td></tr>
                        <tr><th>Seçilen Bombe Et</th><td>@Model.RoundedHeadThickness.ToString("N2") mm</td></tr>
                        <tr><th>Test Basıncı</th><td>@Model.TestPressure.ToString("N2") bar</td></tr>
                        <tr><th>Tank Yönelimi</th><td>@Model.TankOrientation</td></tr>
                        <tr><th>Tanımlı Sıvı</th><td>@(!string.IsNullOrWhiteSpace(Model.StorageTypeName) ? Model.StorageTypeName : "Manuel yoğunluk")</td></tr>
                        <tr><th>Korozyon Payı</th><td>@Model.CorrosionAllowance.ToString("N2") mm</td></tr>
                    </tbody></table>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header bg-light">Kaynak ve sac planı</div>
        <div class="card-body">
            <div class="row g-3 mb-4">
                <div class="col-md-3"><div class="en-metric-card h-100"><span class="en-metric-label">1500 Kaynak</span><div class="en-metric-value">@Model.WeldLength1500.ToString("N2")</div></div></div>
                <div class="col-md-3"><div class="en-metric-card h-100"><span class="en-metric-label">2000 Kaynak</span><div class="en-metric-value">@Model.WeldLength2000.ToString("N2")</div></div></div>
                <div class="col-md-3"><div class="en-metric-card h-100"><span class="en-metric-label">3000 Kaynak</span><div class="en-metric-value">@Model.WeldLength3000.ToString("N2")</div></div></div>
                <div class="col-md-3"><div class="en-metric-card h-100"><span class="en-metric-label">4000 Kaynak</span><div class="en-metric-value">@Model.WeldLength4000.ToString("N2")</div></div></div>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Sektör Genişliği</th>
                            <th>Parça Adedi</th>
                            <th>Sac Açınımı</th>
                            <th>Kesim Listesi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sectorWidth in new[] { 1500d, 2000d, 3000d, 4000d })
                        {
                            var plan = BuildSectorPlan(Model.ShellLength, sectorWidth);
                            var developedLength = Math.Round(Math.PI * Model.Diameter, 2);
                            var cutList = string.Join(" + ", plan.Widths.Select(w => $"{Model.RoundedShellThickness.ToString("0.##", CultureInfo.InvariantCulture)} x {w.ToString("0.##", CultureInfo.InvariantCulture)} x {developedLength.ToString("0.##", CultureInfo.InvariantCulture)}"));
                            <tr>
                                <td>@sectorWidth.ToString("0", CultureInfo.InvariantCulture) mm</td>
                                <td>@plan.PieceCount adet</td>
                                <td>@developedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td>
                                <td>@cutList</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@functions {
    private static (int PieceCount, List<double> Widths) BuildSectorPlan(double shellLength, double sectorWidth)
    {
        if (shellLength <= 0 || sectorWidth <= 0)
        {
            return (0, new List<double>());
        }

        var pieceCount = (int)Math.Ceiling(shellLength / sectorWidth);
        var widths = new List<double>(pieceCount);

        for (var i = 0; i < pieceCount; i++)
        {
            var remaining = shellLength - (i * sectorWidth);
            widths.Add(Math.Round(Math.Min(sectorWidth, Math.Max(0, remaining)), 2));
        }

        return (pieceCount, widths);
    }
}
