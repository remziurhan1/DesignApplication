@model MVC.ProductManagement.Presentation.Areas.Admin.Models.AD2000CalculationVMs.AD2000ResultVM
@using System.Globalization
@using System.Collections.Generic
@{
    ViewData["Title"] = "AD2000 Details";
}

<h2>AD2000 Detay</h2>
<div class="card">
    <div class="card-body">
        <h5 class="mb-3">Kimlik</h5>
        <p><strong>Kayıt Id:</strong> @Model.Id</p>
        <p><strong>Tank:</strong> @Model.Name</p>

        <hr />
        <h5 class="mb-3">Giriş Değerleri</h5>
        <p><strong>Çap:</strong> @Model.Diameter.ToString("F2") mm</p>
        <p><strong>Gövde Boyu:</strong> @Model.ShellLength.ToString("F2") mm</p>
        <p><strong>Dizayn Basıncı:</strong> @Model.DesignPressure.ToString("F2") bar</p>
        <p><strong>Dizayn Sıcaklığı Min:</strong> @Model.DesignTemperatureMin.ToString("F2") °C</p>
        <p><strong>Dizayn Sıcaklığı Max:</strong> @Model.DesignTemperatureMax.ToString("F2") °C</p>
        <p><strong>Korozyon Payı:</strong> @Model.CorrosionAllowance.ToString("F2") mm</p>
        <p><strong>Kaynak Faktörü:</strong> @Model.WeldJointFactor.ToString("F2")</p>
        <p><strong>İzin Verilebilir Gerilme:</strong> @Model.AllowableStress.ToString("F2") MPa</p>
        <p><strong>Gövde Akma Dayanımı:</strong> @Model.ShellAllowableStress.ToString("F2") MPa</p>
        <p><strong>Bombe Akma Dayanımı:</strong> @Model.HeadAllowableStress.ToString("F2") MPa</p>
        <p><strong>Beta:</strong> @Model.Beta.ToString("F2")</p>
        <p><strong>Tank Yönelimi:</strong> @Model.TankOrientation</p>
        <p><strong>Tanımlı Sıvı Id:</strong> @(Model.StorageTypeId?.ToString() ?? "-")</p>
        <p><strong>Manuel Yoğunluk:</strong> @(Model.IsManualDensity ? "Evet" : "Hayır")</p>
        <p><strong>Sıvı Yoğunluğu:</strong> @Model.LiquidDensity.ToString("F2") kg/m³</p>
        <p><strong>Statik Basınç:</strong> @Model.StaticPressure.ToString("F3") bar</p>
        <p><strong>Tahmini Gövde Et:</strong> @Model.EstimatedShellThickness.ToString("F2") mm</p>
        <p><strong>Tahmini Bombe Et:</strong> @Model.EstimatedHeadThickness.ToString("F2") mm</p>
        <p><strong>Gövde Malzeme Id:</strong> @Model.ShellMaterialId</p>
        <p><strong>Gövde Form Id:</strong> @Model.ShellMaterialFormId</p>
        <p><strong>Bombe Malzeme Id:</strong> @Model.HeadMaterialId</p>
        <p><strong>Bombe Form Id:</strong> @Model.HeadMaterialFormId</p>

        <hr />
        <h5 class="mb-3">Hesap Sonuçları</h5>
        <p><strong>Hesaplanan Gövde Et:</strong> @Model.ShellThickness.ToString("F2") mm</p>
        <p><strong>Hesaplanan Bombe Et:</strong> @Model.HeadThickness.ToString("F2") mm</p>
        <p><strong>Seçilen Gövde Et:</strong> @Model.RoundedShellThickness.ToString("F2") mm</p>
        <p><strong>Seçilen Bombe Et:</strong> @Model.RoundedHeadThickness.ToString("F2") mm</p>
        <p><strong>Test Basıncı:</strong> @Model.TestPressure.ToString("F2") bar</p>
        <p><strong>Kaynak Metrajı (1500):</strong> @Model.WeldLength1500.ToString("F2") mm</p>
        <p><strong>Kaynak Metrajı (2000):</strong> @Model.WeldLength2000.ToString("F2") mm</p>
        <p><strong>Kaynak Metrajı (3000):</strong> @Model.WeldLength3000.ToString("F2") mm</p>
        <p><strong>Kaynak Metrajı (4000):</strong> @Model.WeldLength4000.ToString("F2") mm</p>
        <p><strong>Yüzey Alanı:</strong> @Model.SurfaceArea.ToString("F2") m²</p>


        <hr />
        <h5 class="mb-3">Sac Oryantasyonu (Sektör Bazlı)</h5>
        <p class="text-muted mb-2">Format: <strong>Et (mm) x Sektör Genişliği (mm) x Sac Açınımı (mm)</strong></p>
        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Sektör Genişliği</th>
                        <th>Parça Adedi</th>
                        <th>Sac Açınımı</th>
                        <th>Kesim Listesi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sectorWidth in new[] { 1500d, 2000d, 3000d, 4000d })
                    {
                        var plan = BuildSectorPlan(Model.ShellLength, sectorWidth);
                        var developedLength = Math.Round(Math.PI * Model.Diameter, 2);
                        var cutList = string.Join(" + ", plan.Widths.Select(w => $"{Model.RoundedShellThickness.ToString("0.##", CultureInfo.InvariantCulture)} x {w.ToString("0.##", CultureInfo.InvariantCulture)} x {developedLength.ToString("0.##", CultureInfo.InvariantCulture)}"));

                        <tr>
                            <td>@sectorWidth.ToString("0", CultureInfo.InvariantCulture) mm</td>
                            <td>@plan.PieceCount adet</td>
                            <td>@developedLength.ToString("0.##", CultureInfo.InvariantCulture) mm</td>
                            <td>@cutList</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
    </div>
</div>


@functions {
    private static (int PieceCount, List<double> Widths) BuildSectorPlan(double shellLength, double sectorWidth)
    {
        if (shellLength <= 0 || sectorWidth <= 0)
        {
            return (0, new List<double>());
        }

        var pieceCount = (int)Math.Ceiling(shellLength / sectorWidth);
        var widths = new List<double>(pieceCount);

        for (var i = 0; i < pieceCount; i++)
        {
            var remaining = shellLength - (i * sectorWidth);
            widths.Add(Math.Round(Math.Min(sectorWidth, Math.Max(0, remaining)), 2));
        }

        return (pieceCount, widths);
    }
}
