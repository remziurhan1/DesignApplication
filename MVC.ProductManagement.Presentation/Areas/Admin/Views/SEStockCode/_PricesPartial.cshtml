@using MVC.ProductManagement.Application.DTOs.StockCodes.OrtakKlasör

@{
    var stockCardId = (Guid)ViewData.Model.GetType().GetProperty("StockCardId").GetValue(ViewData.Model, null);
    var priceHistory = ViewData.Model.GetType().GetProperty("PriceHistory").GetValue(ViewData.Model, null) as IReadOnlyList<PriceDto>;
    var activePrice = ViewData.Model.GetType().GetProperty("ActivePrice").GetValue(ViewData.Model, null) as ActivePriceDto;
}

<div class="row">
    <div class="col-md-4">
        <div class="card shadow-sm border-success mb-4">
            <div class="card-header bg-success text-white"><h5 class="mb-0">Aktif Fiyat</h5></div>
            <div class="card-body text-center">
                @if (activePrice != null)
                {
                    <h1 class="display-4 text-success fw-bold mb-2">@activePrice.UnitPrice.ToString("N2") <small class="text-muted fs-4">@activePrice.Currency</small></h1>
                    <p class="text-muted mb-0">Birim Fiyat</p>
                }
                else
                {
                    <p class="text-muted">Aktif fiyat yok.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Fiyat Geçmişi</h5>
                <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addPriceModal">Yeni Fiyat</button>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped mb-0">
                    <thead><tr><th>Birim Fiyat</th><th>PB</th><th>Geçerlilik</th><th>Aktif</th><th></th></tr></thead>
                    <tbody>
                    @if (priceHistory != null)
                    {
                        foreach (var price in priceHistory)
                        {
                            <tr>
                                <td>@price.UnitPrice.ToString("N2")</td>
                                <td>@price.Currency</td>
                                <td>@price.ValidFrom.ToString("dd.MM.yyyy") - @(price.ValidTo?.ToString("dd.MM.yyyy") ?? "Süresiz")</td>
                                <td>@(price.IsActive ? "Evet" : "Hayır")</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" onclick="editPrice('@price.Id','@price.UnitPrice','@price.ValidFrom.ToString("yyyy-MM-dd")','@(price.ValidTo?.ToString("yyyy-MM-dd"))','@price.Notes')">Düzenle</button>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addPriceModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5>Yeni Fiyat</h5></div><form asp-action="CreatePrice" method="post"><div class="modal-body">@Html.AntiForgeryToken()<input type="hidden" name="StockCardId" value="@stockCardId" /><div class="mb-2"><label>Birim Fiyat</label><input class="form-control" name="UnitPrice" type="number" step="0.0001" required /></div><input type="hidden" name="Currency" value="EUR" /><div class="mb-2"><label>Para Birimi</label><input class="form-control" value="EUR" disabled /></div><div class="mb-2"><label>Valid From</label><input class="form-control" name="ValidFrom" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" /></div><div class="mb-2"><label>Valid To</label><input class="form-control" name="ValidTo" type="date" /></div><div class="mb-2"><label>Not</label><input class="form-control" name="Notes" /></div></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal" type="button">Kapat</button><button class="btn btn-primary" type="submit">Kaydet</button></div></form></div></div></div>

<div class="modal fade" id="editPriceModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5>Fiyat Düzenle</h5></div><form asp-action="UpdatePrice" method="post"><div class="modal-body">@Html.AntiForgeryToken()<input type="hidden" name="stockCardId" value="@stockCardId" /><input type="hidden" name="Id" id="editPriceId" /><div class="mb-2"><label>Birim Fiyat</label><input class="form-control" name="UnitPrice" id="editUnitPrice" type="number" step="0.0001" required /></div><div class="mb-2"><label>Valid From</label><input class="form-control" name="ValidFrom" id="editValidFrom" type="date" /></div><div class="mb-2"><label>Valid To</label><input class="form-control" name="ValidTo" id="editValidTo" type="date" /></div><div class="mb-2"><label>Not</label><input class="form-control" name="Notes" id="editNotes" /></div><div class="form-check"><input class="form-check-input" type="checkbox" name="IsActive" value="true" checked /><label class="form-check-label">Aktif</label></div></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal" type="button">Kapat</button><button class="btn btn-primary" type="submit">Güncelle</button></div></form></div></div></div>

@section Scripts {
<script>
function editPrice(id, unitPrice, validFrom, validTo, notes) {
    document.getElementById('editPriceId').value = id;
    document.getElementById('editUnitPrice').value = unitPrice;
    document.getElementById('editValidFrom').value = validFrom;
    document.getElementById('editValidTo').value = validTo;
    document.getElementById('editNotes').value = notes;
    const modal = new bootstrap.Modal(document.getElementById('editPriceModal'));
    modal.show();
}
</script>
}
