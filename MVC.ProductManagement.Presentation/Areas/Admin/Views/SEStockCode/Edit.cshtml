@model MVC.ProductManagement.Application.DTOs.StockCodes.SE.SEStockCardUpdateDto

@{
    ViewData["Title"] = "SE Stok Kodu Düzenle";
    var formData = ViewBag.FormData as MVC.ProductManagement.Application.DTOs.StockCodes.SE.StockCodeSeFormDto;
    var currentSelections = ViewBag.CurrentSelections as Dictionary<Guid, Guid>;
    var stockCode = ViewBag.CurrentStockCode as string;
    var productCode = ViewBag.CurrentProductCode as string;
    var productName = ViewBag.CurrentProductName as string;
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-8">
            <h2>
                <i class="bi bi-pencil-square text-warning"></i>
                Stok Kodu Düzenle
            </h2>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Detail" asp-route-id="@Model.StockCardId" class="btn btn-secondary">
                <i class="bi bi-x-circle"></i> İptal
            </a>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <strong>Hata!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <strong>Başarılı!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- MEVCUT STOK KODU -->
    <div class="card mb-4 shadow-sm border-warning">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">
                <i class="bi bi-tag-fill"></i>
                <strong>@stockCode</strong>
            </h4>
        </div>
        <div class="card-body">
            <p class="mb-0">
                <strong>Ürün:</strong> @productCode - @productName
            </p>
            <small class="text-muted">
                <i class="bi bi-info-circle"></i>
                Stok kodu değiştirilemez. Sadece özellikler güncellenebilir. Sabit değerler otomatik korunur.
            </small>
        </div>
    </div>

    <!-- DÜZENLEME FORMU (Rule-Based) -->
    <form asp-action="Edit" asp-route-id="@Model.StockCardId" method="post" id="editForm">
        @Html.AntiForgeryToken()

        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <i class="bi bi-sliders"></i> <strong>Ürün Özellikleri</strong>
            </div>
            <div class="card-body">
                @if (formData != null && formData.Features != null && formData.Features.Any())
                {
                    <div class="row g-3">
                        @foreach (var feature in formData.Features)
                        {
                            <div class="col-md-6">
                                <div class="card h-100 @(feature.IsFixed ? "border-success" : "border-primary")">
                                    <div class="card-body">
                                        <label class="form-label fw-bold">
                                            @if (feature.IsFixed)
                                            {
                                                <span class="badge bg-success me-1">
                                                    <i class="bi bi-lock-fill"></i> Sabit
                                                </span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-tag text-primary"></i>
                                            }
                                            @feature.FeatureName
                                            @if (!feature.IsFixed)
                                            {
                                                <span class="text-danger">*</span>
                                            }
                                        </label>

                                        @if (feature.IsFixed)
                                        {
                                            <input type="text"
                                                   class="form-control bg-light text-muted"
                                                   value="@feature.FixedValueCode - @feature.FixedValueName"
                                                   disabled
                                                   style="font-weight: 500; border: 2px solid #198754;" />
                                            <small class="text-muted">
                                                <i class="bi bi-info-circle"></i>
                                                Bu değer otomatik olarak korunur.
                                            </small>
                                        }
                                        else
                                        {
                                            <select name="FeatureSelections[@feature.FeatureId]"
                                                    class="form-select form-select-lg feature-select"
                                                    required>
                                                <option value="">-- Seçiniz --</option>
                                                @foreach (var value in feature.AvailableValues)
                                                {
                                                    var isSelected = currentSelections != null
                                                    && currentSelections.ContainsKey(feature.FeatureId)
                                                    && currentSelections[feature.FeatureId] == value.Id;

                                                    <option value="@value.Id" selected="@isSelected">
                                                        @value.Code@((!string.IsNullOrEmpty(value.Name) && value.Code != value.Name) ? $" - {value.Name}" : "")
                                                    </option>
                                                }
                                            </select>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        Bu ürün için tanımlı feature bulunamadı.
                    </div>
                }
            </div>
        </div>

        <div class="row mt-4 mb-5">
            <div class="col-12 text-center">
                <button type="submit" class="btn btn-success btn-lg me-2">
                    <i class="bi bi-check-circle"></i> Güncelle
                </button>
                <a asp-action="Detail" asp-route-id="@Model.StockCardId" class="btn btn-secondary btn-lg">
                    <i class="bi bi-x-circle"></i> İptal
                </a>
            </div>
        </div>
    </form>

    <div class="mb-5 pb-5"></div>
</div>

@section Scripts {
    <script>
        document.getElementById('editForm').addEventListener('submit', function(e) {
            const confirmResult = confirm('Stok kodunu güncellemek istediğinize emin misiniz?\n\nDescription otomatik olarak yeniden oluşturulacaktır.');
            if (!confirmResult) {
                e.preventDefault();
                return false;
            }
            window.onbeforeunload = null;
        });

        let initialValues = {};
        let formSubmitted = false;

        document.querySelectorAll('select.feature-select').forEach(select => {
            initialValues[select.name] = select.value;
        });

        window.addEventListener('beforeunload', function(e) {
            if (formSubmitted) return undefined;

            let hasChanges = false;
            document.querySelectorAll('select.feature-select').forEach(select => {
                if (select.value !== initialValues[select.name]) hasChanges = true;
            });

            if (hasChanges) {
                e.preventDefault();
                e.returnValue = 'Kaydedilmemiş değişiklikler var.';
                return e.returnValue;
            }
        });

        document.getElementById('editForm').addEventListener('submit', function() {
            formSubmitted = true;
        });

        document.querySelectorAll('select.feature-select').forEach(select => {
            select.addEventListener('change', function() {
                this.classList.toggle('is-valid', !!this.value);
            });
            if (select.value) select.classList.add('is-valid');
        });
    </script>
}
