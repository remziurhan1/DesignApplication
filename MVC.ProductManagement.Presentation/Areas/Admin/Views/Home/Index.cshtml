@model MVC.ProductManagement.Presentation.Areas.Admin.Models.Home.TechnicalDashboardVm
@{
    ViewData["Title"] = "Teknik Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="pagetitle">
    <h1>Teknik Dashboard</h1>
    <p class="text-muted mb-0">Satışçı bilgileri yerine teknik hesap ve referans veri özetleri.</p>
</div>

<section class="section mt-3">
    <div class="row g-3 mb-3">
        <div class="col-md-3"><div class="card"><div class="card-body py-3 text-center"><small class="text-muted d-block">Toplam Teknik Kayıt</small><h4 class="mb-0">@Model.TotalTechnicalRecordCount</h4></div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body py-3 text-center"><small class="text-muted d-block">EN 13458 Hesap</small><h4 class="mb-0 text-primary">@Model.En13458CalculationCount</h4></div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body py-3 text-center"><small class="text-muted d-block">AD 2000 Hesap</small><h4 class="mb-0 text-primary">@Model.Ad2000CalculationCount</h4></div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body py-3 text-center"><small class="text-muted d-block">Malzeme</small><h4 class="mb-0 text-success">@Model.MaterialCount</h4></div></div></div>
    </div>

    <div class="row g-3">
        <div class="col-md-3"><div class="card"><div class="card-body py-3 text-center"><small class="text-muted d-block">Malzeme Formu</small><h4 class="mb-0">@Model.MaterialFormCount</h4></div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body py-3 text-center"><small class="text-muted d-block">Yield Strength</small><h4 class="mb-0">@Model.YieldStrengthCount</h4></div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body py-3 text-center"><small class="text-muted d-block">Allowable Stress</small><h4 class="mb-0">@Model.AllowableStressCount</h4></div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body py-3 text-center"><small class="text-muted d-block">Storage Type</small><h4 class="mb-0">@Model.StorageTypeCount</h4></div></div></div>
    </div>

    <div class="card mt-3">
        <div class="card-body pt-4">
            <h5 class="card-title">Teknik Veri Özeti</h5>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>Termodinamik Özellik Satırı</span>
                    <span class="badge bg-secondary rounded-pill">@Model.ThermodynamicPropertyCount</span>
                </li>
                <li class="list-group-item text-muted small">
                    Bu panel yalnızca teknik modüllerin özetini gösterir; satışçı dağılım tablosu kaldırılmıştır.
                </li>
            </ul>
        </div>
    </div>
</section>
