@model MVC.ProductManagement.Presentation.Areas.Admin.Models.SalesRequestVMs.SalesDashboardVm
@{
    ViewData["Title"] = "Satış Talep İstatistikleri";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="pagetitle">
    <h1>Satış Talep İstatistikleri</h1>
    <p class="text-muted mb-0">Tüm satışçıların talep, revizyon ve teklif ilerleme durumları.</p>
</div>

<section class="section mt-3">
    <div class="row g-3 mb-3">
        <div class="col-md-2"><div class="card"><div class="card-body py-3 text-center"><small class="text-muted d-block">Toplam Talep</small><h4 class="mb-0">@Model.TotalRequestCount</h4></div></div></div>
        <div class="col-md-2"><div class="card"><div class="card-body py-3 text-center"><small class="text-muted d-block">Açık</small><h4 class="mb-0 text-primary">@Model.OpenRequestCount</h4></div></div></div>
        <div class="col-md-2"><div class="card"><div class="card-body py-3 text-center"><small class="text-muted d-block">Kapalı</small><h4 class="mb-0 text-danger">@Model.ClosedRequestCount</h4></div></div></div>
        <div class="col-md-2"><div class="card"><div class="card-body py-3 text-center"><small class="text-muted d-block">Teklif Verildi</small><h4 class="mb-0 text-success">@Model.QuoteSharedCount</h4></div></div></div>
        <div class="col-md-2"><div class="card"><div class="card-body py-3 text-center"><small class="text-muted d-block">Onaylı</small><h4 class="mb-0 text-success">@Model.ApprovedCount</h4></div></div></div>
        <div class="col-md-2"><div class="card"><div class="card-body py-3 text-center"><small class="text-muted d-block">Fiyat Bekleyen</small><h4 class="mb-0 text-warning">@Model.WaitingPricingCount</h4></div></div></div>
    </div>

    <div class="card">
        <div class="card-body pt-4">
            <h5 class="card-title">Satışçı Bazlı Dağılım</h5>
            <div class="table-responsive">
                <table class="table table-striped table-sm align-middle">
                    <thead>
                    <tr>
                        <th>Satışçı</th>
                        <th class="text-end">Toplam</th>
                        <th class="text-end">Açık</th>
                        <th class="text-end">Kapalı</th>
                        <th class="text-end">Teklif Verildi</th>
                        <th class="text-end">Onaylı</th>
                    </tr>
                    </thead>
                    <tbody>
                    @if (Model.SalespersonStats.Any())
                    {
                        @foreach (var row in Model.SalespersonStats)
                        {
                            <tr>
                                <td>@row.SalespersonName</td>
                                <td class="text-end">@row.TotalRequestCount</td>
                                <td class="text-end">@row.OpenRequestCount</td>
                                <td class="text-end">@row.ClosedRequestCount</td>
                                <td class="text-end">@row.QuoteSharedCount</td>
                                <td class="text-end">@row.ApprovedCount</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">Henüz satış talebi bulunmuyor.</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
