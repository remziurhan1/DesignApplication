@model Project
<div class="row"><div class="col-md-3 mb-3"><label asp-for="ProjectCode" class="form-label">Proje Kodu</label><input asp-for="ProjectCode" class="form-control" /></div><div class="col-md-5 mb-3"><label asp-for="ProjectName" class="form-label">Proje Adı</label><input asp-for="ProjectName" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="ProjectTypeId" class="form-label">Proje Tipi</label><select asp-for="ProjectTypeId" asp-items="ViewBag.ProjectTypes" class="form-select"></select></div></div>
<div class="row"><div class="col-md-3 mb-3"><label asp-for="StartDate" class="form-label">Başlangıç</label><input asp-for="StartDate" class="form-control" type="date" /></div><div class="col-md-3 mb-3"><label asp-for="Priority" class="form-label">Öncelik</label><input asp-for="Priority" class="form-control" type="number" /></div><div class="col-md-3 mb-3"><label asp-for="Status" class="form-label">Durum</label><select asp-for="Status" asp-items="Html.GetEnumSelectList<ProjectStatus>()" class="form-select"></select></div></div>
<button class="btn btn-primary">Kaydet ve Planla</button> <a asp-action="Index" class="btn btn-secondary">Geri</a>
