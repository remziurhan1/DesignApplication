@model MVC.ProductManagement.Presentation.Areas.Admin.Models.MaterialVMs.MaterialCreateVm

@{
    ViewData["Title"] = "Create Material";
}

<h2>Create Material</h2>

<form asp-area="Admin" asp-controller="Material" asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MaterialNumber" class="form-label"></label>
        <input asp-for="MaterialNumber" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Density" class="form-label"></label>
        <input asp-for="Density" class="form-control" type="number" step="0.01" />
    </div>

    <div class="mb-3">
        <label asp-for="ColdStretchYieldStrength" class="form-label">Cold Stretch Yield Strength (MPa)</label>
        <input asp-for="ColdStretchYieldStrength" class="form-control" type="number" step="0.01" />
    </div>

    <div class="mb-3">
        <label asp-for="ElasticModulus" class="form-label">Elastisite Modülü E (MPa)</label>
        <input asp-for="ElasticModulus" class="form-control" type="number" step="0.01" />
    </div>

    <div class="mb-3">
        <label asp-for="YieldFactorK" class="form-label">K Katsayısı (MPa)</label>
        <input asp-for="YieldFactorK" class="form-control" type="number" step="0.01" />
    </div>

    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-area="Admin" asp-controller="Material" asp-action="Index" class="btn btn-secondary">Cancel</a>

    <h4>Form Info</h4>
    <div id="forms-container">
        <div class="form-block">
            <label>Form Type</label>
            <select name="Forms[0].FormType" class="form-select"
                    asp-items="Html.GetEnumSelectList<MVC.ProductManagement.Domain.Enums.MaterialFormType>()"></select>

            <label>Thickness Min</label>
            <input name="Forms[0].ThicknessMin" type="number" class="form-control" />

            <label>Thickness Max</label>
            <input name="Forms[0].ThicknessMax" type="number" class="form-control" />


            <label>Class</label>
            <select name="Forms[0].MaterialClass" class="form-select" asp-items="ViewBag.MaterialGroups">
                <option value="">Seçiniz</option>
            </select>

            <label>Norm</label>
            <select name="Forms[0].Norm" class="form-select" asp-items="ViewBag.MaterialNorms">
                <option value="">Seçiniz</option>
            </select>

            <label>Sembolik İsim</label>
            <input name="Forms[0].SymbolicName" type="text" class="form-control" />

            <label>Stok Kodu</label>
            <input name="Forms[0].StockCode" type="text" class="form-control" />

            <label>Product Standard</label>
            <input name="Forms[0].ProductStandard" type="text" class="form-control" />

            <label>Welding Factor</label>
            <input name="Forms[0].WeldingFactor" type="number" step="0.01" class="form-control" />

            <label>Notes</label>
            <textarea name="Forms[0].Notes" class="form-control"></textarea>
        </div>
    </div>

</form>
