@model MVC.ProductManagement.Presentation.Areas.Admin.Models.StockCodes.SC.SCStockCardDetailViewModel
@using MVC.ProductManagement.Application.DTOs.StockCodes.OrtakKlasör

@{
    ViewData["Title"] = "SC Stok Kodu Detay - " + Model.StockCard.StockCode8;
}

<div class="container-fluid mt-4">

    <!-- BAŞLIK -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>
                <i class="bi bi-file-earmark-text text-primary"></i>
                <strong>@Model.StockCard.StockCode8</strong>
            </h2>
            <p class="text-muted mb-0">@Model.StockCard.Description</p>
            <small class="text-muted">
                Oluşturulma: @Model.StockCard.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                - @Model.StockCard.CreatedBy
            </small>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Edit" asp-route-id="@Model.StockCard.Id" class="btn btn-warning">
                <i class="bi bi-pencil-square"></i> Düzenle
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Listeye Dön
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Başarılı!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Hata!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- TAB MENÜ -->
    <ul class="nav nav-tabs mb-4" id="detailTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#general">
                Genel Bilgiler
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#datasheets">
                Datasheets
                @if (Model.Datasheets?.Any() == true)
                {
                    <span class="badge bg-primary">@Model.Datasheets.Count</span>
                }
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#prices">
                Fiyatlar
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#inventory">
                Stok
                @if (Model.CurrentInventory?.CurrentStock > 0)
                {
                    <span class="badge bg-info">@Model.CurrentInventory.CurrentStock</span>
                }
                else
                {
                    <span class="badge bg-warning">0</span>
                }
            </button>
        </li>
    </ul>

    <!-- TAB CONTENT -->
    <div class="tab-content">

        <div class="tab-pane fade show active" id="general">
            @await Html.PartialAsync("_GeneralInfoPartial", Model.StockCard)
        </div>

        <div class="tab-pane fade" id="datasheets">
            @await Html.PartialAsync("_DatasheetsPartial", new
                {
                    StockCardId = Model.StockCard.Id,
                    Datasheets = Model.Datasheets
                })
        </div>

        <div class="tab-pane fade" id="prices">
            @await Html.PartialAsync("_PricesPartial", new
                {
                    StockCardId = Model.StockCard.Id,
                    PriceHistory = Model.PriceHistory,
                    ActivePrice = Model.ActivePrice
                })
        </div>

        <div class="tab-pane fade" id="inventory">
            @await Html.PartialAsync("_InventoryPartial", new
                {
                    StockCardId = Model.StockCard.Id,
                    CurrentInventory = Model.CurrentInventory,
                    InventoryMovements = Model.InventoryMovements
                })
        </div>

    </div>
</div>
