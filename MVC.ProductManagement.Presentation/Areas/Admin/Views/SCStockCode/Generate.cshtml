@model MVC.ProductManagement.Presentation.Areas.Admin.Models.StockCodes.SC.SCStockCodeGenerateVm

@{
    ViewData["Title"] = "SC Stok Kodu Üret";
}

<div class="container mt-4">
    <h2>SC Stok Kodu Üret</h2>
    <p class="text-muted"><i class="bi bi-diagram-3 text-info"></i> Grup bilgisi + rule-based seçim akışı</p>
    <hr />

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show"><strong>Hata!</strong> @Model.ErrorMessage<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.StockCode8))
    {
        <div class="alert @(Model.AlreadyExists == true ? "alert-warning" : "alert-success") alert-dismissible fade show">
            <h5>@(Model.AlreadyExists == true ? "Mevcut Kod Getirildi" : "Yeni Kod Oluşturuldu!")</h5><hr />
            <p><strong>Stok Kodu:</strong> <span class="badge bg-primary fs-4">@Model.StockCode8</span></p>
            <p><strong>Açıklama:</strong><br />@Model.Description</p>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form id="groupForm" asp-action="Generate" method="post">
        <input type="hidden" name="SProductId" id="productIdInput" />

        <div class="card mb-4 shadow-sm"><div class="card-header bg-primary text-white"><strong>1. Ürün Seçimi</strong></div><div class="card-body">
            <select asp-for="SProductId" asp-items="Model.Products" id="productSelect" class="form-select form-select-lg" required><option value="">-- Ürün Seçiniz --</option></select>
        </div></div>

        <div class="card mb-3 shadow-sm" id="segmentCard" style="display:none;">
            <div class="card-header bg-secondary text-white"><strong>2. SC Grup Özeti</strong></div>
            <div class="card-body"><p class="mb-2"><strong>Segment:</strong> <span id="segmentText"></span></p><ul id="summaryList" class="mb-0"></ul></div>
        </div>

        <div class="card mb-4 shadow-sm" id="featuresCard" style="display:none;"><div class="card-header bg-info text-white"><strong>3. Ürün Özellikleri</strong></div><div class="card-body"><div id="featuresContainer"></div></div></div>

        <div id="hiddenInputs"></div>
        <button type="submit" class="btn btn-primary btn-lg" id="submitBtn" disabled>Kod Üret</button>
    </form>
</div>

@section Scripts {
<script>
const productSelect=document.getElementById("productSelect"); const productIdInput=document.getElementById("productIdInput"); const featuresCard=document.getElementById("featuresCard"); const featuresContainer=document.getElementById("featuresContainer"); const submitBtn=document.getElementById("submitBtn"); const groupForm=document.getElementById("groupForm"); const segmentCard=document.getElementById("segmentCard"); const segmentText=document.getElementById("segmentText"); const summaryList=document.getElementById("summaryList");
let formData=null; let selectedValues={};

productSelect.addEventListener("change", async ()=>{ const productId=productSelect.value; featuresContainer.innerHTML=""; summaryList.innerHTML=""; selectedValues={}; formData=null; submitBtn.disabled=true; featuresCard.style.display="none"; segmentCard.style.display="none"; if(!productId) return; try{const resp=await fetch(`/Admin/SCStockCode/GetFormData?productId=${productId}`); formData=await resp.json(); if(!formData?.features?.length){featuresContainer.innerHTML='<div class="alert alert-info">Özellik bulunamadı.</div>'; featuresCard.style.display="block"; return;} renderSegment(); renderFeatures(); } catch(err){ featuresContainer.innerHTML=`<div class="alert alert-danger">${err.message}</div>`; featuresCard.style.display="block"; }});

function resolveSegment(code){ if(code?.startsWith("SCA")||code?.startsWith("SCB")||code?.startsWith("SCC")) return {name:"Rakor Grubu", items:["Ürün bazlı sabit ve dinamik feature", "Ölçü/standart seçimleri birlikte değerlendirilir"]}; return {name:"Genel SC Grubu", items:["Rule tabanlı sabit + dinamik feature"]}; }
function featureGroup(code){ if(code.includes("METRIC")||code.includes("LENGTH")) return "Ölçü"; if(code.includes("MATERIAL")||code.includes("STRENGTH")||code.includes("COATING")) return "Malzeme / Dayanım"; if(code.includes("STANDARD")||code.includes("THREAD")||code.includes("HEAD")) return "Standart / Geometri"; return "Diğer"; }
function renderSegment(){ const s=resolveSegment(formData.productCode); segmentText.textContent=s.name; s.items.forEach(x=>{const li=document.createElement("li"); li.textContent=x; summaryList.appendChild(li);}); segmentCard.style.display="block"; }
function renderFeatures(){ const groups={}; formData.features.forEach(f=>{const g=featureGroup(f.featureCode); (groups[g]??=[]).push(f);}); featuresContainer.innerHTML=""; Object.entries(groups).forEach(([name,features])=>{ const h=document.createElement("h6"); h.className="mt-3 mb-2 text-primary border-bottom pb-1"; h.textContent=name; featuresContainer.appendChild(h); const row=document.createElement("div"); row.className="row"; features.forEach(feature=>{const col=document.createElement("div"); col.className="col-md-6 mb-3"; const label=document.createElement("label"); label.className="form-label fw-bold"; label.textContent=feature.featureName; col.appendChild(label); if(feature.isFixed){const input=document.createElement("input"); input.className="form-control"; input.disabled=true; input.value=`${feature.fixedValueCode} - ${feature.fixedValueName}`; selectedValues[feature.featureId]=feature.fixedValueId; col.appendChild(input);} else {const select=document.createElement("select"); select.className="form-select"; select.dataset.featureId=feature.featureId; select.required=true; select.innerHTML='<option value="">-- Seçiniz --</option>'; feature.availableValues.forEach(v=>{const o=document.createElement("option"); o.value=v.id; o.textContent=`${v.code} - ${v.name}`; select.appendChild(o);}); select.addEventListener("change",e=>{const id=e.target.dataset.featureId; if(e.target.value) selectedValues[id]=e.target.value; else delete selectedValues[id]; checkForm();}); col.appendChild(select);} row.appendChild(col);}); featuresContainer.appendChild(row);}); featuresCard.style.display="block"; checkForm(); }
function checkForm(){ if(!formData){submitBtn.disabled=true; return;} submitBtn.disabled=!formData.features.filter(f=>!f.isFixed).every(f=>selectedValues[f.featureId]); }

groupForm.addEventListener("submit", ()=>{ productIdInput.value=productSelect.value; const c=document.getElementById("hiddenInputs"); c.innerHTML=""; let i=0; Object.entries(selectedValues).forEach(([k,v])=>{const ki=document.createElement("input"); ki.type="hidden"; ki.name=`SelectedFeatureValues[${i}].Key`; ki.value=k; c.appendChild(ki); const vi=document.createElement("input"); vi.type="hidden"; vi.name=`SelectedFeatureValues[${i}].Value`; vi.value=v; c.appendChild(vi); i++;}); });
</script>
}
