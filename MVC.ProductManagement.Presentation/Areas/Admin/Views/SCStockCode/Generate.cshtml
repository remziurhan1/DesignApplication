@model MVC.ProductManagement.Presentation.Areas.Admin.Models.StockCodes.SC.SCStockCodeGenerateVm

@{
    ViewData["Title"] = "SC Stok Kodu Üret (Rondelalar)";
}

<div class="container mt-4">
    <h2>SC Stok Kodu Üret - Rondelalar / Pullar</h2>
    <hr />

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.StockCode8))
    {
        <div class="alert @(Model.AlreadyExists == true ? "alert-warning" : "alert-success")">
            <h5>
                <i class="bi bi-@(Model.AlreadyExists == true ? "info-circle" : "check-circle")"></i>
                @(Model.AlreadyExists == true ? "Mevcut Kod Getirildi" : "Yeni Kod Oluşturuldu")
            </h5>
            <hr />
            <p><strong>Stok Kodu:</strong> <span class="badge bg-primary fs-5">@Model.StockCode8</span></p>
            <p><strong>Açıklama:</strong> @Model.Description</p>
        </div>
    }

    <form id="scForm" asp-action="Generate" method="post">
        <input type="hidden" name="SProductId" id="productId" />

        <!-- ✅ ÜRÜN SEÇİMİ -->
        <div class="row mb-3">
            <div class="col-md-12">
                <label class="form-label fw-bold text-primary">Ürün Seçiniz *</label>
                <select asp-for="SProductId" asp-items="Model.Products" id="productSelect" class="form-select form-select-lg" required>
                    <option value="">-- Ürün Seçiniz --</option>
                </select>
            </div>
        </div>

        <hr />

        <!-- FEATURE DROPDOWNS (Dinamik) -->
        <div id="featuresContainer" class="row"></div>
        <div id="hiddenInputs"></div>

        <hr />

        <button type="submit" class="btn btn-primary btn-lg" id="submitBtn" disabled>
            <i class="bi bi-gear-fill"></i> Kod Üret
        </button>
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-secondary btn-lg">
            <i class="bi bi-arrow-left"></i> Geri
        </a>
    </form>
</div>

@section Scripts {
    <script>
        const productSelect = document.getElementById("productSelect");
        const featuresContainer = document.getElementById("featuresContainer");
        const submitBtn = document.getElementById("submitBtn");
        const productIdInput = document.getElementById("productId");
        const scForm = document.getElementById("scForm");

        let featureSelects = [];

        // ========== Ürün değişince feature'ları yükle ==========
        productSelect.addEventListener("change", async function () {
            const productId = productSelect.value;

            // Temizle
            featuresContainer.innerHTML = "";
            featureSelects = [];
            submitBtn.disabled = true;

            if (!productId) return;

            try {
                const resp = await fetch(`/Admin/SCStockCode/FeaturesByProduct?productId=${productId}`);
                if (!resp.ok) throw new Error("İstek başarısız");

                const features = await resp.json();

                if (!features || features.length === 0) {
                    featuresContainer.innerHTML = '<div class="col-12"><div class="alert alert-info">Bu ürün için özellik tanımı bulunmuyor.</div></div>';
                    return;
                }

                features.sort((a, b) => a.sortOrder - b.sortOrder);

                let stepNumber = 1;
                features.forEach((feature, index) => {
                    const colDiv = document.createElement("div");
                    colDiv.className = "col-md-4 mb-3";

                    const label = document.createElement("label");
                    label.className = "form-label";
                    label.innerHTML = `<span class="badge bg-secondary">${stepNumber}</span> ${feature.name}${feature.isRequired ? ' <span class="text-danger">*</span>' : ''}`;

                    const select = document.createElement("select");
                    select.className = "form-select feature-select";
                    select.setAttribute("data-feature-id", feature.id);
                    select.setAttribute("data-feature-code", feature.code);
                    select.setAttribute("data-step", stepNumber);
                    select.required = feature.isRequired;

                    // İlk dropdown dışında hepsi disabled
                    if (index > 0) {
                        select.disabled = true;
                    }

                    const defaultOption = document.createElement("option");
                    defaultOption.value = "";
                    defaultOption.textContent = index === 0
                        ? "-- Seçiniz --"
                        : `-- Önce ${stepNumber - 1}. adımı tamamlayın --`;
                    select.appendChild(defaultOption);

                    feature.values.forEach(value => {
                        const option = document.createElement("option");
                        option.value = value.id;
                        option.setAttribute("data-value-code", value.code);
                        option.textContent = value.name;
                        select.appendChild(option);
                    });

                    colDiv.appendChild(label);
                    colDiv.appendChild(select);
                    featuresContainer.appendChild(colDiv);

                    featureSelects.push(select);
                    stepNumber++;
                });

                // Event listener'ları ekle
                attachFeatureListeners();

            } catch (err) {
                featuresContainer.innerHTML = '<div class="col-12"><div class="alert alert-danger">Hata: ' + err.message + '</div></div>';
            }
        });

        // ========== Feature seçim event'lerini bağla ==========
        function attachFeatureListeners() {
            featureSelects.forEach((select, index) => {
                select.addEventListener("change", function () {
                    const selectedValue = this.value;

                    // Sonraki tüm dropdown'ları sıfırla
                    for (let i = index + 1; i < featureSelects.length; i++) {
                        featureSelects[i].disabled = true;
                        featureSelects[i].value = "";
                        const step = parseInt(featureSelects[i].getAttribute("data-step"));
                        featureSelects[i].options[0].text = `-- Önce ${step - 1}. adımı tamamlayın --`;
                    }

                    submitBtn.disabled = true;

                    // Eğer seçim yapıldıysa bir sonrakini aktif et
                    if (selectedValue) {
                        const nextFeature = featureSelects[index + 1];
                        if (nextFeature) {
                            nextFeature.disabled = false;
                            nextFeature.options[0].text = "-- Seçiniz --";
                        } else {
                            // Son feature seçildiyse submit'i aktif et
                            checkFormCompletion();
                        }
                    }
                });
            });
        }

        // ========== Form tamamlandı mı kontrol et ==========
        function checkFormCompletion() {
            const productId = productSelect.value;
            if (!productId) {
                submitBtn.disabled = true;
                return;
            }

            let allSelected = true;
            featureSelects.forEach(select => {
                if (select.required && !select.value) {
                    allSelected = false;
                }
            });

            submitBtn.disabled = !allSelected;
        }

        // ========== Form submit ==========
        scForm.addEventListener("submit", function (e) {
            e.preventDefault();

            const productId = productSelect.value;
            if (!productId) {
                alert("Ürün seçiniz!");
                return;
            }

            productIdInput.value = productId;

            const hiddenContainer = document.getElementById("hiddenInputs");
            hiddenContainer.innerHTML = "";

            let index = 0;
            let allValid = true;

            featureSelects.forEach(select => {
                const featureId = select.getAttribute("data-feature-id");
                const valueId = select.value;

                if (select.required && !valueId) {
                    allValid = false;
                    return;
                }

                if (valueId) {
                    const keyInput = document.createElement("input");
                    keyInput.type = "hidden";
                    keyInput.name = `SelectedFeatureValues[${index}].Key`;
                    keyInput.value = featureId;
                    hiddenContainer.appendChild(keyInput);

                    const valueInput = document.createElement("input");
                    valueInput.type = "hidden";
                    valueInput.name = `SelectedFeatureValues[${index}].Value`;
                    valueInput.value = valueId;
                    hiddenContainer.appendChild(valueInput);

                    console.log(`[JS] Added: Key=${featureId}, Value=${valueId}`);
                    index++;
                }
            });

            if (!allValid) {
                alert("Tüm zorunlu alanları doldurunuz!");
                return;
            }

            this.submit();
        });

        // ========== Sayfa yüklendiğinde ürün seçiliyse feature'ları yükle ==========
        window.addEventListener("DOMContentLoaded", function () {
            const selectedProductId = productSelect.value;
            if (selectedProductId) {
                productSelect.dispatchEvent(new Event("change"));
            }
        });
    </script>

    <style>
        /* ✅ Disabled dropdown'lar gri */
        .feature-select:disabled {
            background-color: #f8f9fa;
            cursor: not-allowed;
            opacity: 0.6;
        }

        /* ✅ Aktif dropdown'lar yeşil kenarlık */
        .feature-select:not(:disabled) {
            border-color: #28a745;
            border-width: 2px;
        }

        /* ✅ Seçilmiş dropdown'lar yeşil arka plan */
        .feature-select:not(:disabled):valid:not([value=""]) {
            background-color: #d4edda;
        }

        /* ✅ Buton disabled görünümü */
        #submitBtn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
    </style>
}