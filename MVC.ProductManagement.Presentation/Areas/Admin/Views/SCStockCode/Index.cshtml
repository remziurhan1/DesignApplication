@model MVC.ProductManagement.Application.DTOs.StockCodes.SC.SCStockCardListResultDto
@using MVC.ProductManagement.Application.DTOs.StockCodes.SC

@{
    ViewData["Title"] = "SC Stok Kodları Listesi";
}

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col-md-8">
            <h2>
                <i class="bi bi-list-ul text-primary"></i>
                SC Stok Kodları
            </h2>
            <p class="text-muted">Toplam <strong>@Model.TotalCount</strong> kayıt bulundu</p>
            <div class="col-md-4 text-end">
                <a asp-action="Generate" class="btn btn-primary btn-lg me-2">
                    <i class="bi bi-plus-circle"></i> Yeni Kod Üret
                </a>
                <button type="button" class="btn btn-outline-primary btn-lg" onclick="exportExcel()">
                    <i class="bi bi-file-earmark-excel"></i> Excel İndir
                </button>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <strong>Hata!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- FİLTRE -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <i class="bi bi-funnel-fill"></i> <strong>Filtrele</strong>
        </div>
        <div class="card-body">
            <form method="get" asp-action="Index" id="filterForm">
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label fw-bold">
                            <i class="bi bi-search"></i> Genel Arama
                        </label>
                        <input type="text"
                               name="SearchTerm"
                               class="form-control form-control-lg"
                               value="@Context.Request.Query["SearchTerm"]" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold">
                            <i class="bi bi-box-seam"></i> Ürün
                        </label>
                        <select name="ProductId" class="form-select">
                            <option value="">-- Tüm Ürünler --</option>
                            @foreach (var product in ViewBag.Products as List<SelectListItem>)
                            {
                                <option value="@product.Value"
                                        selected="@(Context.Request.Query["ProductId"] == product.Value)">
                                    @product.Text
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold">Göster</label>
                        <select name="PageSize" class="form-select">
                            <option value="25" selected="@(Model.PageSize == 25)">25</option>
                            <option value="50" selected="@(Model.PageSize == 50)">50</option>
                            <option value="100" selected="@(Model.PageSize == 100)">100</option>
                        </select>
                    </div>

                    <div class="col-md-2 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search"></i> Ara
                        </button>
                        <a asp-action="Index" class="btn btn-secondary w-100">
                            <i class="bi bi-x-circle"></i> Temizle
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- TABLO -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th style="width:120px;">Stok Kodu</th>
                                <th style="width:100px;">Ürün</th>
                                <th>Açıklama</th>
                                <th style="width:150px;">Oluşturulma</th>
                                <th style="width:100px;">Oluşturan</th>
                                <th style="width:100px;" class="text-center">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td><strong class="text-primary">@item.StockCode8</strong></td>
                                    <td><span class="badge bg-info">@item.ProductCode</span></td>
                                    <td><small>@item.Description</small></td>
                                    <td><small>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</small></td>
                                    <td><small>@item.CreatedBy</small></td>
                                    <td class="text-end">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Detail"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-info">
                                                <i class="bi bi-eye"></i> Detay
                                            </a>
                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-warning">
                                                <i class="bi bi-pencil"></i> Düzenle
                                            </a>
                                        </div>
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer">
                        <nav>
                            <ul class="pagination pagination-sm justify-content-center mb-0">
                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                    <a class="page-link" href="@GetPageUrl(Model.PageNumber - 1)">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>

                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                        <a class="page-link" href="@GetPageUrl(i)">@i</a>
                                    </li>
                                }

                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                    <a class="page-link" href="@GetPageUrl(Model.PageNumber + 1)">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <h4 class="mt-3 text-muted">Kayıt Bulunamadı</h4>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    string GetPageUrl(int pageNumber)
    {
        var query = Context.Request.Query.ToDictionary(x => x.Key, x => x.Value.ToString());
        query["PageNumber"] = pageNumber.ToString();
        query["PageSize"] = Model.PageSize.ToString();
        return $"?{string.Join("&", query.Select(x => $"{x.Key}={x.Value}"))}";
    }
}

@section Scripts {
    <script>
        function exportExcel() {
            const form = document.getElementById('filterForm');
            const formData = new FormData(form);
            const params = new URLSearchParams(formData);
            window.location.href = '@Url.Action("ExportExcel")?' + params.toString();
        }
    </script>
}
