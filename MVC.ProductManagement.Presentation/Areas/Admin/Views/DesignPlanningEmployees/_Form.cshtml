@model Employee
<div class="mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="DailyCapacityHours" class="form-label"></label><input asp-for="DailyCapacityHours" class="form-control" type="number" step="0.25" /></div>
<div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
<button class="btn btn-primary">Kaydet</button> <a asp-action="Index" class="btn btn-secondary">Geri</a>
