@model IEnumerable<MVC.ProductManagement.Application.DTOs.StockCodes.Catalog.StockSubCodeRuleListDto>

<h4>Alt Grup Kuralları</h4>
<a asp-controller="StockCodeGeneration" asp-action="Index" class="btn btn-outline-primary mb-3">Üretilen Stok Kodları</a>
<a asp-action="Create" class="btn btn-primary mb-3">Yeni Kural</a>
<table class="table table-striped">
    <thead><tr><th>Ana/Alt Grup</th><th>Kural Kodu</th><th>Kural Adı</th><th>Birim Fiyat</th><th>Hedef Fiyat</th><th>Durum</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.MainGroupCode / @item.SubGroupCode - @item.SubGroupName</td>
            <td>@item.RuleCode</td>
            <td>@item.RuleName</td>
            <td>@item.UnitPrice.ToString("N2")</td>
            <td>@item.TargetPrice.ToString("N2")</td>
            <td>@(item.IsEnabled ? "Açık" : "Kapalı")</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-danger" type="submit">Sil</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
