@model IEnumerable<TaskTemplate>
@{ ViewData["Title"] = "Dizayn Görev Şablonları"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2>@ViewData["Title"]</h2><a asp-action="Create" class="btn btn-primary">Yeni Şablon</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-md-4"><select name="projectTypeId" asp-items="ViewBag.ProjectTypes" class="form-select"><option value="">Tüm proje tipleri</option></select></div><div class="col-md-2"><button class="btn btn-outline-secondary">Filtrele</button></div></form>
<table class="table table-sm table-striped table-bordered align-middle"><thead><tr><th>Tip</th><th>Sıra</th><th>Sorumlu</th><th>Görev</th><th>Süre</th><th>Pasif</th><th>Aktif</th><th></th></tr></thead><tbody>@foreach (var item in Model) {<tr><td>@item.ProjectType?.Name</td><td>@item.SequenceNo</td><td>@item.ResponsibleRole</td><td>@item.TaskName</td><td>@item.DurationValue @item.DurationUnit</td><td>@if (item.IsPassive) {<span class="badge bg-info text-dark">Pasif</span>}</td><td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Aktif" : "Pasif")</span></td><td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Düzenle</a><form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Silinsin mi?')">Sil</button></form></td></tr>}</tbody></table>
