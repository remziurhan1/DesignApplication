@model MVC.ProductManagement.Presentation.Areas.Admin.Models.SalesRequestVMs.SalesDashboardVm
@{
    ViewData["Title"] = "Satış Ekranı";
}

<div class="p-2">
    <h3 class="mb-2">Satış Ekranı</h3>
    <p class="text-muted">Bu ekranda satış kullanıcıları müşteri ve talep süreçlerini yönetir.</p>
    @if (!string.IsNullOrWhiteSpace(Model.CurrentRegion))
    {
        <div class="alert alert-info py-2 mb-2">
            Bölge filtresi aktif: <strong>@Model.CurrentRegion</strong>
        </div>
    }

    <div class="row g-3 mt-1">
        <div class="col-12">
            <div class="row g-3">
                <div class="col-md-2"><div class="border rounded-3 p-3 text-center"><div class="small text-muted">Toplam Talep</div><div class="h4 mb-0">@Model.TotalRequestCount</div></div></div>
                <div class="col-md-2"><div class="border rounded-3 p-3 text-center"><div class="small text-muted">Açık</div><div class="h4 mb-0 text-primary">@Model.OpenRequestCount</div></div></div>
                <div class="col-md-2"><div class="border rounded-3 p-3 text-center"><div class="small text-muted">Kapalı</div><div class="h4 mb-0 text-danger">@Model.ClosedRequestCount</div></div></div>
                <div class="col-md-2"><div class="border rounded-3 p-3 text-center"><div class="small text-muted">Teklif Verildi</div><div class="h4 mb-0 text-success">@Model.QuoteSharedCount</div></div></div>
                <div class="col-md-2"><div class="border rounded-3 p-3 text-center"><div class="small text-muted">Onaylı</div><div class="h4 mb-0 text-success">@Model.ApprovedCount</div></div></div>
                <div class="col-md-2"><div class="border rounded-3 p-3 text-center"><div class="small text-muted">Fiyat Bekleyen</div><div class="h4 mb-0 text-warning">@Model.WaitingPricingCount</div></div></div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="border rounded-3 p-3 h-100">
                <h5 class="mb-2">Müşteri Yönetimi</h5>
                <p class="text-muted small">Mevcut müşterileri görüntüleyin veya yeni müşteri oluşturun.</p>
                <div class="d-flex gap-2">
                    <a asp-area="Sales" asp-controller="Customer" asp-action="Index" class="btn btn-outline-danger">Müşteriler</a>
                    <a asp-area="Sales" asp-controller="Customer" asp-action="Create" class="btn btn-danger">+ Müşteri Ekle</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="border rounded-3 p-3 h-100">
                <h5 class="mb-2">Talep Yönetimi</h5>
                <p class="text-muted small">Satış taleplerini takip edin ve yeni talep oluşturun.</p>
                <div class="d-flex gap-2">
                    <a asp-area="Sales" asp-controller="SalesRequest" asp-action="Index" class="btn btn-outline-danger">Talepler</a>
                    <a asp-area="Sales" asp-controller="SalesRequest" asp-action="Create" class="btn btn-danger">+ Talep Ekle</a>
                    @if (Model.IsManagerView)
                    {
                        <a asp-area="Sales" asp-controller="SalesRequest" asp-action="ManagerPanel" class="btn btn-outline-primary">Müdür Paneli</a>
                    }
                </div>
            </div>
        </div>
        @if (Model.IsManagerView && Model.SalespersonStats.Any())
        {
            <div class="col-12">
                <div class="border rounded-3 p-3">
                    <h5 class="mb-2">Takım Dağılımı</h5>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Satışçı</th>
                                    <th class="text-end">Toplam</th>
                                    <th class="text-end">Açık</th>
                                    <th class="text-end">Kapalı</th>
                                    <th class="text-end">Teklif Verildi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.SalespersonStats)
                                {
                                    <tr>
                                        <td>@row.SalespersonName</td>
                                        <td class="text-end">@row.TotalRequestCount</td>
                                        <td class="text-end">@row.OpenRequestCount</td>
                                        <td class="text-end">@row.ClosedRequestCount</td>
                                        <td class="text-end">@row.QuoteSharedCount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
