@{
    ViewData["Title"] = "Satış Ekranı";
}

<div class="p-2">
    <h3 class="mb-2">Satış Ekranı</h3>
    <p class="text-muted">Bu ekranda satış kullanıcıları müşteri ve talep süreçlerini yönetir.</p>

    <div class="row g-3 mt-1">
        <div class="col-md-6">
            <div class="border rounded-3 p-3 h-100">
                <h5 class="mb-2">Müşteri Yönetimi</h5>
                <p class="text-muted small">Mevcut müşterileri görüntüleyin veya yeni müşteri oluşturun.</p>
                <div class="d-flex gap-2">
                    <a asp-area="Sales" asp-controller="Customer" asp-action="Index" class="btn btn-outline-danger">Müşteriler</a>
                    <a asp-area="Sales" asp-controller="Customer" asp-action="Create" class="btn btn-danger">+ Müşteri Ekle</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="border rounded-3 p-3 h-100">
                <h5 class="mb-2">Talep Yönetimi</h5>
                <p class="text-muted small">Satış taleplerini takip edin ve yeni talep oluşturun.</p>
                <div class="d-flex gap-2">
                    <a asp-area="Sales" asp-controller="SalesRequest" asp-action="Index" class="btn btn-outline-danger">Talepler</a>
                    <a asp-area="Sales" asp-controller="SalesRequest" asp-action="Create" class="btn btn-danger">+ Talep Ekle</a>
                </div>
            </div>
        </div>
    </div>
</div>
