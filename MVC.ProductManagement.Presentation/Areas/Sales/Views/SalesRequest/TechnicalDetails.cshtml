@model MVC.ProductManagement.Presentation.Areas.Admin.Models.SalesRequestVMs.SalesRequestTechnicalDetailsVm
@{
    ViewData["Title"] = "Teknik Detay";
}

<div class="pagetitle d-flex justify-content-between align-items-center">
    <div>
        <h1>@Model.ItemCode - Teknik Detay</h1>
        <p class="text-muted mb-0">@Model.RequestNo · @Model.ItemTitle</p>
    </div>
    <a asp-action="Details" asp-route-id="@Model.RequestId" class="btn btn-outline-secondary">Talebe dön</a>
</div>

<div class="card mt-4">
    <div class="card-body pt-4">
        @if (Model.InputFields.Any())
        {
            <h5 class="mb-3">Giriş verileri</h5>
            <div class="table-responsive mb-4">
                <table class="table table-bordered table-striped align-middle mb-0">
                    <tbody>
                    @foreach (var field in Model.InputFields)
                    {
                        <tr>
                            <th style="width:35%">@field.Label</th>
                            <td>@field.Value</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        <div class="row g-3 mb-4">
            <div class="col-lg-6">
                <div class="card h-100 border-primary-subtle">
                    <div class="card-header bg-primary-subtle">İç tank</div>
                    <div class="card-body p-0">
                        <table class="table table-sm table-striped align-middle mb-0">
                            <tbody>
                            @foreach (var field in Model.InnerTankFields)
                            {
                                <tr>
                                    <th style="width:55%">@field.Label</th>
                                    <td>@field.Value</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card h-100 border-secondary-subtle">
                    <div class="card-header bg-secondary-subtle">Dış tank</div>
                    <div class="card-body p-0">
                        <table class="table table-sm table-striped align-middle mb-0">
                            <tbody>
                            @foreach (var field in Model.OuterTankFields)
                            {
                                <tr>
                                    <th style="width:55%">@field.Label</th>
                                    <td>@field.Value</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-6"><strong>Bağlı hesap:</strong> @Model.CalculationType - @Model.CalculationName</div>
            <div class="col-md-6"><strong>Revizyon:</strong> @(Model.RevisionCode ?? "-")</div>
            <div class="col-md-4"><strong>MAWP:</strong> @Model.MAWP</div>
            <div class="col-md-4"><strong>Dizayn basıncı:</strong> @Model.DesignPressure</div>
            <div class="col-md-4"><strong>Test basıncı:</strong> @Model.TestPressure</div>
            <div class="col-md-6"><strong>Yuvarlanmış gövde et:</strong> @Model.RoundedShellThickness</div>
            <div class="col-md-6"><strong>Yuvarlanmış bombe et:</strong> @Model.RoundedHeadThickness</div>
            <div class="col-md-6"><strong>İç tank uzunluğu / gövde boyu:</strong> @Model.InnerTankLength</div>
            <div class="col-md-6"><strong>Tank çapı:</strong> @Model.TankDiameter</div>
            @if (!string.IsNullOrWhiteSpace(Model.DesignDetails))
            {
                <div class="col-12">
                    <strong>Ek teknik açıklama:</strong>
                    <div class="text-muted">@Model.DesignDetails</div>
                </div>
            }
        </div>
    </div>
</div>

@if (Model.HasSpecification)
{
    <div class="alert alert-info mt-3 mb-0">
        Bu kalem EN13458 olduğu için teknik şartname detayı bu teknik özetten takip edilebilir.
    </div>
}
