@using MVC.ProductManagement.Domain.Enums
@model MVC.ProductManagement.Presentation.Areas.Admin.Models.SalesRequestVMs.SalesRequestDetailVm
@{
    ViewData["Title"] = "Satış Talep Detayı";

    string CustomerStatusText(SalesCustomerQuoteStatus status) => status switch
    {
        SalesCustomerQuoteStatus.NotShared => "Teklif Müşteriye İletilmedi",
        SalesCustomerQuoteStatus.PreparingSpecification => "Şartname Hazırlanıyor",
        SalesCustomerQuoteStatus.SharedWithCustomer => "Teklif Müşteriye İletildi",
        _ => "İşlemde"
    };

    string StatusClass(SalesCustomerQuoteStatus status) => status switch
    {
        SalesCustomerQuoteStatus.SharedWithCustomer => "success",
        SalesCustomerQuoteStatus.NotShared => "secondary",
        _ => "warning"
    };

    string ItemStatusText(SalesRequestWorkflowStatus status) => status switch
    {
        SalesRequestWorkflowStatus.Draft => "Talep Alındı",
        SalesRequestWorkflowStatus.Submitted => "Şartname Hazırlanıyor",
        SalesRequestWorkflowStatus.PricingInProgress => "Fiyatlandırma Devam Ediyor",
        SalesRequestWorkflowStatus.Approved => "Yönetici Onaylı",
        SalesRequestWorkflowStatus.Rejected => "Teklif İptal",
        _ => "İşlemde"
    };

    string ItemStatusClass(SalesRequestWorkflowStatus status) => status switch
    {
        SalesRequestWorkflowStatus.Approved => "success",
        SalesRequestWorkflowStatus.Rejected => "danger",
        SalesRequestWorkflowStatus.PricingInProgress => "warning",
        _ => "info"
    };

    void RenderItem(MVC.ProductManagement.Presentation.Areas.Admin.Models.SalesRequestVMs.SalesRequestDetailItemVm item, int depth)
    {
        <div class="card mb-3 ms-@Math.Min(depth * 2, 5)">
            <div class="card-body pt-3">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <span class="badge bg-secondary">@item.ItemCode</span>
                        <h5 class="mt-2 mb-1">@item.ItemTitle</h5>
                        <div class="text-muted">@item.ProductGroupName</div>
                    </div>
                    <div class="d-flex flex-column align-items-end gap-2">
                        <span class="badge bg-@ItemStatusClass(item.WorkflowStatus)">@ItemStatusText(item.WorkflowStatus)</span>
                        @if (item.LinkedCalculationType.HasValue && item.LinkedCalculationId.HasValue)
                        {
                            <div class="d-flex flex-wrap gap-2 justify-content-end">
                                <a href="@Url.Action("TechnicalDetails", "SalesRequest", new { area = "Sales", requestId = Model.Id, itemId = item.Id })" class="btn btn-sm btn-outline-primary">
                                    Teknik Detay
                                </a>
                                @if (item.LinkedCalculationType == SalesRequestCalculationType.EN13458)
                                {
                                    <a href="@Url.Action("Specification", "SalesRequest", new { area = "Sales", requestId = Model.Id, itemId = item.Id })" class="btn btn-sm btn-outline-secondary">
                                        Şartname
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="row mt-3 g-3">
                    <div class="col-md-4"><strong>Kapasite:</strong> @item.CapacityM3 m³</div>
                    <div class="col-md-4"><strong>Talep grubu:</strong> @item.RequestCategory</div>
                    <div class="col-md-4"><strong>Kurulum:</strong> @item.PlacementType</div>
                    <div class="col-md-6"><strong>Minimum satış fiyatı:</strong> @(item.MinimumSalesPrice?.ToString("N2") ?? "-") ₺</div>
                    <div class="col-md-6"><strong>Tavsiye edilen satış fiyatı:</strong> @(item.ApprovedSalesPrice?.ToString("N2") ?? "-") ₺</div>
                    @if (!string.IsNullOrWhiteSpace(item.DesignDetails))
                    {
                        <div class="col-12"><strong>Teknik özet:</strong><div class="text-muted">@item.DesignDetails</div></div>
                    }
                </div>
            </div>
        </div>

        foreach (var child in item.Children)
        {
            RenderItem(child, depth + 1);
        }
    }
}

<div class="pagetitle d-flex justify-content-between align-items-center">
    <div>
        <h1>@Model.RequestNo</h1>
        <p class="text-muted mb-0">@Model.Title · @Model.RevisionCode</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Revise" asp-route-id="@Model.Id" class="btn btn-outline-primary">Talebi revize et</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Listeye dön</a>
    </div>
</div>

@if (ViewBag.WaitingManagerApproval is bool waiting && waiting)
{
    <div class="alert alert-warning mt-3 mb-0">
        Bu talep admin/satış yöneticisi onayında. Onay sonrası minimum ve tavsiye fiyatlar netleşecektir.
    </div>
}

<section class="section mt-4">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body pt-4">
                    <div class="row g-3">
                        <div class="col-md-4"><strong>Müşteri:</strong><div>@Model.CustomerName</div></div>
                        <div class="col-md-4"><strong>Satışçı:</strong><div>@Model.RequestedByName</div></div>
                        <div class="col-md-4"><strong>Durum:</strong><div><span class="badge bg-@StatusClass(Model.CustomerQuoteStatus)">@CustomerStatusText(Model.CustomerQuoteStatus)</span></div></div>
                        <div class="col-md-4"><strong>Revizyon:</strong><div>@Model.RevisionCode</div></div>
                        <div class="col-md-4"><strong>Müşteri Bildirim Durumu:</strong><div>@Model.CustomerQuoteStatus</div></div>
                        <div class="col-md-4"><strong>Talep alma tarihi:</strong><div>@Model.SalesOpenedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div></div>
                        <div class="col-md-4"><strong>İhtiyaç tarihi:</strong><div>@Model.NeededByDate.ToLocalTime().ToString("dd.MM.yyyy")</div></div>
                        <div class="col-md-4"><strong>Talep kaynağı:</strong><div>@Model.RequestSource</div></div>
                    </div>
                </div>
            </div>

            @foreach (var item in Model.Items)
            {
                RenderItem(item, 0);
            }
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-body pt-4">
                    <h5 class="card-title">Müşteri Bilgilendirme Durumu</h5>
                    <form asp-action="UpdateCustomerQuoteStatus" method="post" class="mb-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="input-group">
                            <select asp-for="CustomerQuoteStatus" name="customerQuoteStatus" class="form-select" asp-items="Html.GetEnumSelectList<SalesCustomerQuoteStatus>()"></select>
                            <button type="submit" class="btn btn-primary">Güncelle</button>
                        </div>
                    </form>

                    <h5 class="card-title">Ekler</h5>
                    @if (Model.Attachments.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var file in Model.Attachments)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <a href="@file.RelativePath" target="_blank">@file.OriginalFileName</a>
                                    <small class="text-muted">@(file.FileSize / 1024) KB</small>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Ek dosya yok.</p>
                    }
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-body pt-4">
                    <h5 class="card-title">Revizyon Geçmişi</h5>
                    @if (Model.RevisionHistory.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var revision in Model.RevisionHistory)
                            {
                                <li class="list-group-item px-0">
                                    <div class="fw-semibold">@revision.RevisionCode - @revision.RevisionReason</div>
                                    <small class="text-muted">@revision.RevisedBy · @revision.RevisedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Henüz revizyon yok.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
