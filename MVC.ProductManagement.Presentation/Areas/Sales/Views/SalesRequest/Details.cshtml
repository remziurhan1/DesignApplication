@using MVC.ProductManagement.Domain.Enums
@model MVC.ProductManagement.Presentation.Areas.Admin.Models.SalesRequestVMs.SalesRequestDetailVm
@{
    ViewData["Title"] = "Satış Talep Detayı";

    string CustomerStatusText(SalesCustomerQuoteStatus status) => status switch
    {
        SalesCustomerQuoteStatus.NotShared => "Teklif Müşteriye İletilmedi",
        SalesCustomerQuoteStatus.PreparingSpecification => "Şartname Hazırlanıyor",
        SalesCustomerQuoteStatus.SharedWithCustomer => "Teklif Müşteriye İletildi",
        _ => "İşlemde"
    };

    string StatusClass(SalesCustomerQuoteStatus status) => status switch
    {
        SalesCustomerQuoteStatus.SharedWithCustomer => "success",
        SalesCustomerQuoteStatus.NotShared => "secondary",
        _ => "warning"
    };

    string ItemStatusText(SalesRequestWorkflowStatus status) => status switch
    {
        SalesRequestWorkflowStatus.Draft => "Talep Alındı",
        SalesRequestWorkflowStatus.Submitted => "Şartname Hazırlanıyor",
        SalesRequestWorkflowStatus.PricingInProgress => "Fiyatlandırma Devam Ediyor",
        SalesRequestWorkflowStatus.Approved => "Yönetici Onaylı",
        SalesRequestWorkflowStatus.Rejected => "Teklif İptal",
        _ => "İşlemde"
    };

    string ItemStatusClass(SalesRequestWorkflowStatus status) => status switch
    {
        SalesRequestWorkflowStatus.Approved => "success",
        SalesRequestWorkflowStatus.Rejected => "danger",
        SalesRequestWorkflowStatus.PricingInProgress => "warning",
        _ => "info"
    };

    void RenderItem(MVC.ProductManagement.Presentation.Areas.Admin.Models.SalesRequestVMs.SalesRequestDetailItemVm item, int depth)
    {
        <div class="card mb-3 ms-@Math.Min(depth * 2, 5)">
            <div class="card-body pt-3">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <span class="badge bg-secondary">@item.ItemCode</span>
                        <h5 class="mt-2 mb-1">@item.ItemTitle</h5>
                        <div class="text-muted">@item.ProductGroupName</div>
                    </div>
                    <div class="d-flex flex-column align-items-end gap-2">
                        <span class="badge bg-@ItemStatusClass(item.WorkflowStatus)">@ItemStatusText(item.WorkflowStatus)</span>
                        @if (item.LinkedCalculationType.HasValue && item.LinkedCalculationId.HasValue)
                        {
                            <div class="d-flex flex-wrap gap-2 justify-content-end">
                                <a href="@Url.Action("TechnicalDetails", "SalesRequest", new { area = "Sales", requestId = Model.Id, itemId = item.Id })" class="btn btn-sm btn-outline-primary">
                                    Teknik Detay
                                </a>
                                @if (item.LinkedCalculationType == SalesRequestCalculationType.EN13458)
                                {
                                    <a href="@Url.Action("Specification", "SalesRequest", new { area = "Sales", requestId = Model.Id, itemId = item.Id })" class="btn btn-sm btn-outline-secondary">
                                        Şartname
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="row mt-3 g-3">
                    <div class="col-md-4"><strong>Kapasite:</strong> @item.CapacityM3 m³</div>
                    <div class="col-md-4"><strong>Talep grubu:</strong> @item.RequestCategory</div>
                    <div class="col-md-4"><strong>Kurulum:</strong> @item.PlacementType</div>
                    @if (Model.CanViewPricing)
                    {
                        <div class="col-md-6"><strong>Minimum satış fiyatı:</strong> @(item.MinimumSalesPrice?.ToString("N2") ?? "-") ₺</div>
                        <div class="col-md-6"><strong>Satış fiyatı:</strong> @(item.ApprovedSalesPrice?.ToString("N2") ?? "-") ₺</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.DesignDetails))
                    {
                        <div class="col-12"><strong>Teknik özet:</strong><div class="text-muted">@item.DesignDetails</div></div>
                    }
                </div>
            </div>
        </div>

        foreach (var child in item.Children)
        {
            RenderItem(child, depth + 1);
        }
    }
}

<style>
    .sales-detail-hero {
        border-radius: 1rem;
        background: linear-gradient(135deg, #1f3c88 0%, #2155cd 50%, #0b2447 100%);
        color: #fff;
        box-shadow: 0 12px 26px rgba(13, 33, 72, .2);
    }

    .sales-detail-hero .muted-light {
        color: rgba(255,255,255,.82);
    }

    .sales-summary-card {
        border: 1px solid #dbe4ff;
        border-radius: .8rem;
        background: #f8faff;
        padding: .85rem 1rem;
    }

    .sales-summary-card .label {
        font-size: .78rem;
        text-transform: uppercase;
        color: #6b7280;
        letter-spacing: .04em;
    }

    .sales-summary-card .value {
        font-size: 1.05rem;
        font-weight: 700;
        color: #0f172a;
    }
</style>

<div class="pagetitle d-flex justify-content-between align-items-center">
    <div class="sales-detail-hero p-3 p-md-4 w-100 mb-2">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <h1 class="mb-1">@Model.RequestNo</h1>
                <p class="mb-0 muted-light">@Model.Title · @Model.RevisionCode</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Revise" asp-route-id="@Model.Id" class="btn btn-light btn-sm">Talebi revize et</a>
                <a asp-action="Index" class="btn btn-outline-light btn-sm">Listeye dön</a>
            </div>
        </div>
    </div>
</div>

@if (ViewBag.WaitingManagerApproval is bool waiting && waiting)
{
    <div class="alert alert-warning mt-3 mb-0">
        Bu talep admin/satış yöneticisi onayında. Onay sonrası minimum ve tavsiye fiyatlar netleşecektir.
    </div>
}

<section class="section mt-4">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body pt-4">
                    <div class="row g-3">
                        <div class="col-md-4"><div class="sales-summary-card"><div class="label">Müşteri</div><div class="value">@Model.CustomerName</div></div></div>
                        <div class="col-md-4"><div class="sales-summary-card"><div class="label">Satışçı</div><div class="value">@Model.RequestedByName</div></div></div>
                        <div class="col-md-4"><div class="sales-summary-card"><div class="label">Müşteri durumu</div><div class="value"><span class="badge bg-@StatusClass(Model.CustomerQuoteStatus)">@CustomerStatusText(Model.CustomerQuoteStatus)</span></div></div></div>
                        <div class="col-md-4"><div class="sales-summary-card"><div class="label">Teklif durumu</div><div class="value">@Model.OfferStatus</div></div></div>
                        <div class="col-md-4"><div class="sales-summary-card"><div class="label">Satış fiyatı</div><div class="value">@(Model.FinalSalesPrice.HasValue ? $"{Model.FinalSalesPrice.Value:N2} ₺" : "-")</div></div></div>
                        <div class="col-md-4"><div class="sales-summary-card"><div class="label">Termin</div><div class="value">@(string.IsNullOrWhiteSpace(Model.DeliveryLeadTime) ? "-" : Model.DeliveryLeadTime)</div></div></div>
                        <div class="col-md-4"><div class="sales-summary-card"><div class="label">Revizyon</div><div class="value">@Model.RevisionCode</div></div></div>
                        <div class="col-md-4"><div class="sales-summary-card"><div class="label">Talep kaynağı</div><div class="value">@Model.RequestSource</div></div></div>
                        <div class="col-md-4"><div class="sales-summary-card"><div class="label">Talep oluşturma</div><div class="value">@Model.SalesOpenedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div></div></div>
                        <div class="col-md-4"><div class="sales-summary-card"><div class="label">Talep alma tarihi</div><div class="value">@(Model.RequestReceivedAt.HasValue ? Model.RequestReceivedAt.Value.ToString("dd.MM.yyyy") : "-")</div></div></div>
                        <div class="col-md-4"><div class="sales-summary-card"><div class="label">İhtiyaç tarihi</div><div class="value">@Model.NeededByDate.ToLocalTime().ToString("dd.MM.yyyy")</div></div></div>
                    </div>
                </div>
            </div>

            @foreach (var item in Model.Items)
            {
                RenderItem(item, 0);
            }
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-body pt-4">
                    <h5 class="card-title">Satış Akış Sırası</h5>
                    <ol class="small text-muted ps-3 mb-3">
                        <li>Talep oluşturuldu</li>
                        <li>Teknik/maliyet çalışması tamamlandı</li>
                        <li>Yönetici onayı alındı</li>
                        <li>Teklif müşteriye iletildi</li>
                        <li>Teklif durumu güncellendi</li>
                        <li>Satıldı → Tasarım/Satınalma/Planlama</li>
                    </ol>

                    <h5 class="card-title">Müşteri Bilgilendirme Durumu</h5>
                    <form asp-action="UpdateCustomerQuoteStatus" method="post" class="mb-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="input-group">
                            <select asp-for="CustomerQuoteStatus" name="customerQuoteStatus" class="form-select" asp-items="Html.GetEnumSelectList<SalesCustomerQuoteStatus>()"></select>
                            <button type="submit" class="btn btn-primary">Güncelle</button>
                        </div>
                    </form>

                    <h5 class="card-title">Teklif Durumu (Müşteriye iletim sonrası)</h5>
                    <form asp-action="UpdateOfferStatus" method="post" enctype="multipart/form-data" class="mb-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="input-group mb-2">
                            <select asp-for="OfferStatus"
                                    id="offerStatusSelect"
                                    name="offerStatus"
                                    class="form-select"
                                    asp-items="Html.GetEnumSelectList<SalesOfferStatus>()"
                                    disabled="@(Model.CustomerQuoteStatus != SalesCustomerQuoteStatus.SharedWithCustomer)">
                            </select>

                            <button type="submit"
                                    class="btn btn-outline-primary"
                                    disabled="@(Model.CustomerQuoteStatus != SalesCustomerQuoteStatus.SharedWithCustomer)">
                                Güncelle
                            </button>
                        </div>
                        <div id="soldFields" class="border rounded p-2 mb-2" style="display:none;">
                            <div class="mb-2">
                                <label class="form-label small mb-1">Satış fiyatı (₺)</label>
                                <input type="number" min="0" step="0.01" class="form-control form-control-sm" name="soldSalesPrice" value="@(Model.FinalSalesPrice?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small mb-1">Termin</label>
                                <input type="text" class="form-control form-control-sm" name="deliveryLeadTime" placeholder="Örn: 14-16 hafta" value="@Model.DeliveryLeadTime" />
                            </div>
                            <div>
                                <label class="form-label small mb-1">Teknik şartname (zorunlu)</label>
                                <input type="file" class="form-control form-control-sm" name="technicalSpecificationFile" />
                            </div>
                        </div>
                        @if (Model.CustomerQuoteStatus != SalesCustomerQuoteStatus.SharedWithCustomer)
                        {
                            <small class="text-warning">Önce "Teklif Müşteriye İletildi" adımı seçilmelidir.</small>
                        }
                        else
                        {
                            <small class="text-muted">Teklif durumu "S: Satıldı" seçilirse satış fiyatı, teknik şartname ve termin zorunlu olur.</small>
                        }
                    </form>

                    <h5 class="card-title">Ekler</h5>
                    @if (Model.Attachments.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var file in Model.Attachments)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <a href="@file.RelativePath" target="_blank">@file.OriginalFileName</a>
                                    <small class="text-muted">@(file.FileSize / 1024) KB</small>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Ek dosya yok.</p>
                    }
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-body pt-4">
                    <h5 class="card-title">Talep Yorumları</h5>
                    <form asp-action="AddComment" method="post" class="mb-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="SalesRequestId" value="@Model.NewComment.SalesRequestId" />
                        <textarea name="CommentText" class="form-control" rows="3" placeholder="Müşteri geri bildirimi veya satış notu yazın"></textarea>
                        <span asp-validation-for="NewComment.CommentText" class="text-danger"></span>
                        <button type="submit" class="btn btn-sm btn-primary mt-2">Yorumu Kaydet</button>
                    </form>

                    @if (Model.Comments.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var comment in Model.Comments)
                            {
                                <li class="list-group-item px-0">
                                    <div class="small text-muted">@comment.CommentedBy · @comment.CommentedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                                    <div>@comment.CommentText</div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Henüz yorum yok.</p>
                    }
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-body pt-4">
                    <h5 class="card-title">Revizyon Geçmişi</h5>
                    @if (Model.RevisionHistory.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var revision in Model.RevisionHistory)
                            {
                                <li class="list-group-item px-0">
                                    <div class="fw-semibold">@revision.RevisionCode - @revision.RevisionReason</div>
                                    <small class="text-muted">@revision.RevisedBy · @revision.RevisedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Henüz revizyon yok.</p>
                    }
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-body pt-4">
                    <h5 class="card-title">Dokümanlar (GAD / P&ID / Datasheet)</h5>
                    <div class="alert alert-info py-2 small">
                        Maliyet analizi ile birlikte şartname ve datasheet otomatik oluşturulur. GAD otomatik oluşturma planlandı (henüz geliştirilmedi).
                    </div>

                    @if (Model.CanUploadPidDocument)
                    {
                        <form asp-action="UploadDocument" method="post" enctype="multipart/form-data" class="row g-2 mb-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="SalesRequestId" value="@Model.Id" />
                            <input type="hidden" name="DocumentType" value="@SalesDocumentType.PID" />
                            <div class="col-4">
                                <input class="form-control form-control-sm" value="PID" disabled />
                            </div>
                            <div class="col-4">
                                <input name="RevisionCode" class="form-control form-control-sm" placeholder="Revizyon (P01)" />
                            </div>
                            <div class="col-4">
                                <input type="file" name="File" class="form-control form-control-sm" />
                            </div>
                            <div class="col-8">
                                <input name="LinkedCostAnalysisRevisionCode" class="form-control form-control-sm" placeholder="Bağlı maliyet revizyonu (opsiyonel)" />
                            </div>
                            <div class="col-4">
                                <button type="submit" class="btn btn-sm btn-primary w-100">PID Yükle</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="text-muted small mb-3">PID yükleme sadece satış müdürü tarafından yapılabilir.</div>
                    }

                    @if (Model.Documents.Any())
                    {
                        <ul class="list-group list-group-flush mb-3">
                            @foreach (var document in Model.Documents)
                            {
                                <li class="list-group-item px-0">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <div>
                                            <span class="badge bg-dark">@document.DocumentType</span>
                                            <span class="badge bg-@(document.IsCurrent ? "success" : "secondary")">@document.RevisionCode</span>
                                            @if (document.IsCurrent)
                                            {
                                                <span class="badge bg-warning text-dark">Aktif Revizyon</span>
                                            }
                                            <div class="mt-1">
                                                @if (Model.CanDownloadDocuments)
                                                {
                                                    <a href="@Url.Action("DownloadDocument", "SalesRequest", new { area = "Sales", requestId = Model.Id, documentId = document.Id })">@document.OriginalFileName</a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">@document.OriginalFileName (Onay sonrası indirilebilir)</span>
                                                }
                                            </div>
                                        </div>
                                        <small class="text-muted text-end">
                                            @document.UploadedBy <br />
                                            @document.UploadedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                        </small>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">Henüz doküman yüklenmedi.</p>
                    }

                    @if (Model.CanViewPricing)
                    {
                        <h5 class="card-title">Revizyon / Maliyet Geçmişi</h5>
                        @if (Model.RevisionCosts.Any())
                        {
                            @foreach (var revision in Model.RevisionCosts)
                            {
                                <div class="border rounded-2 p-2 mb-2">
                                    <div class="d-flex justify-content-between flex-wrap">
                                        <div><strong>@revision.RevisionCode</strong> - @revision.RevisionReason</div>
                                        <div><strong>Toplam Maliyet:</strong> @(revision.TotalCost?.ToString("N2") ?? "-") ₺</div>
                                    </div>
                                    <small class="text-muted">@revision.RevisedBy · @revision.RevisedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                                    <div class="table-responsive mt-2">
                                        <table class="table table-sm mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Kalem</th>
                                                    <th>Kapasite</th>
                                                    <th>Maliyet Revizyonu</th>
                                                    <th class="text-end">Maliyet</th>
                                                    <th class="text-end">İletilen Fiyat</th>
                                                    <th class="text-end">Satılan Fiyat</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            @foreach (var item in revision.Items)
                                            {
                                                <tr>
                                                    <td>@item.ItemCode - @item.ItemTitle</td>
                                                    <td>@item.CapacityM3 m³</td>
                                                    <td>@(item.LinkedCostAnalysisRevisionCode ?? "-")</td>
                                                    <td class="text-end">@(item.LinkedCostAnalysisTotal?.ToString("N2") ?? "-") ₺</td>
                                                    <td class="text-end">@(item.SharedSalesPrice?.ToString("N2") ?? "-") ₺</td>
                                                    <td class="text-end">@(item.SoldSalesPrice?.ToString("N2") ?? "-") ₺</td>
                                                </tr>
                                            }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted mb-0">Maliyet revizyon geçmişi bulunmuyor.</p>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    (function () {
        const select = document.getElementById('offerStatusSelect');
        const soldFields = document.getElementById('soldFields');
        if (!select || !soldFields) return;

        const toggleSoldFields = () => {
            const selectedText = (select.options[select.selectedIndex]?.text || '').toUpperCase();
            soldFields.style.display = selectedText.includes('SATILDI') ? 'block' : 'none';
        };

        select.addEventListener('change', toggleSoldFields);
        toggleSoldFields();
    })();
</script>
