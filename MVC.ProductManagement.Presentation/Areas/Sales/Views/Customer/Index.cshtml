@model IEnumerable<MVC.ProductManagement.Presentation.Areas.Admin.Models.SalesRequestVMs.CustomerListVm>
@{
    ViewData["Title"] = "Satış Müşterileri";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-1">Müşteri Listesi</h4>
        <p class="text-muted mb-0">Satış birimi için aktif müşteri kayıtları.</p>
    </div>
    <a asp-action="Create" class="btn btn-danger">+ Yeni Müşteri</a>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Firma</th>
                <th>Yetkili</th>
                <th>İletişim</th>
                <th>Lokasyon</th>
                <th>Durum</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.CompanyName</td>
                    <td>@item.ContactName</td>
                    <td>
                        <div>@item.Email</div>
                        <small class="text-muted">@item.Phone</small>
                    </td>
                    <td>@item.City / @item.Country</td>
                    <td>
                        <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Aktif" : "Pasif")</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
